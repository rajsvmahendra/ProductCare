@model ProductCare.Web.ViewModels.Customer.ServiceRequestListViewModel
@{
    ViewData["Title"] = "My Service Requests";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">My Service Requests</h2>
        <p class="text-muted mb-0">Track ongoing repair, maintenance, and warranty claim tickets in real time.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-wrench me-1"></i> Raise New Request
    </a>
</div>

<!-- Filters Toolbar -->
<div class="card pc-card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search ticket #, subject, product..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select" asp-for="FilterStatus" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.RequestStatus>()">
                    <option value="">-- All Statuses --</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="priority" class="form-select" asp-for="FilterPriority" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.PriorityLevel>()">
                    <option value="">-- All Priorities --</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Tickets Table -->
<div class="card pc-card">
    <div class="pc-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-ticket-detailed me-2 text-primary"></i>Service Ticket History</span>
        <span class="badge bg-light text-dark border">@Model.TotalCount Tickets</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Requests.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ticket #</th>
                            <th>Product</th>
                            <th>Subject</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Last Updated</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Requests)
                        {
                            <tr>
                                <td class="font-monospace fw-bold">
                                    <a asp-action="Details" asp-route-id="@r.Id" class="text-decoration-none">
                                        @r.TicketNumber
                                    </a>
                                </td>
                                <td>@r.ProductName <span class="text-muted small">(@r.ProductBrand)</span></td>
                                <td>@r.Subject</td>
                                <td><span class="badge bg-light text-dark border">@r.CategoryName</span></td>
                                <td><span class="@r.PriorityBadgeCssClass">@r.Priority</span></td>
                                <td><span class="@r.StatusBadgeCssClass">@r.StatusDisplayText</span></td>
                                <td>@r.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                                <td>@(r.UpdatedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">
                                        Track &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-ticket-perforated fs-1 d-block text-secondary mb-2"></i>
                <h5 class="fw-bold">No Service Requests Found</h5>
                <p class="text-muted small mb-3">You do not have any service tickets matching the filter criteria.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-wrench me-1"></i> Submit a Service Request
                </a>
            </div>
        }
    </div>
</div>
