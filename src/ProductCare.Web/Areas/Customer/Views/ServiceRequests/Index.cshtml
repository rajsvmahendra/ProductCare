@model ProductCare.Web.ViewModels.Customer.ServiceRequestListViewModel
@{
    ViewData["Title"] = "Service Requests";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <span class="d-inline-block text-uppercase fw-bold small text-muted mb-1" style="letter-spacing: 0.08em; font-size: 0.72rem;">AFTER-SALES SERVICE</span>
        <h1 class="h3 fw-bold text-dark mb-1 font-serif">Service &amp; Repair Requests</h1>
        <p class="text-muted small mb-0">Follow ongoing repair diagnostics, technician updates, and warranty claims.</p>
    </div>
    <a asp-action="Create" class="btn btn-forest btn-sm">
        <i class="bi bi-wrench me-1"></i>
        <span>Raise New Request</span>
    </a>
</div>

<!-- Filters Toolbar -->
<div class="pc-card mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search ticket #, subject, product..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select" asp-for="FilterStatus" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.RequestStatus>()">
                <option value="">-- All Statuses --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="priority" class="form-select" asp-for="FilterPriority" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.PriorityLevel>()">
                <option value="">-- All Priorities --</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-forest w-100 btn-sm">Filter</button>
            <a asp-action="Index" class="btn btn-stone btn-sm d-flex align-items-center justify-content-center" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Tickets Table Card -->
<div class="pc-card p-0 overflow-hidden">
    <div class="pc-demo-topbar">
        <span class="small fw-semibold text-dark"><i class="bi bi-ticket-detailed me-2 text-forest"></i>Service Request Queue</span>
        <span class="badge bg-light text-muted border small">@Model.TotalCount Ticket(s)</span>
    </div>
    <div>
        @if (Model.Requests.Any())
        {
            <div class="pc-table-wrapper border-0">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Ticket #</th>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Subject</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Requests)
                        {
                            <tr>
                                <td class="font-monospace fw-bold small text-dark">
                                    <a asp-action="Details" asp-route-id="@r.Id" class="text-dark text-decoration-none">
                                        #@r.TicketNumber
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark small">@r.ProductName</div>
                                    <div class="small text-muted" style="font-size: 11px;">@r.ProductBrand</div>
                                </td>
                                <td><span class="badge bg-light text-dark border" style="font-size: 11px;">@r.CategoryName</span></td>
                                <td class="fw-semibold text-dark small">@r.Subject</td>
                                <td><span class="@r.PriorityBadgeCssClass" style="font-size: 11px;">@r.Priority</span></td>
                                <td><span class="@r.StatusBadgeCssClass" style="font-size: 11px;">@r.StatusDisplayText</span></td>
                                <td class="small text-muted tabular-nums">@r.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-stone btn-sm" style="font-size: 11px; padding: 4px 8px;">
                                        View &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold text-dark font-serif">No service requests found</h5>
                <p class="small text-muted mb-3">No service tickets match your active filter criteria.</p>
                <a asp-action="Create" class="btn btn-forest btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Submit a Service Request
                </a>
            </div>
        }
    </div>
</div>
