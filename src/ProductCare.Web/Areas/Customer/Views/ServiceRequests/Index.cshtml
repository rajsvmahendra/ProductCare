@model ProductCare.Web.ViewModels.Customer.ServiceRequestListViewModel
@{
    ViewData["Title"] = "Service Requests";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-ink mb-1 font-heading">My Service Requests</h1>
        <p class="text-muted mb-0">Follow ongoing repair diagnostics, technician updates, and warranty claims.</p>
    </div>
    <a asp-action="Create" class="btn-pc-primary btn-pc-sm">
        <i class="bi bi-wrench me-1"></i>
        <span>Raise New Request</span>
    </a>
</div>

<!-- Filters Toolbar -->
<div class="pc-card mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search ticket #, subject, product..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select" asp-for="FilterStatus" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.RequestStatus>()">
                <option value="">-- All Statuses --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="priority" class="form-select" asp-for="FilterPriority" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.PriorityLevel>()">
                <option value="">-- All Priorities --</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn-pc-secondary w-100 btn-pc-sm">Filter</button>
            <a asp-action="Index" class="btn btn-light border btn-pc-sm d-flex align-items-center justify-content-center" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Tickets Table Card -->
<div class="pc-card overflow-hidden">
    <div class="pc-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-ticket-detailed me-2 text-primary-pc"></i>Service Request Queue</span>
        <span class="badge bg-light text-muted border">@Model.TotalCount Tickets</span>
    </div>
    <div class="p-0">
        @if (Model.Requests.Any())
        {
            <div class="table-responsive">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Ticket #</th>
                            <th>Product</th>
                            <th>Subject</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Requests)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@r.Id" class="fw-bold text-primary-pc text-decoration-none num-tabular">
                                        @r.TicketNumber
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-medium text-ink">@r.ProductName</span>
                                    <span class="text-muted small">&middot; @r.ProductBrand</span>
                                </td>
                                <td class="text-truncate max-w-200" title="@r.Subject">@r.Subject</td>
                                <td><span class="badge bg-light text-dark border">@r.CategoryName</span></td>
                                <td><span class="badge badge-priority-@r.Priority.ToString().ToLower()">@r.Priority</span></td>
                                <td><span class="pc-badge @r.StatusBadgeCssClass">@r.StatusDisplayText</span></td>
                                <td class="num-tabular small text-muted">@r.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@r.Id" class="btn-pc-secondary btn-pc-sm">
                                        <span>Track</span>
                                        <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-ticket-perforated fs-1 text-muted opacity-50 mb-3 d-block"></i>
                <p class="mb-1 fw-medium text-ink">No service requests found.</p>
                <p class="small text-muted mb-3">When a product requires maintenance or repairs, start a service ticket here.</p>
                <a asp-action="Create" class="btn-pc-primary btn-pc-sm">
                    <i class="bi bi-wrench me-1"></i> Start Service Ticket
                </a>
            </div>
        }
    </div>
</div>
