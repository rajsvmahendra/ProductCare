@model ProductCare.Web.ViewModels.Customer.ServiceRequestDetailsViewModel
@{
    ViewData["Title"] = $"Ticket #{Model.TicketNumber}";
}

<!-- Page Header & Action Controls -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="pc-badge @Model.StatusBadgeCssClass">@Model.StatusDisplayText</span>
            <span class="badge badge-priority-@Model.Priority.ToString().ToLower()">@Model.Priority Priority</span>
            <span class="badge bg-light text-muted border">@Model.CategoryName</span>
        </div>
        <h1 class="h3 fw-bold text-ink mb-0 font-heading num-tabular">Ticket #@Model.TicketNumber</h1>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn-pc-secondary btn-pc-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Queue
        </a>
        @if (Model.CanCancel)
        {
            <button type="button" class="btn btn-outline-danger btn-pc-sm" data-bs-toggle="modal" data-bs-target="#cancelTicketModal">
                <i class="bi bi-x-circle me-1"></i> Cancel Request
            </button>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Ticket & Product Details -->
    <div class="col-lg-7">
        <!-- Main Ticket Information Card -->
        <div class="pc-card mb-4">
            <div class="pc-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-file-text me-2 text-primary-pc"></i>Reported Issue</span>
                <span class="small text-muted num-tabular">Submitted: @Model.CreatedAtUtc.ToString("MMM dd, yyyy HH:mm") UTC</span>
            </div>
            <div class="pc-card-body">
                <h2 class="h5 fw-bold text-ink mb-2">@Model.Subject</h2>
                <div class="p-3 bg-light rounded-3 border mb-4 text-secondary small" style="white-space: pre-wrap; line-height: 1.6;">@Model.Description</div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Assigned Technician</div>
                        <div class="fw-bold text-ink">
                            @(string.IsNullOrEmpty(Model.AssignedTechnician) ? "Awaiting Review / Triage" : Model.AssignedTechnician)
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Resolution Status</div>
                        <div class="fw-bold text-ink">
                            @(Model.ResolvedAtUtc?.ToString("MMMM dd, yyyy") ?? "In Progress")
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.AdminRemarks))
                {
                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex align-items-center gap-2 text-primary-pc fw-bold small mb-2">
                            <i class="bi bi-chat-quote-fill"></i>
                            <span>Official Service Team Remark</span>
                        </div>
                        <div class="p-3 rounded-3 border" style="background: #EEF0FF; border-color: #DDE3FC !important; color: var(--pc-ink);">
                            @Model.AdminRemarks
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Associated Product Card -->
        <div class="pc-card">
            <div class="pc-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-laptop me-2 text-primary-pc"></i>Target Product</span>
                <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="small text-primary-pc text-decoration-none fw-semibold">View Device &rarr;</a>
            </div>
            <div class="pc-card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <span class="text-muted small">Device:</span> <strong class="text-ink">@Model.ProductName</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small">Brand & Model:</span> <strong class="text-ink">@Model.ProductBrand &middot; @Model.ProductModelNumber</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small">Serial:</span> <code class="text-ink num-tabular">@Model.ProductSerialNumber</code>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small">Warranty Expiry:</span> <strong class="text-ink num-tabular">@Model.ProductWarrantyExpiryDate.ToString("yyyy-MM-dd")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stepper Timeline: Audit History -->
    <div class="col-lg-5">
        <div class="pc-card">
            <div class="pc-card-header">
                <span><i class="bi bi-clock-history me-2 text-primary-pc"></i>Lifecycle Audit Progression</span>
            </div>
            <div class="pc-card-body">
                <div class="pc-stepper">
                    @foreach (var h in Model.StatusHistory)
                    {
                        var isResolved = h.ToStatus == ProductCare.Web.Models.Enums.RequestStatus.Resolved || h.ToStatus == ProductCare.Web.Models.Enums.RequestStatus.Closed;
                        var isCancelled = h.ToStatus == ProductCare.Web.Models.Enums.RequestStatus.Rejected;
                        var isCurrent = h == Model.StatusHistory.Last();

                        <div class="pc-step-item @(isCurrent ? "is-active" : "") @(isResolved ? "is-resolved" : "") @(isCancelled ? "is-cancelled" : "")">
                            <span class="pc-step-dot"></span>
                            <div class="d-flex justify-content-between align-items-baseline mb-1">
                                <span class="fw-bold text-ink small">@h.ToStatusText</span>
                                <span class="num-tabular text-muted" style="font-size: 11px;">@h.CreatedAtUtc.ToString("MMM dd, HH:mm")</span>
                            </div>
                            <div class="small text-muted" style="font-size: 12px;">By: @h.ChangedByUserName</div>
                            @if (!string.IsNullOrEmpty(h.Remarks))
                            {
                                <div class="mt-1 p-2 rounded-2 bg-light small text-secondary border" style="font-size: 12px;">
                                    @h.Remarks
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Cancel Ticket Confirmation -->
@if (Model.CanCancel)
{
    <div class="modal fade" id="cancelTicketModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header border-bottom">
                        <h5 class="modal-title fw-bold text-danger" id="cancelModalLabel">
                            <i class="bi bi-x-circle-fill me-2"></i>Cancel Service Request
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <p class="text-ink mb-3">
                            Are you sure you want to cancel ticket <strong>#@Model.TicketNumber</strong>? This action will set the request status to Cancelled.
                        </p>
                        <div class="mb-3">
                            <label class="form-label" for="cancelReason">Reason for Cancellation</label>
                            <textarea id="cancelReason" name="reason" class="form-control" rows="3" placeholder="e.g. Issue resolved independently, or submitted by mistake..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Keep Ticket Open</button>
                        <button type="submit" class="btn btn-danger btn-sm">Confirm Cancellation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
