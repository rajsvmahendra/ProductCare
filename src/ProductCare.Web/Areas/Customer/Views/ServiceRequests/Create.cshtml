@model ProductCare.Web.ViewModels.Customer.ServiceRequestCreateViewModel
@{
    ViewData["Title"] = "Raise Service Request";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card pc-card">
            <div class="pc-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-wrench me-2 text-primary"></i>Raise Service / Repair Request</span>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">&larr; Back to Requests</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="ProductId" class="form-label fw-semibold"></label>
                        <select asp-for="ProductId" class="form-select" asp-items="Model.AvailableProducts"></select>
                        <span asp-validation-for="ProductId" class="text-danger small"></span>
                        <div class="form-text small">Select the registered device requiring support or warranty claim.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold"></label>
                            <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.RequestCategory>()"></select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold"></label>
                            <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.PriorityLevel>()"></select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label fw-semibold"></label>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Screen flickering after system update" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Please provide specific details: symptoms observed, error messages, when it occurs, and any troubleshooting attempted..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-send me-1"></i> Submit Ticket
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
