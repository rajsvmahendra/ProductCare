@model ProductCare.Web.ViewModels.Customer.ServiceRequestCreateViewModel
@{
    ViewData["Title"] = "Raise Service Ticket";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <span class="d-inline-block text-uppercase fw-bold small text-muted mb-1" style="letter-spacing: 0.08em; font-size: 0.72rem;">NEW SERVICE TICKET</span>
                <h1 class="h3 fw-bold text-dark mb-1 font-serif">Submit Service / Repair Request</h1>
                <p class="text-muted small mb-0">Describe the issue observed so service technicians can triage and assist you.</p>
            </div>
            <a asp-action="Index" class="btn btn-stone btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Requests
            </a>
        </div>

        <div class="pc-card p-4 p-md-5">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                <!-- Product Selection -->
                <div class="mb-4">
                    <label asp-for="ProductId" class="form-label">Registered Target Device</label>
                    <select asp-for="ProductId" class="form-select" asp-items="Model.AvailableProducts" required autofocus></select>
                    <span asp-validation-for="ProductId" class="text-danger small"></span>
                    <div class="form-text small text-muted">Select the registered device requiring diagnosis, repair, or warranty claim.</div>
                </div>

                <!-- Category & Priority -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label">Issue Category</label>
                        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.RequestCategory>()"></select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Priority" class="form-label">Urgency / Priority Level</label>
                        <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.PriorityLevel>()"></select>
                        <span asp-validation-for="Priority" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Issue Subject -->
                <div class="mb-4">
                    <label asp-for="Subject" class="form-label">Problem Summary</label>
                    <input asp-for="Subject" class="form-control" placeholder="e.g. Screen flickering when waking from sleep" required />
                    <span asp-validation-for="Subject" class="text-danger small"></span>
                </div>

                <!-- Symptoms / Description -->
                <div class="mb-4">
                    <label asp-for="Description" class="form-label">Detailed Symptoms &amp; Observations</label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Please describe what happens: error codes, strange noises, when the issue began, and whether any troubleshooting was attempted..." required></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- Action Controls -->
                <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top" style="border-color: var(--pc-stone) !important;">
                    <a asp-action="Index" class="btn btn-stone">Cancel</a>
                    <button type="submit" class="btn btn-forest px-4">
                        <i class="bi bi-send me-1"></i> Submit Service Ticket
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
