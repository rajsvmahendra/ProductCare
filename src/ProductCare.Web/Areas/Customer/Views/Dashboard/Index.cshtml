@model ProductCare.Web.ViewModels.Customer.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard";
}

<!-- Page Header & Quick Actions -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-ink mb-1 font-heading">Welcome back, @Model.CustomerName</h1>
        <p class="text-muted mb-0">Overview of your registered devices, warranty coverage, and active repair tickets.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" asp-controller="Products" class="btn-pc-primary btn-pc-sm">
            <i class="bi bi-plus-lg"></i>
            <span>Add Product</span>
        </a>
        <a asp-action="Create" asp-controller="ServiceRequests" class="btn-pc-teal btn-pc-sm">
            <i class="bi bi-wrench"></i>
            <span>Raise Service Ticket</span>
        </a>
    </div>
</div>

<!-- 4 Concise Metric Cards -->
<div class="row g-3 mb-4">
    <!-- Total Products -->
    <div class="col-sm-6 col-xl-3">
        <div class="pc-stat-card">
            <div class="pc-stat-top">
                <span class="pc-stat-label">Registered Products</span>
                <div class="pc-stat-icon-wrap bg-primary-soft">
                    <i class="bi bi-laptop"></i>
                </div>
            </div>
            <div class="pc-stat-value">@Model.TotalProducts</div>
            <div class="small text-muted mt-2 d-flex align-items-center gap-1">
                <i class="bi bi-boxes"></i> In digital product vault
            </div>
        </div>
    </div>

    <!-- Active Warranties -->
    <div class="col-sm-6 col-xl-3">
        <div class="pc-stat-card">
            <div class="pc-stat-top">
                <span class="pc-stat-label">Active Coverage</span>
                <div class="pc-stat-icon-wrap bg-teal-soft">
                    <i class="bi bi-shield-check"></i>
                </div>
            </div>
            <div class="pc-stat-value text-teal-pc">@Model.ActiveWarranties</div>
            <div class="small text-muted mt-2 d-flex align-items-center gap-1">
                <i class="bi bi-check-circle text-teal-pc"></i> Protected under warranty
            </div>
        </div>
    </div>

    <!-- Expiring Soon -->
    <div class="col-sm-6 col-xl-3">
        <div class="pc-stat-card">
            <div class="pc-stat-top">
                <span class="pc-stat-label">Expiring Soon (&le;30d)</span>
                <div class="pc-stat-icon-wrap bg-warning-soft">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
            <div class="pc-stat-value text-warning">@Model.ExpiringSoonWarranties</div>
            <div class="small text-muted mt-2 d-flex align-items-center gap-1">
                <i class="bi bi-exclamation-circle text-warning"></i> Action recommended
            </div>
        </div>
    </div>

    <!-- Open Tickets -->
    <div class="col-sm-6 col-xl-3">
        <div class="pc-stat-card">
            <div class="pc-stat-top">
                <span class="pc-stat-label">Active Service Tickets</span>
                <div class="pc-stat-icon-wrap bg-info-soft">
                    <i class="bi bi-ticket-detailed"></i>
                </div>
            </div>
            <div class="pc-stat-value text-info">@Model.OpenServiceRequests</div>
            <div class="small text-muted mt-2 d-flex align-items-center gap-1">
                <i class="bi bi-arrow-repeat text-info"></i> Triage & repairs ongoing
            </div>
        </div>
    </div>
</div>

<!-- Coverage Health Overview Segment -->
@if (Model.TotalProducts > 0)
{
    var activePct = (int)Math.Round((double)Model.ActiveWarranties / Model.TotalProducts * 100);
    var expiringPct = (int)Math.Round((double)Model.ExpiringSoonWarranties / Model.TotalProducts * 100);
    var expiredPct = (int)Math.Round((double)Model.ExpiredWarranties / Model.TotalProducts * 100);

    <div class="pc-card mb-4 p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
            <div>
                <h2 class="h5 fw-bold text-ink mb-1 font-heading">Coverage Health Breakdown</h2>
                <div class="text-muted small">Real-time status analysis across your product inventory.</div>
            </div>
            <div class="d-flex align-items-center gap-3 small">
                <span class="d-flex align-items-center gap-1"><span class="badge rounded-circle p-1 bg-teal-pc"></span> Active (@Model.ActiveWarranties)</span>
                <span class="d-flex align-items-center gap-1"><span class="badge rounded-circle p-1 bg-warning"></span> Expiring Soon (@Model.ExpiringSoonWarranties)</span>
                <span class="d-flex align-items-center gap-1"><span class="badge rounded-circle p-1 bg-danger"></span> Expired (@Model.ExpiredWarranties)</span>
            </div>
        </div>

        <!-- Segmented Progress Bar -->
        <div class="progress" style="height: 10px; border-radius: 6px; background-color: #EAEFF8;">
            <div class="progress-bar" style="width: @activePct%; background-color: var(--pc-teal);" title="Active (@activePct%)"></div>
            <div class="progress-bar" style="width: @expiringPct%; background-color: var(--pc-warning);" title="Expiring Soon (@expiringPct%)"></div>
            <div class="progress-bar" style="width: @expiredPct%; background-color: var(--pc-danger);" title="Expired (@expiredPct%)"></div>
        </div>
    </div>
}

<!-- Warranties Expiring Soon Banner / Alert List -->
@if (Model.ExpiringSoonProducts.Any())
{
    <div class="pc-card border-warning mb-4 overflow-hidden">
        <div class="p-3 bg-warning-soft border-bottom border-warning d-flex justify-content-between align-items-center">
            <div class="fw-bold text-ink d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                <span>Warranties Expiring Soon (&le; 30 Days)</span>
            </div>
            <span class="badge bg-warning text-dark px-2 py-1">@Model.ExpiringSoonProducts.Count Attention Needed</span>
        </div>
        <div class="table-responsive">
            <table class="pc-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Brand & Model</th>
                        <th>Expiry Date</th>
                        <th>Days Remaining</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.ExpiringSoonProducts)
                    {
                        <tr>
                            <td class="fw-bold text-ink">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="text-ink text-decoration-none">
                                    @p.Name
                                </a>
                            </td>
                            <td class="text-muted">@p.Brand &middot; @p.ModelNumber</td>
                            <td class="num-tabular">@p.ExpiryDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="pc-badge pc-badge-warning">@p.RemainingDays days left</span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="ServiceRequests" asp-action="Create" asp-route-productId="@p.Id" class="btn-pc-secondary btn-pc-sm">
                                    <i class="bi bi-wrench me-1"></i> Claim Warranty
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Recent Service Activity & Quick Shelf Preview -->
<div class="row g-4">
    <!-- Recent Service Activity Table -->
    <div class="col-lg-8">
        <div class="pc-card h-100">
            <div class="pc-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock-history me-2 text-primary-pc"></i>Recent Service Tickets</span>
                <a asp-controller="ServiceRequests" asp-action="Index" class="small text-primary-pc fw-semibold">View All &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentServiceRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="pc-table">
                            <thead>
                                <tr>
                                    <th>Ticket #</th>
                                    <th>Product</th>
                                    <th>Subject</th>
                                    <th>Status</th>
                                    <th>Updated</th>
                                    <th class="text-end">Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.RecentServiceRequests)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@r.Id" class="fw-bold text-primary-pc text-decoration-none num-tabular">
                                                @r.TicketNumber
                                            </a>
                                        </td>
                                        <td class="text-ink fw-medium">@r.ProductName</td>
                                        <td class="text-truncate max-w-200" title="@r.Subject">@r.Subject</td>
                                        <td>
                                            <span class="pc-badge @r.StatusBadgeCssClass">@r.StatusText</span>
                                        </td>
                                        <td class="small text-muted num-tabular">@((r.UpdatedAtUtc ?? r.CreatedAtUtc).ToString("MMM dd, yyyy"))</td>
                                        <td class="text-end">
                                            <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-light" title="View Ticket Details">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-tools fs-1 text-muted opacity-50 mb-3 d-block"></i>
                        <p class="mb-2 fw-medium text-ink">No service requests yet.</p>
                        <p class="small text-muted mb-3">When a product develops an issue, submit a repair ticket to track diagnostic progress.</p>
                        <a asp-controller="ServiceRequests" asp-action="Create" class="btn-pc-primary btn-pc-sm">
                            <i class="bi bi-wrench me-1"></i> Start a Service Ticket
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Quick Help & Product Shortcuts -->
    <div class="col-lg-4">
        <div class="pc-card p-4 mb-4">
            <h3 class="h6 fw-bold text-ink mb-3 font-heading text-uppercase letter-spacing-1">Quick Shortcuts</h3>
            <div class="d-flex flex-column gap-2">
                <a asp-controller="Products" asp-action="Create" class="p-3 rounded-3 bg-light text-decoration-none d-flex align-items-center justify-content-between hover-lift">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-plus-circle text-primary-pc fs-5"></i>
                        <span class="fw-semibold text-ink small">Register New Product</span>
                    </div>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>
                <a asp-controller="Warranty" asp-action="Index" class="p-3 rounded-3 bg-light text-decoration-none d-flex align-items-center justify-content-between hover-lift">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-calendar3-range text-teal-pc fs-5"></i>
                        <span class="fw-semibold text-ink small">Warranty Expiry Timeline</span>
                    </div>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>
                <a asp-controller="ServiceRequests" asp-action="Create" class="p-3 rounded-3 bg-light text-decoration-none d-flex align-items-center justify-content-between hover-lift">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-wrench text-warning fs-5"></i>
                        <span class="fw-semibold text-ink small">Raise Maintenance Ticket</span>
                    </div>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>
            </div>
        </div>

        <div class="pc-card p-4" style="background: linear-gradient(135deg, #EEF0FF 0%, #E5F7F4 100%); border-color: #DDE3FC;">
            <div class="d-flex align-items-center gap-2 text-primary-pc fw-bold small mb-2">
                <i class="bi bi-info-circle-fill"></i>
                <span>Ownership Tip</span>
            </div>
            <p class="small text-muted mb-0">
                Always upload proof of purchase when registering high-value items. Service technicians prioritize claims with verified invoices.
            </p>
        </div>
    </div>
</div>
