@model ProductCare.Web.ViewModels.Customer.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Ownership Vault";
}

<!-- Page Header & Quick Actions -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <span class="d-inline-block text-uppercase fw-bold small text-muted mb-1" style="letter-spacing: 0.08em; font-size: 0.72rem;">CUSTOMER WORKSPACE</span>
        <h1 class="h3 fw-bold text-dark mb-1 font-serif">Welcome back, @Model.CustomerName</h1>
        <p class="text-muted small mb-0">Overview of your registered devices, warranty coverage commitments, and active service requests.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" asp-controller="Products" class="btn btn-forest btn-sm">
            <i class="bi bi-plus-lg"></i>
            <span>Register Product</span>
        </a>
        <a asp-action="Create" asp-controller="ServiceRequests" class="btn btn-stone btn-sm">
            <i class="bi bi-wrench"></i>
            <span>Raise Service Ticket</span>
        </a>
    </div>
</div>

<!-- 4 Concise Metric Cards -->
<div class="row g-3 mb-4">
    <!-- Total Products -->
    <div class="col-sm-6 col-xl-3">
        <div class="pc-kpi-card">
            <div class="pc-kpi-label">Registered Devices</div>
            <div class="pc-kpi-val">@Model.TotalProducts</div>
            <div class="small text-muted mt-2 d-flex align-items-center gap-1">
                <i class="bi bi-boxes"></i> In personal ownership vault
            </div>
        </div>
    </div>

    <!-- Active Warranties -->
    <div class="col-sm-6 col-xl-3">
        <div class="pc-kpi-card">
            <div class="pc-kpi-label">Active Warranties</div>
            <div class="pc-kpi-val" style="color: var(--pc-status-active);">@Model.ActiveWarranties</div>
            <div class="small text-muted mt-2 d-flex align-items-center gap-1">
                <i class="bi bi-shield-check" style="color: var(--pc-status-active);"></i> Protected under coverage
            </div>
        </div>
    </div>

    <!-- Expiring Soon -->
    <div class="col-sm-6 col-xl-3">
        <div class="pc-kpi-card">
            <div class="pc-kpi-label">Expiring Soon (&le;30d)</div>
            <div class="pc-kpi-val" style="color: var(--pc-amber);">@Model.ExpiringSoonWarranties</div>
            <div class="small text-muted mt-2 d-flex align-items-center gap-1">
                <i class="bi bi-clock-history" style="color: var(--pc-amber);"></i> Action recommended
            </div>
        </div>
    </div>

    <!-- Open Service Requests -->
    <div class="col-sm-6 col-xl-3">
        <div class="pc-kpi-card">
            <div class="pc-kpi-label">Open Service Tickets</div>
            <div class="pc-kpi-val" style="color: var(--pc-status-progress);">@Model.OpenServiceRequests</div>
            <div class="small text-muted mt-2 d-flex align-items-center gap-1">
                <i class="bi bi-arrow-repeat" style="color: var(--pc-status-progress);"></i> Under review or in repair
            </div>
        </div>
    </div>
</div>

<!-- Expiring Soon Attention Alert -->
@if (Model.ExpiringSoonProducts.Any())
{
    <div class="p-3 rounded-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background-color: var(--pc-amber-soft); border: 1px solid rgba(214, 154, 81, 0.4);">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5" style="color: var(--pc-amber);"></i>
            <div>
                <span class="fw-bold text-dark small">Attention Required:</span>
                <span class="small text-dark">You have @Model.ExpiringSoonProducts.Count product(s) with warranties expiring in the next 30 days.</span>
            </div>
        </div>
        <a asp-action="Index" asp-controller="Warranty" asp-route-status="ExpiringSoon" class="btn btn-stone btn-sm">
            Review Expiring Coverage &rarr;
        </a>
    </div>
}

<div class="row g-4">
    <!-- Attention Needed / Expiring Soon Table -->
    <div class="col-lg-7">
        <div class="pc-card">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom" style="border-color: var(--pc-stone) !important;">
                <h5 class="fw-bold text-dark mb-0 font-serif">Coverage Radar</h5>
                <a asp-action="Index" asp-controller="Warranty" class="small fw-semibold text-forest">View All Coverage &rarr;</a>
            </div>

            @if (Model.ExpiringSoonProducts.Any())
            {
                <div class="pc-table-wrapper">
                    <table class="pc-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Model</th>
                                <th>Expires</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.ExpiringSoonProducts)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark small">@p.Name</div>
                                        <div class="text-muted small" style="font-size: 11px;">@p.Brand</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace" style="font-size: 11px;">@p.ModelNumber</span>
                                    </td>
                                    <td class="small tabular-nums">
                                        <div>@p.ExpiryDate.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted" style="font-size: 11px;">@p.RemainingDays days left</div>
                                    </td>
                                    <td>
                                        <span class="pc-badge pc-badge-expiring">@p.StatusText</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="ServiceRequests" asp-action="Create" asp-route-productId="@p.Id" class="btn btn-stone btn-sm" title="Raise Service Ticket" style="font-size: 11px; padding: 4px 8px;">
                                            <i class="bi bi-wrench"></i> Claim
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-shield-check fs-2 text-forest mb-2 d-block"></i>
                    <div class="fw-semibold text-dark small">All warranties are healthy.</div>
                    <div class="small">No products approaching expiration in the immediate 30-day window.</div>
                </div>
            }
        </div>
    </div>

    <!-- Recent Service Activity -->
    <div class="col-lg-5">
        <div class="pc-card">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom" style="border-color: var(--pc-stone) !important;">
                <h5 class="fw-bold text-dark mb-0 font-serif">Recent Service Activity</h5>
                <a asp-action="Index" asp-controller="ServiceRequests" class="small fw-semibold text-forest">All Tickets &rarr;</a>
            </div>

            @if (Model.RecentServiceRequests.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var sr in Model.RecentServiceRequests)
                    {
                        <div class="p-3 rounded-3" style="background-color: var(--pc-surface-inset); border: 1px solid var(--pc-stone);">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-bold text-dark font-monospace small">#@sr.TicketNumber</span>
                                <span class="pc-badge @sr.StatusBadgeCssClass" style="font-size: 10px;">
                                    @sr.StatusText
                                </span>
                            </div>
                            <div class="fw-semibold text-dark small text-truncate">@sr.Subject</div>
                            <div class="small text-muted mb-2" style="font-size: 11px;">@sr.ProductName</div>
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top small" style="border-color: var(--pc-stone) !important; font-size: 11px;">
                                <span class="text-muted tabular-nums">@((sr.UpdatedAtUtc ?? sr.CreatedAtUtc).ToString("dd MMM yyyy HH:mm")) UTC</span>
                                <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@sr.Id" class="text-forest fw-semibold">
                                    Details &rarr;
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-inbox fs-2 mb-2 d-block text-muted"></i>
                    <div class="fw-semibold text-dark small">No service requests on file.</div>
                    <div class="small">When you need repairs or maintenance, submit a ticket directly from your registered products.</div>
                </div>
            }
        </div>
    </div>
</div>
