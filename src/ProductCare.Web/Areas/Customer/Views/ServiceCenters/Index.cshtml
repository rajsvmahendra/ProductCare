@model ProductCare.Web.ViewModels.Customer.ServiceCenterListViewModel
@{
    ViewData["Title"] = "Find a Service Centre";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="d-inline-block fw-bold small text-muted font-display" style="font-size: 0.8rem;">Diagnostics &amp; repair network</span>
            <span class="text-muted">&bull;</span>
            <span class="badge bg-light text-dark border small" style="font-size: 11px;">Campus &amp; regional hubs</span>
        </div>
        <h1 class="h2 fw-bold text-dark mb-1 font-display">Authorized Service Centres</h1>
        <p class="text-muted small mb-0">Locate certified warranty repair providers, on-campus intake kiosks, and authorized hardware facilities.</p>
    </div>
    <div>
        <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-forest btn-sm pc-btn-tactile px-3">
            <i class="bi bi-wrench me-1"></i>
            <span>Raise Service Ticket</span>
        </a>
    </div>
</div>

<!-- Search & Filtering Toolbar (Bento Style) -->
<div class="pc-bento-card pc-bento-white mb-4 p-4 shadow-sm">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-lg-3 col-md-3">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted" style="min-height: 42px; height: 42px;"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search center, brand, address..." style="min-height: 42px; height: 42px;" />
            </div>
        </div>
        <div class="col-lg-3 col-md-3">
            <select name="locality" class="form-select" style="min-height: 42px; height: 42px;">
                <option value="">-- All Localities / Hubs --</option>
                @foreach (var loc in Model.AvailableLocalities)
                {
                    <option value="@loc" selected="@(Model.FilterLocality == loc)">@loc</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-2">
            <select name="city" class="form-select" style="min-height: 42px; height: 42px;">
                <option value="">-- All Cities --</option>
                @foreach (var city in Model.AvailableCities)
                {
                    <option value="@city" selected="@(Model.FilterCity == city)">@city</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-2">
            <input type="text" name="brand" value="@Model.FilterBrand" class="form-control" placeholder="Brand (Apple, Dell)..." style="min-height: 42px; height: 42px;" />
        </div>
        <div class="col-lg-2 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-forest w-100 pc-btn-tactile d-inline-flex align-items-center justify-content-center" style="min-height: 42px; height: 42px;">Search</button>
            <a asp-action="Index" class="btn btn-stone pc-btn-tactile d-flex align-items-center justify-content-center" style="min-height: 42px; height: 42px; width: 42px;" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Service Centers Grid (Bento Style) -->
@if (Model.Centers.Any())
{
    <div class="row g-4">
        @foreach (var c in Model.Centers)
        {
            <div class="col-lg-6">
                <div class="pc-bento-card pc-bento-white h-100 p-4 d-flex flex-column justify-content-between shadow-sm">
                    <div>
                        <!-- Header with Verified / Sample Badge -->
                        <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; background: rgba(40, 91, 80, 0.08); border: 1px solid rgba(40, 91, 80, 0.15); color: var(--pc-forest);">
                                    <i class="bi bi-building fs-4"></i>
                                </div>
                                <div>
                                    <h2 class="h5 fw-bold text-dark mb-0 font-display">@c.Name</h2>
                                    <div class="small text-muted d-flex align-items-center gap-1">
                                        <i class="bi bi-geo-alt text-forest"></i> @c.Address@(string.IsNullOrEmpty(c.Locality) ? "" : $", {c.Locality}"), <strong>@c.City@(string.IsNullOrEmpty(c.State) ? "" : $", {c.State}")</strong>
                                    </div>
                                </div>
                            </div>

                            <div>
                                @if (c.IsVerified)
                                {
                                    <span class="badge bg-success text-white d-inline-flex align-items-center gap-1 px-2 py-1" style="font-size: 11px; border-radius: 999px;" title="Official Verified Service Partner">
                                        <i class="bi bi-patch-check-fill"></i> Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border small d-inline-flex align-items-center gap-1" title="Demonstration Listing for Testing & Evaluation">
                                        <i class="bi bi-info-circle"></i> Sample
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Supported Brands -->
                        <div class="mb-3">
                            <span class="small text-muted d-block mb-1" style="font-size: 11px;">Supported Brands:</span>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var b in c.SupportedBrands.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-white text-dark border small" style="font-size: 11px;">@b</span>
                                }
                            </div>
                        </div>

                        <!-- Supported Categories -->
                        <div class="mb-3">
                            <span class="small text-muted d-block mb-1" style="font-size: 11px;">Supported Categories:</span>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var cat in c.SupportedCategories.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-light text-forest border small" style="font-size: 11px; background-color: rgba(40, 91, 80, 0.05) !important;">@cat</span>
                                }
                            </div>
                        </div>

                        <!-- Operating Hours & Contact Info Inset -->
                        <div class="p-3 rounded-3 mb-3 bg-white" style="border: 1px solid rgba(15, 23, 42, 0.08);">
                            <div class="row g-2 small">
                                <div class="col-sm-6">
                                    <div class="text-muted" style="font-size: 11px;">Operating Hours</div>
                                    <div class="fw-semibold text-dark"><i class="bi bi-clock me-1 text-muted"></i>@c.OpeningHours</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted" style="font-size: 11px;">Contact Phone</div>
                                    <div><a href="tel:@c.Phone" class="fw-semibold text-forest text-decoration-none"><i class="bi bi-telephone me-1"></i>@c.Phone</a></div>
                                </div>
                                <div class="col-sm-6 mt-2">
                                    <div class="text-muted" style="font-size: 11px;">Email Inquiries</div>
                                    <div><a href="mailto:@c.Email" class="fw-semibold text-forest text-decoration-none text-truncate d-block"><i class="bi bi-envelope me-1"></i>@c.Email</a></div>
                                </div>
                                <div class="col-sm-6 mt-2">
                                    <div class="text-muted" style="font-size: 11px;">Workload Status</div>
                                    <div class="fw-semibold text-dark"><i class="bi bi-speedometer me-1 text-muted"></i>@(c.OpenTicketCount) active work order(s)</div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(c.Notes))
                        {
                            <p class="small text-muted mb-3 fst-italic">
                                <i class="bi bi-chat-left-quote me-1 text-forest"></i>@c.Notes
                            </p>
                        }
                    </div>

                    <!-- Action Buttons (Standard 36px) -->
                    <div class="d-flex align-items-center gap-2 pt-3 border-top mt-auto" style="border-color: rgba(15, 23, 42, 0.08) !important;">
                        @if (!string.IsNullOrEmpty(c.MapUrl))
                        {
                            <a href="@c.MapUrl" target="_blank" rel="noopener noreferrer" class="btn btn-stone btn-sm pc-btn-tactile" style="min-height: 36px; height: 36px;" title="Open Map Directions">
                                <i class="bi bi-map me-1"></i> Directions
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(c.Website))
                        {
                            <a href="@c.Website" target="_blank" rel="noopener noreferrer" class="btn btn-stone btn-sm pc-btn-tactile" style="min-height: 36px; height: 36px;" title="Visit Center Website">
                                <i class="bi bi-globe me-1"></i> Website
                            </a>
                        }
                        <a asp-controller="ServiceRequests" asp-action="Create" asp-route-centerId="@c.Id" class="btn btn-forest btn-sm ms-auto pc-btn-tactile px-3" style="min-height: 36px; height: 36px;" title="Route a service request directly to this facility">
                            <i class="bi bi-wrench me-1"></i> Request Service
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="pc-bento-card pc-bento-white p-5 text-center text-muted shadow-sm">
        <i class="bi bi-geo-alt fs-1 text-muted mb-3 d-block"></i>
        <h5 class="fw-bold text-dark font-display">No service centres match your query</h5>
        <p class="small text-muted mb-3">Try widening your search terms or clearing the city and brand filters.</p>
        <a asp-action="Index" class="btn btn-stone btn-sm pc-btn-tactile">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Directory Filters
        </a>
    </div>
}
