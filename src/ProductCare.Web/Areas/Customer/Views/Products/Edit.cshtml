@model ProductCare.Web.ViewModels.Customer.ProductCreateEditViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <span class="d-inline-block text-uppercase fw-bold small text-muted mb-1" style="letter-spacing: 0.08em; font-size: 0.72rem;">UPDATE RECORD</span>
                <h1 class="h3 fw-bold text-dark mb-1 font-serif">Edit Product Record</h1>
                <p class="text-muted small mb-0">Update device specifications, warranty commitment, or upload a replacement proof of purchase.</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-stone btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Details
            </a>
        </div>

        <div class="pc-card p-4 p-md-5">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ExistingInvoiceOriginalFileName" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                <!-- Section 1: Device Info -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom" style="border-color: var(--pc-stone) !important;">
                        <span class="pc-badge pc-badge-stone" style="font-size: 10px;">SECTION 1</span>
                        <h6 class="fw-bold text-dark mb-0 font-serif">Device Specifications</h6>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Product Name</label>
                            <input asp-for="Name" class="form-control" required autofocus />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Brand" class="form-label">Brand / Manufacturer</label>
                            <input asp-for="Brand" class="form-control" required />
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ModelNumber" class="form-label">Model Number</label>
                            <input asp-for="ModelNumber" class="form-control" required />
                            <span asp-validation-for="ModelNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SerialNumber" class="form-label">Unique Serial Number</label>
                            <input asp-for="SerialNumber" class="form-control" required />
                            <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Category" class="form-label">Product Category</label>
                        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.ProductCategory>()"></select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Section 2: Purchase & Warranty Details -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom" style="border-color: var(--pc-stone) !important;">
                        <span class="pc-badge pc-badge-stone" style="font-size: 10px;">SECTION 2</span>
                        <h6 class="fw-bold text-dark mb-0 font-serif">Purchase &amp; Warranty Commitment</h6>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PurchaseDate" class="form-label">Purchase Date</label>
                            <input asp-for="PurchaseDate" type="date" class="form-control" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WarrantyDurationMonths" class="form-label">Warranty Duration (Months)</label>
                            <input asp-for="WarrantyDurationMonths" type="number" min="1" max="120" class="form-control" required />
                            <span asp-validation-for="WarrantyDurationMonths" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PurchaseStore" class="form-label">Retailer / Store (Optional)</label>
                            <input asp-for="PurchaseStore" class="form-control" />
                            <span asp-validation-for="PurchaseStore" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PurchasePrice" class="form-label">Purchase Price (Optional)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PurchasePrice" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                            <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Personal Notes (Optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Section 3: Physical Invoice -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom" style="border-color: var(--pc-stone) !important;">
                        <span class="pc-badge pc-badge-stone" style="font-size: 10px;">SECTION 3</span>
                        <h6 class="fw-bold text-dark mb-0 font-serif">Invoice Proof</h6>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ExistingInvoiceOriginalFileName))
                    {
                        <div class="p-3 rounded-3 mb-3 d-flex align-items-center justify-content-between" style="background-color: var(--pc-surface-inset); border: 1px solid var(--pc-stone);">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-check fs-4 text-forest"></i>
                                <div>
                                    <div class="fw-semibold text-dark small">Current Attachment: @Model.ExistingInvoiceOriginalFileName</div>
                                    <div class="small text-muted" style="font-size: 11px;">Upload a new file below if you wish to replace this document.</div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="p-3 rounded-3" style="background-color: var(--pc-surface-inset); border: 1px dashed var(--pc-stone);">
                        <label asp-for="InvoiceFile" class="form-label">Upload Replacement File</label>
                        <input asp-for="InvoiceFile" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                        <span asp-validation-for="InvoiceFile" class="text-danger small"></span>
                        <div class="form-text small mt-2">
                            <i class="bi bi-shield-check text-forest"></i> Accepted formats: PDF, JPG, PNG &middot; Max size: 5 MB &middot; Stored securely outside web root.
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top" style="border-color: var(--pc-stone) !important;">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-stone">Cancel</a>
                    <button type="submit" class="btn btn-forest px-4">
                        <i class="bi bi-check2 me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
