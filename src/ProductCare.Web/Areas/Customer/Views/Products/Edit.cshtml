@model ProductCare.Web.ViewModels.Customer.ProductCreateEditViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h3 fw-bold text-ink mb-1 font-heading">Edit Product Details</h1>
                <p class="text-muted mb-0">Update device metadata, warranty coverage, or upload a replacement receipt.</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-pc-secondary btn-pc-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Details
            </a>
        </div>

        <div class="pc-card p-4 p-md-5">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ExistingInvoiceOriginalFileName" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                <!-- Section 1: Device Info -->
                <div class="mb-4">
                    <h2 class="h6 fw-bold text-ink mb-3 font-heading text-uppercase letter-spacing-1">Device Specifications</h2>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Product Name</label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Brand" class="form-label">Brand / Manufacturer</label>
                            <input asp-for="Brand" class="form-control" required />
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ModelNumber" class="form-label">Model Number</label>
                            <input asp-for="ModelNumber" class="form-control" required />
                            <span asp-validation-for="ModelNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SerialNumber" class="form-label">Unique Serial Number</label>
                            <input asp-for="SerialNumber" class="form-control" required />
                            <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Category" class="form-label">Product Category</label>
                        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.ProductCategory>()"></select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Section 2: Purchase & Coverage -->
                <div class="mb-4">
                    <h2 class="h6 fw-bold text-ink mb-3 font-heading text-uppercase letter-spacing-1">Purchase Details & Warranty Terms</h2>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PurchaseDate" class="form-label">Purchase Date</label>
                            <input asp-for="PurchaseDate" class="form-control" type="date" required />
                            <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WarrantyDurationMonths" class="form-label">Warranty Duration</label>
                            <div class="input-group">
                                <input asp-for="WarrantyDurationMonths" class="form-control" type="number" min="1" max="120" required />
                                <span class="input-group-text">Months</span>
                            </div>
                            <span asp-validation-for="WarrantyDurationMonths" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PurchaseStore" class="form-label">Store / Retailer</label>
                            <input asp-for="PurchaseStore" class="form-control" />
                            <span asp-validation-for="PurchaseStore" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PurchasePrice" class="form-label">Purchase Price</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PurchasePrice" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Section 3: Invoice File & Notes -->
                <div class="mb-4">
                    <h2 class="h6 fw-bold text-ink mb-3 font-heading text-uppercase letter-spacing-1">Receipt Attachment & Notes</h2>

                    @if (!string.IsNullOrEmpty(Model.ExistingInvoiceOriginalFileName))
                    {
                        <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-check-fill text-success fs-4"></i>
                                <div>
                                    <div class="fw-bold small text-ink">Active Receipt Stored</div>
                                    <div class="text-muted" style="font-size: 11px;">Verified in private vault</div>
                                </div>
                            </div>
                            <a asp-action="DownloadInvoice" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-success">
                                <i class="bi bi-download me-1"></i> Download Existing
                            </a>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="InvoiceFile" class="form-label">Replace / Upload New Receipt</label>
                        <input asp-for="InvoiceFile" class="form-control" type="file" accept=".pdf,.jpg,.jpeg,.png" />
                        <div class="form-text small text-muted">
                            <i class="bi bi-info-circle me-1"></i> PDF, JPG, PNG &middot; Max 5 MB. Leave blank to keep existing stored invoice.
                        </div>
                        <span asp-validation-for="InvoiceFile" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Additional Product Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Form Controls -->
                <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn-pc-secondary">Cancel</a>
                    <button type="submit" class="btn-pc-primary">
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>Update Product</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
