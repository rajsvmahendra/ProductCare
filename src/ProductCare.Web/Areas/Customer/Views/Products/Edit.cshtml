@model ProductCare.Web.ViewModels.Customer.ProductCreateEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card pc-card">
            <div class="pc-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-pencil me-2 text-primary"></i>Edit Product: @Model.Name</span>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">&larr; Back to Details</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <h6 class="text-uppercase text-muted fw-bold small border-bottom pb-2 mb-3">Product Specifications</h6>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Brand" class="form-label fw-semibold"></label>
                            <input asp-for="Brand" class="form-control" />
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ModelNumber" class="form-label fw-semibold"></label>
                            <input asp-for="ModelNumber" class="form-control" />
                            <span asp-validation-for="ModelNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SerialNumber" class="form-label fw-semibold"></label>
                            <input asp-for="SerialNumber" class="form-control" />
                            <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Category" class="form-label fw-semibold"></label>
                        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.ProductCategory>()"></select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <h6 class="text-uppercase text-muted fw-bold small border-bottom pb-2 mb-3">Purchase & Warranty Coverage</h6>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PurchaseDate" class="form-label fw-semibold"></label>
                            <input asp-for="PurchaseDate" class="form-control" type="date" />
                            <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WarrantyDurationMonths" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="WarrantyDurationMonths" class="form-control" type="number" min="1" max="120" />
                                <span class="input-group-text">Months</span>
                            </div>
                            <span asp-validation-for="WarrantyDurationMonths" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PurchaseStore" class="form-label fw-semibold"></label>
                            <input asp-for="PurchaseStore" class="form-control" />
                            <span asp-validation-for="PurchaseStore" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PurchasePrice" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PurchasePrice" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="text-uppercase text-muted fw-bold small border-bottom pb-2 mb-3">Invoice Proof</h6>

                    @if (!string.IsNullOrEmpty(Model.ExistingInvoiceOriginalFileName))
                    {
                        <div class="alert alert-light border d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <i class="bi bi-file-earmark-check text-success me-2 fs-5"></i>
                                <strong>Existing invoice:</strong> @Model.ExistingInvoiceOriginalFileName
                            </div>
                            <a asp-action="DownloadInvoice" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-success">
                                <i class="bi bi-download me-1"></i> View/Download
                            </a>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="InvoiceFile" class="form-label fw-semibold">Replace Invoice File</label>
                        <input asp-for="InvoiceFile" class="form-control" type="file" accept=".pdf,.jpg,.jpeg,.png" />
                        <div class="form-text small">Upload a new file to replace the existing invoice. PDF, JPG, PNG (Max 5 MB).</div>
                        <span asp-validation-for="InvoiceFile" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Update Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
