@model ProductCare.Web.ViewModels.Customer.ProductListViewModel
@{
    ViewData["Title"] = "My Products";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-ink mb-1 font-heading">My Registered Products</h1>
        <p class="text-muted mb-0">Manage your product records, warranty statuses, and purchase invoices in one place.</p>
    </div>
    <a asp-action="Create" class="btn-pc-primary btn-pc-sm">
        <i class="bi bi-plus-lg"></i>
        <span>Add Product</span>
    </a>
</div>

<!-- Filters & Search Toolbar -->
<div class="pc-card mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, brand, model, S/N..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="category" class="form-select" asp-for="FilterCategory" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.ProductCategory>()">
                <option value="">-- All Categories --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select" asp-for="FilterStatus" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.WarrantyStatus>()">
                <option value="">-- All Statuses --</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn-pc-secondary w-100 btn-pc-sm">Filter</button>
            <a asp-action="Index" class="btn btn-light border btn-pc-sm d-flex align-items-center justify-content-center" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Products Table Card -->
<div class="pc-card overflow-hidden">
    <div class="pc-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-laptop me-2 text-primary-pc"></i>Registered Device Inventory</span>
        <span class="badge bg-light text-muted border">Showing @Model.TotalCount items</span>
    </div>
    <div class="p-0">
        @if (Model.Products.Any())
        {
            <div class="table-responsive">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Brand & Model</th>
                            <th>Serial Number</th>
                            <th>Category</th>
                            <th>Purchase Date</th>
                            <th>Warranty Expiry</th>
                            <th>Status</th>
                            <th>Invoice</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Products)
                        {
                            <tr>
                                <td class="fw-bold text-ink">
                                    <a asp-action="Details" asp-route-id="@p.Id" class="text-ink text-decoration-none">
                                        @p.Name
                                    </a>
                                </td>
                                <td class="text-muted">@p.Brand &middot; @p.ModelNumber</td>
                                <td><code class="text-ink num-tabular">@p.SerialNumber</code></td>
                                <td><span class="badge bg-light text-dark border">@p.CategoryName</span></td>
                                <td class="num-tabular">@p.PurchaseDate.ToString("yyyy-MM-dd")</td>
                                <td class="num-tabular">@p.WarrantyExpiryDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="pc-badge @p.StatusBadgeCssClass">@p.StatusDisplayText</span>
                                </td>
                                <td>
                                    @if (p.HasInvoice)
                                    {
                                        <a asp-action="DownloadInvoice" asp-route-id="@p.Id" class="text-success" title="Download Verified Invoice">
                                            <i class="bi bi-file-earmark-check-fill fs-5"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">&mdash;</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-light border" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-light border" title="Edit Product">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-boxes fs-1 text-muted opacity-50 mb-3 d-block"></i>
                <p class="mb-2 fw-medium text-ink">Your product shelf is ready.</p>
                <p class="small text-muted mb-3">Add your first purchase to keep its details, receipts, and warranty in one place.</p>
                <a asp-action="Create" class="btn-pc-primary btn-pc-sm">
                    <i class="bi bi-plus-lg me-1"></i> Add First Product
                </a>
            </div>
        }
    </div>
</div>
