@model ProductCare.Web.ViewModels.Customer.ProductListViewModel
@{
    ViewData["Title"] = "My Registered Products";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">My Registered Products</h2>
        <p class="text-muted mb-0">Manage your purchased appliances, electronics, warranty records, and invoices.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Add Product
    </a>
</div>

<!-- Filters & Search Toolbar -->
<div class="card pc-card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, brand, model, S/N..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="category" class="form-select" asp-for="FilterCategory" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.ProductCategory>()">
                    <option value="">-- All Categories --</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select" asp-for="FilterStatus" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.WarrantyStatus>()">
                    <option value="">-- All Warranty Statuses --</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Product Table -->
<div class="card pc-card">
    <div class="pc-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-laptop me-2 text-primary"></i>Products Inventory</span>
        <span class="badge bg-light text-dark border">Showing @Model.TotalCount items</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Products.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product Name</th>
                            <th>Brand & Model</th>
                            <th>Serial Number</th>
                            <th>Category</th>
                            <th>Purchase Date</th>
                            <th>Warranty Expiry</th>
                            <th>Status</th>
                            <th>Invoice</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Products)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none">
                                        @p.Name
                                    </a>
                                </td>
                                <td>@p.Brand &middot; @p.ModelNumber</td>
                                <td><code class="text-dark">@p.SerialNumber</code></td>
                                <td><span class="badge bg-light text-dark border">@p.CategoryName</span></td>
                                <td>@p.PurchaseDate.ToString("yyyy-MM-dd")</td>
                                <td>@p.WarrantyExpiryDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="@p.StatusBadgeCssClass">@p.StatusDisplayText</span>
                                </td>
                                <td>
                                    @if (p.HasInvoice)
                                    {
                                        <a asp-action="DownloadInvoice" asp-route-id="@p.Id" class="text-success" title="Download Stored Invoice">
                                            <i class="bi bi-file-earmark-check-fill fs-5"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">&mdash;</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-primary" title="Edit Product">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-controller="ServiceRequests" asp-action="Create" asp-route-productId="@p.Id" class="btn btn-outline-info" title="Raise Service Request">
                                            <i class="bi bi-wrench"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox fs-1 d-block text-secondary mb-2"></i>
                <h5 class="fw-bold">No Products Found</h5>
                <p class="text-muted small mb-3">You haven't registered any products matching this criteria yet.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Register Your First Product
                </a>
            </div>
        }
    </div>
</div>
