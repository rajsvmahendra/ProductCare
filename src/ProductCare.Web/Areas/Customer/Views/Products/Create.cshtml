@model ProductCare.Web.ViewModels.Customer.ProductCreateEditViewModel
@{
    ViewData["Title"] = "Register Product";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h3 fw-bold text-ink mb-1 font-heading">Register Purchased Product</h1>
                <p class="text-muted mb-0">Record your device specifications, purchase dates, and receipt for safe keeping.</p>
            </div>
            <a asp-action="Index" class="btn-pc-secondary btn-pc-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Shelf
            </a>
        </div>

        <div class="pc-card p-4 p-md-5">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                <!-- Section 1: Device Info -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="pc-badge pc-badge-primary">STEP 1</span>
                        <h2 class="h6 fw-bold text-ink mb-0 font-heading text-uppercase letter-spacing-1">Device Specifications</h2>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Product Name</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. MacBook Pro 16-inch" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Brand" class="form-label">Brand / Manufacturer</label>
                            <input asp-for="Brand" class="form-control" placeholder="e.g. Apple, Samsung, Sony" required />
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ModelNumber" class="form-label">Model Number</label>
                            <input asp-for="ModelNumber" class="form-control" placeholder="e.g. A2485" required />
                            <span asp-validation-for="ModelNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SerialNumber" class="form-label">Unique Serial Number</label>
                            <input asp-for="SerialNumber" class="form-control" placeholder="e.g. C02G1234MD6R" required />
                            <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Category" class="form-label">Product Category</label>
                        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.ProductCategory>()"></select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Section 2: Purchase & Coverage -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="pc-badge pc-badge-primary">STEP 2</span>
                        <h2 class="h6 fw-bold text-ink mb-0 font-heading text-uppercase letter-spacing-1">Purchase Details & Warranty Terms</h2>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PurchaseDate" class="form-label">Purchase Date</label>
                            <input asp-for="PurchaseDate" class="form-control" type="date" required />
                            <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WarrantyDurationMonths" class="form-label">Warranty Duration</label>
                            <div class="input-group">
                                <input asp-for="WarrantyDurationMonths" class="form-control" type="number" min="1" max="120" required />
                                <span class="input-group-text">Months</span>
                            </div>
                            <span asp-validation-for="WarrantyDurationMonths" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PurchaseStore" class="form-label">Store / Retailer <span class="text-muted fw-normal">(Optional)</span></label>
                            <input asp-for="PurchaseStore" class="form-control" placeholder="e.g. Best Buy, Amazon, Official Store" />
                            <span asp-validation-for="PurchaseStore" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PurchasePrice" class="form-label">Purchase Price <span class="text-muted fw-normal">(Optional)</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PurchasePrice" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Section 3: Invoice File & Notes -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="pc-badge pc-badge-primary">STEP 3</span>
                        <h2 class="h6 fw-bold text-ink mb-0 font-heading text-uppercase letter-spacing-1">Receipt Attachment & Notes (Optional)</h2>
                    </div>

                    <div class="mb-3">
                        <label asp-for="InvoiceFile" class="form-label">Attach Proof of Purchase / Receipt</label>
                        <input asp-for="InvoiceFile" class="form-control" type="file" accept=".pdf,.jpg,.jpeg,.png" />
                        <div class="form-text small text-muted">
                            <i class="bi bi-info-circle me-1"></i> PDF, JPG, PNG &middot; Max 5 MB. Verified by magic-byte signature and stored outside public web access.
                        </div>
                        <span asp-validation-for="InvoiceFile" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Additional Product Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Condition at purchase, included accessories, or store order number..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Form Controls -->
                <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn-pc-secondary">Cancel</a>
                    <button type="submit" class="btn-pc-primary">
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>Save to Digital Shelf</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
