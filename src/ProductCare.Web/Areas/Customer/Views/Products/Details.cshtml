@model ProductCare.Web.ViewModels.Customer.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<!-- Page Header & Action Controls -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="pc-badge @Model.Warranty.StatusBadgeCssClass">@Model.Warranty.StatusDisplayText</span>
            <span class="badge bg-light text-muted border">@Model.CategoryName</span>
        </div>
        <h1 class="h3 fw-bold text-ink mb-0 font-heading">@Model.Name</h1>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a asp-controller="ServiceRequests" asp-action="Create" asp-route-productId="@Model.Id" class="btn-pc-teal btn-pc-sm">
            <i class="bi bi-wrench"></i>
            <span>Request Service</span>
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-pc-secondary btn-pc-sm">
            <i class="bi bi-pencil"></i>
            <span>Edit</span>
        </a>
        <button type="button" class="btn btn-outline-danger btn-pc-sm" data-bs-toggle="modal" data-bs-target="#deleteProductModal">
            <i class="bi bi-trash"></i>
            <span>Delete</span>
        </button>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Main Specification Card -->
    <div class="col-lg-8">
        <div class="pc-card h-100">
            <div class="pc-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-info-circle me-2 text-primary-pc"></i>Product Specifications</span>
                <span class="small text-muted">Registered: @Model.CreatedAtUtc.ToString("MMM dd, yyyy")</span>
            </div>
            <div class="pc-card-body">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Brand / Manufacturer</div>
                        <div class="fs-5 fw-bold text-ink">@Model.Brand</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Model Number</div>
                        <div class="fs-5 fw-bold text-ink num-tabular">@Model.ModelNumber</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Unique Serial Identifier</div>
                        <div class="fs-5 font-monospace text-primary-pc fw-bold num-tabular">@Model.SerialNumber</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Retailer / Store</div>
                        <div class="fs-5 text-ink">@(string.IsNullOrEmpty(Model.PurchaseStore) ? "Not Specified" : Model.PurchaseStore)</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Purchase Date</div>
                        <div class="fs-5 text-ink num-tabular">@Model.PurchaseDate.ToString("MMMM dd, yyyy")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Purchase Price</div>
                        <div class="fs-5 text-ink num-tabular">@(Model.PurchasePrice.HasValue ? Model.PurchasePrice.Value.ToString("C") : "N/A")</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mt-4 pt-4 border-top">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1 mb-2">Customer Notes</div>
                        <p class="mb-0 text-secondary bg-light p-3 rounded-3 border small">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Warranty & Invoice Side Cards -->
    <div class="col-lg-4">
        <div class="d-flex flex-column gap-3">
            <!-- Dynamic Warranty Card -->
            <div class="pc-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted small text-uppercase fw-bold letter-spacing-1">Warranty Term</span>
                    <span class="pc-badge @Model.Warranty.StatusBadgeCssClass">@Model.Warranty.StatusDisplayText</span>
                </div>

                <div class="display-6 fw-bold text-ink mb-1 num-tabular">
                    @if (Model.Warranty.Status == ProductCare.Web.Models.Enums.WarrantyStatus.Expired)
                    {
                        <span class="text-danger">Expired</span>
                    }
                    else
                    {
                        <span>@Model.Warranty.RemainingDays <span class="fs-6 text-muted fw-normal">days remaining</span></span>
                    }
                </div>

                <div class="small text-muted mb-3">
                    Valid until: <strong class="text-ink">@Model.WarrantyExpiryDate.ToString("MMMM dd, yyyy")</strong>
                </div>

                <!-- Warranty Progress Bar -->
                <div class="progress mb-2" style="height: 8px; border-radius: 4px; background: #EEF0FF;">
                    <div class="progress-bar @(Model.Warranty.Status == ProductCare.Web.Models.Enums.WarrantyStatus.Active ? "bg-teal-pc" : Model.Warranty.Status == ProductCare.Web.Models.Enums.WarrantyStatus.ExpiringSoon ? "bg-warning" : "bg-danger")"
                         style="width: @(Model.Warranty.Status == ProductCare.Web.Models.Enums.WarrantyStatus.Expired ? 100 : Math.Max(5, Math.Min(100, 100 - (Model.Warranty.RemainingDays * 100 / Math.Max(1, Model.WarrantyDurationMonths * 30)))))%;"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted">
                    <span>Bought: @Model.PurchaseDate.ToString("MMM yyyy")</span>
                    <span>@Model.WarrantyDurationMonths mo. coverage</span>
                </div>
            </div>

            <!-- Stored Invoice Proof Card -->
            <div class="pc-card p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted small text-uppercase fw-bold letter-spacing-1">Proof of Purchase</span>
                    <i class="bi bi-file-earmark-check text-success fs-5"></i>
                </div>

                @if (Model.HasInvoice)
                {
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="fw-bold small text-ink mb-1">Receipt Stored in Vault</div>
                        <div class="text-muted" style="font-size: 12px;">Protected file stream &middot; Verified</div>
                    </div>
                    <a asp-action="DownloadInvoice" asp-route-id="@Model.Id" class="btn-pc-secondary w-100 btn-pc-sm">
                        <i class="bi bi-download me-1"></i> Download Invoice
                    </a>
                }
                else
                {
                    <div class="p-3 bg-light rounded-3 border text-center text-muted small mb-3">
                        No invoice uploaded for this item.
                    </div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary w-100 btn-pc-sm">
                        <i class="bi bi-upload me-1"></i> Attach Receipt
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Associated Service Tickets History -->
<div class="pc-card overflow-hidden">
    <div class="pc-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-tools me-2 text-primary-pc"></i>Service Request History</span>
        <a asp-controller="ServiceRequests" asp-action="Create" asp-route-productId="@Model.Id" class="btn-pc-primary btn-pc-sm">
            <i class="bi bi-plus-lg me-1"></i> Raise Ticket
        </a>
    </div>
    <div class="p-0">
        @if (Model.ServiceRequests.Any())
        {
            <div class="table-responsive">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Ticket #</th>
                            <th>Subject</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th class="text-end">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.ServiceRequests)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@r.Id" class="fw-bold text-primary-pc text-decoration-none num-tabular">
                                        @r.TicketNumber
                                    </a>
                                </td>
                                <td class="text-truncate max-w-200" title="@r.Subject">@r.Subject</td>
                                <td><span class="badge bg-light text-dark border">@r.Category</span></td>
                                <td><span class="badge badge-priority-@r.Priority.ToString().ToLower()">@r.Priority</span></td>
                                <td><span class="pc-badge @r.StatusBadgeCssClass">@r.Status</span></td>
                                <td class="num-tabular small text-muted">@r.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-light border">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-check2-circle fs-1 text-teal-pc opacity-50 mb-3 d-block"></i>
                <p class="mb-1 fw-medium text-ink">No repair or maintenance tickets filed for this device.</p>
                <p class="small text-muted mb-0">If this product develops an issue, submit a service ticket to track repairs.</p>
            </div>
        }
    </div>
</div>

<!-- Modal: Delete Product Confirmation -->
<div class="modal fade" id="deleteProductModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-danger" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Product Record
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-ink mb-2">Are you sure you want to permanently delete <strong>@Model.Name</strong> (S/N: <code>@Model.SerialNumber</code>)?</p>
                <div class="alert alert-warning small mb-0">
                    <i class="bi bi-info-circle me-1"></i> Products with active or historical service requests cannot be deleted to preserve the maintenance audit log.
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash me-1"></i> Confirm Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
