@model ProductCare.Web.ViewModels.Customer.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    var totalMonths = Math.Max(1, Model.WarrantyDurationMonths);
    var remainingPct = Math.Clamp((int)Math.Round((double)Model.Warranty.RemainingDays / (totalMonths * 30.41) * 100), 0, 100);

    var warrantyBentoClass = Model.Warranty.Status == ProductCare.Web.Models.Enums.WarrantyStatus.Active
        ? "pc-bento-lime"
        : Model.Warranty.Status == ProductCare.Web.Models.Enums.WarrantyStatus.ExpiringSoon
            ? "pc-bento-peach"
            : "pc-bento-coral";
}

<!-- Page Header & Action Controls -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            @if (Model.Warranty.Status == ProductCare.Web.Models.Enums.WarrantyStatus.Active)
            {
                <span class="pc-badge pc-badge-active">Active Coverage</span>
            }
            else if (Model.Warranty.Status == ProductCare.Web.Models.Enums.WarrantyStatus.ExpiringSoon)
            {
                <span class="pc-badge pc-badge-expiring">Expiring Soon</span>
            }
            else
            {
                <span class="pc-badge pc-badge-expired">Expired</span>
            }
            <span class="badge bg-white text-dark border small">@Model.CategoryName</span>
            @if (!string.IsNullOrEmpty(Model.SubCategory))
            {
                <span class="badge bg-light text-forest border small" style="background-color: rgba(40, 91, 80, 0.08) !important;">@Model.SubCategory</span>
            }
        </div>
        <h1 class="h2 fw-bold text-dark mb-0 font-display">@Model.Name</h1>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a asp-controller="ServiceRequests" asp-action="Create" asp-route-productId="@Model.Id" class="btn btn-forest btn-sm pc-btn-tactile px-3" style="min-height: 36px; height: 36px;">
            <i class="bi bi-wrench me-1"></i>
            <span>Report an Issue</span>
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-stone btn-sm pc-btn-tactile px-3" style="min-height: 36px; height: 36px;">
            <i class="bi bi-pencil me-1"></i>
            <span>Edit</span>
        </a>
        <button type="button" class="btn btn-stone text-danger btn-sm pc-btn-tactile" style="min-height: 36px; height: 36px;" data-bs-toggle="modal" data-bs-target="#deleteProductModal">
            <i class="bi bi-trash me-1"></i>
            <span>Delete</span>
        </button>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Main Specification Card (Bento Style) -->
    <div class="col-lg-8">
        <div class="pc-bento-card pc-bento-white h-100 shadow-sm p-4">
            <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                <h5 class="fw-bold text-dark mb-0 font-display">Device Specifications</h5>
                <span class="small text-muted">Registered: @Model.CreatedAtUtc.ToString("dd MMM yyyy")</span>
            </div>
            <div class="row g-4">
                <div class="col-sm-6">
                    <div class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Brand / Manufacturer</div>
                    <div class="fs-5 fw-bold text-dark font-display">@Model.Brand</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Model Number</div>
                    <div class="fs-5 fw-bold text-dark font-display">@Model.ModelNumber</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Hardware Serial Number</div>
                    <div class="fs-5 font-monospace text-forest fw-bold">@Model.SerialNumber</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Store / Retailer</div>
                    <div class="fs-5 text-dark font-display">@(string.IsNullOrEmpty(Model.PurchaseStore) ? "Not Specified" : Model.PurchaseStore)</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Purchase Date</div>
                    <div class="fs-5 text-dark font-display">@Model.PurchaseDate.ToString("dd MMMM yyyy")</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Purchase Price</div>
                    <div class="fs-5 text-dark font-display">@(Model.PurchasePrice.HasValue ? Model.PurchasePrice.Value.ToString("C") : "—")</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="mt-4 pt-3 border-top">
                    <div class="text-muted small fw-bold text-uppercase mb-2" style="letter-spacing: 0.05em; font-size: 0.72rem;">Owner Notes</div>
                    <p class="text-dark small mb-0">@Model.Notes</p>
                </div>
            }
        </div>
    </div>

    <!-- Right Column: Warranty Bento & Invoice Proof -->
    <div class="col-lg-4">
        <!-- Dynamic Warranty Bento Card -->
        <div class="pc-bento-card @warrantyBentoClass mb-4 p-4 shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom" style="border-color: rgba(0, 0, 0, 0.1) !important;">
                <span class="pc-bento-kicker mb-0">Warranty Coverage</span>
                <span class="badge bg-white text-dark border small">@Model.WarrantyDurationMonths Months</span>
            </div>
            
            <div class="mb-3">
                <div class="d-flex align-items-baseline justify-content-between mb-1">
                    <span class="pc-bento-stat" style="font-size: 2.5rem;">@Math.Max(0, Model.Warranty.RemainingDays)</span>
                    <span class="small fw-semibold">days remaining</span>
                </div>
                <div class="progress" style="height: 8px; border-radius: 999px; background-color: rgba(0, 0, 0, 0.1);">
                    <div class="progress-bar @(Model.Warranty.Status == ProductCare.Web.Models.Enums.WarrantyStatus.Active ? "bg-dark" : (Model.Warranty.Status == ProductCare.Web.Models.Enums.WarrantyStatus.ExpiringSoon ? "bg-warning" : "bg-danger"))" 
                         role="progressbar" 
                         style="width: @(Model.Warranty.RemainingDays > 0 ? remainingPct : 0)%;" 
                         aria-valuenow="@Model.Warranty.RemainingDays" 
                         aria-valuemin="0" 
                         aria-valuemax="1000"></div>
                </div>
            </div>

            <div class="small pt-2 border-top" style="border-color: rgba(0, 0, 0, 0.1) !important;">
                <div class="d-flex justify-content-between mb-1">
                    <span>Warranty Expires:</span>
                    <span class="fw-bold">@Model.WarrantyExpiryDate.ToString("dd MMM yyyy")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Status:</span>
                    <span class="fw-bold">@Model.Warranty.StatusDisplayText</span>
                </div>
            </div>
        </div>

        <!-- Verified Purchase Proof Bento Card -->
        <div class="pc-bento-card pc-bento-white shadow-sm p-4">
            <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom font-display">Purchase Proof</h6>
            @if (Model.HasInvoice)
            {
                <div class="p-3 rounded-3 mb-3 bg-white border d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-pdf fs-4 text-danger"></i>
                    <div class="overflow-hidden">
                        <div class="fw-semibold text-dark small text-truncate">@Model.InvoiceOriginalFileName</div>
                        <div class="small text-muted" style="font-size: 11px;">@((Model.InvoiceFileSize ?? 0) / 1024) KB &middot; Verified</div>
                    </div>
                </div>
                <a asp-action="DownloadInvoice" asp-route-id="@Model.Id" class="btn btn-forest btn-sm w-100 pc-btn-tactile">
                    <i class="bi bi-download me-1"></i> Download Invoice
                </a>
            }
            else
            {
                <div class="p-3 rounded-3 text-center text-muted mb-3 border" style="background-color: var(--pc-surface-secondary); border-style: dashed !important;">
                    <i class="bi bi-file-earmark-x fs-3 d-block text-muted mb-1"></i>
                    <div class="small">No physical invoice proof attached to this record.</div>
                </div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-stone btn-sm w-100 pc-btn-tactile">
                    <i class="bi bi-upload me-1"></i> Attach Invoice Proof
                </a>
            }
        </div>
    </div>
</div>

<!-- Connected Service Requests Bento Card -->
<div class="pc-bento-card pc-bento-white shadow-sm p-0 overflow-hidden mb-4">
    <div class="d-flex align-items-center justify-content-between p-3 px-4 border-bottom" style="background-color: var(--pc-surface-secondary);">
        <h5 class="fw-bold text-dark mb-0 font-display fs-6">Service &amp; Repair History</h5>
        <a asp-controller="ServiceRequests" asp-action="Create" asp-route-productId="@Model.Id" class="btn btn-forest btn-sm pc-btn-tactile px-3">
            <i class="bi bi-plus-lg me-1"></i> Report an Issue
        </a>
    </div>

    @if (Model.ServiceRequests.Any())
    {
        <div class="pc-table-wrapper border-0">
            <table class="pc-table mb-0">
                <thead>
                    <tr>
                        <th>Ticket</th>
                        <th>Category</th>
                        <th>Subject</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sr in Model.ServiceRequests)
                    {
                        <tr>
                            <td class="font-monospace fw-bold small text-dark">#@sr.TicketNumber</td>
                            <td><span class="badge bg-light text-dark border small">@sr.Category</span></td>
                            <td class="fw-semibold text-dark small">@sr.Subject</td>
                            <td><span class="@sr.PriorityBadgeCssClass" style="font-size: 11px;">@sr.Priority</span></td>
                            <td><span class="@sr.StatusBadgeCssClass" style="font-size: 11px;">@sr.Status</span></td>
                            <td class="small text-muted">@sr.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@sr.Id" class="btn btn-stone btn-sm pc-btn-tactile" style="font-size: 11px; padding: 4px 10px; height: 32px;">
                                    View &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-4 text-center text-muted">
            <i class="bi bi-check-circle fs-3 text-forest mb-2 d-block"></i>
            <div class="fw-semibold text-dark small">No repair or maintenance history.</div>
            <div class="small">This product currently has zero reported service incidents.</div>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteProductModal" tabindex="-1" aria-labelledby="deleteProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content pc-bento-card pc-bento-white shadow-lg border p-0">
            <div class="modal-header border-bottom p-3 px-4">
                <h5 class="modal-title font-display text-dark h6 mb-0" id="deleteProductModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Delete Product Record
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-dark">Are you certain you wish to delete <strong class="text-dark">@Model.Name</strong> from your inventory?</p>
                <div class="p-3 rounded-2 small alert alert-danger mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> This action permanently deletes the product record, invoice file, and all associated service history logs.
                </div>
            </div>
            <div class="modal-footer border-top p-3 px-4">
                <button type="button" class="btn btn-stone btn-sm" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm pc-btn-tactile">Permanently Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
