@model ProductCare.Web.ViewModels.Admin.AdminCustomerDetailsViewModel
@{
    ViewData["Title"] = $"Customer: {Model.FullName}";
}

<!-- Page Header & Action Controls -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="pc-badge @(Model.IsActive ? "pc-badge-active" : "pc-badge-expired")">@(Model.IsActive ? "Active Customer" : "Deactivated")</span>
        </div>
        <h1 class="h3 fw-bold text-dark mb-0 font-serif">@Model.FullName</h1>
    </div>
    <a asp-action="Index" class="btn btn-stone btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Directory
    </a>
</div>

<div class="row g-4 mb-4">
    <!-- Profile Card -->
    <div class="col-lg-4">
        <div class="pc-card h-100 p-4">
            <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom font-serif" style="border-color: var(--pc-stone) !important;">Customer Profile</h5>

            <div class="mb-3">
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Email Address</div>
                <div class="fw-bold text-dark">@Model.Email</div>
            </div>
            <div class="mb-3">
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Phone Number</div>
                <div class="text-dark">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not Provided" : Model.PhoneNumber)</div>
            </div>
            <div class="mb-3">
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Location</div>
                <div class="text-dark small">@(string.IsNullOrEmpty(Model.Address) ? "" : Model.Address + ", ")@(string.IsNullOrEmpty(Model.City) ? "N/A" : Model.City) @Model.PostalCode</div>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Member Since</div>
                <div class="text-muted small tabular-nums">@Model.CreatedAtUtc.ToString("dd MMMM yyyy")</div>
            </div>
        </div>
    </div>

    <!-- Registered Products & Service Tickets -->
    <div class="col-lg-8">
        <!-- Products Table Card -->
        <div class="pc-card p-0 overflow-hidden mb-4">
            <div class="pc-demo-topbar">
                <span class="small fw-semibold text-dark"><i class="bi bi-laptop me-2 text-forest"></i>Registered Products (@Model.Products.Count)</span>
            </div>
            <div>
                @if (Model.Products.Any())
                {
                    <div class="pc-table-wrapper border-0">
                        <table class="pc-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Model &amp; S/N</th>
                                    <th>Category</th>
                                    <th>Expiry</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Products)
                                {
                                    <tr>
                                        <td class="fw-semibold text-dark small">@p.Name</td>
                                        <td class="small text-muted font-monospace" style="font-size: 11px;">@p.ModelNumber / @p.SerialNumber</td>
                                        <td><span class="badge bg-light text-dark border small">@p.CategoryName</span></td>
                                        <td class="small tabular-nums">@p.WarrantyExpiryDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <span class="pc-badge @p.StatusBadgeCssClass">@p.StatusDisplayText</span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-area="Admin" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="btn btn-stone btn-sm" style="font-size: 11px; padding: 2px 6px;">
                                                View &rarr;
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No products registered by this customer.</div>
                }
            </div>
        </div>

        <!-- Service Tickets Table Card -->
        <div class="pc-card p-0 overflow-hidden">
            <div class="pc-demo-topbar">
                <span class="small fw-semibold text-dark"><i class="bi bi-inbox me-2 text-forest"></i>Service History (@Model.ServiceRequests.Count)</span>
            </div>
            <div>
                @if (Model.ServiceRequests.Any())
                {
                    <div class="pc-table-wrapper border-0">
                        <table class="pc-table">
                            <thead>
                                <tr>
                                    <th>Ticket #</th>
                                    <th>Subject</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.ServiceRequests)
                                {
                                    <tr>
                                        <td class="font-monospace fw-bold small text-dark">#@r.TicketNumber</td>
                                        <td class="fw-semibold text-dark small text-truncate" style="max-width: 200px;">@r.Subject</td>
                                        <td><span class="@r.PriorityBadgeCssClass" style="font-size: 11px;">@r.Priority</span></td>
                                        <td><span class="@r.StatusBadgeCssClass" style="font-size: 11px;">@r.StatusDisplayText</span></td>
                                        <td class="text-end">
                                            <a asp-area="Admin" asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@r.Id" class="btn btn-stone btn-sm" style="font-size: 11px; padding: 2px 6px;">
                                                Manage &rarr;
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No service tickets raised by this customer.</div>
                }
            </div>
        </div>
    </div>
</div>
