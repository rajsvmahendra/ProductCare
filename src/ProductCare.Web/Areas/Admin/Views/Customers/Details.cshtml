@model ProductCare.Web.ViewModels.Admin.AdminCustomerDetailsViewModel
@{
    ViewData["Title"] = $"Customer: {Model.FullName}";
}

<!-- Page Header & Action Controls -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="pc-badge @(Model.IsActive ? "pc-badge-success" : "pc-badge-danger")">@(Model.IsActive ? "Active Customer" : "Deactivated")</span>
        </div>
        <h1 class="h3 fw-bold text-ink mb-0 font-heading">@Model.FullName</h1>
    </div>
    <a asp-action="Index" class="btn-pc-secondary btn-pc-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Directory
    </a>
</div>

<div class="row g-4 mb-4">
    <!-- Profile Card -->
    <div class="col-lg-4">
        <div class="pc-card h-100 p-4">
            <h2 class="h6 fw-bold text-ink mb-3 font-heading text-uppercase letter-spacing-1">Customer Profile</h2>

            <div class="mb-3">
                <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Email Address</div>
                <div class="fw-bold text-ink">@Model.Email</div>
            </div>
            <div class="mb-3">
                <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Phone Number</div>
                <div class="text-ink">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not Provided" : Model.PhoneNumber)</div>
            </div>
            <div class="mb-3">
                <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Location</div>
                <div class="text-ink">@(string.IsNullOrEmpty(Model.Address) ? "" : Model.Address + ", ")@(string.IsNullOrEmpty(Model.City) ? "N/A" : Model.City) @Model.PostalCode</div>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Member Since</div>
                <div class="text-muted small num-tabular">@Model.CreatedAtUtc.ToString("MMMM dd, yyyy")</div>
            </div>
        </div>
    </div>

    <!-- Registered Products & Service Tickets -->
    <div class="col-lg-8">
        <!-- Products Table Card -->
        <div class="pc-card overflow-hidden mb-4">
            <div class="pc-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-laptop me-2 text-primary-pc"></i>Registered Products (@Model.Products.Count)</span>
            </div>
            <div class="p-0">
                @if (Model.Products.Any())
                {
                    <div class="table-responsive">
                        <table class="pc-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Model & S/N</th>
                                    <th>Category</th>
                                    <th>Expiry Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Products)
                                {
                                    <tr>
                                        <td class="fw-bold text-ink">@p.Name <span class="text-muted small">(&middot; @p.Brand)</span></td>
                                        <td>@p.ModelNumber &middot; <code class="text-ink num-tabular">@p.SerialNumber</code></td>
                                        <td><span class="badge bg-light text-dark border">@p.CategoryName</span></td>
                                        <td class="num-tabular">@p.WarrantyExpiryDate.ToString("yyyy-MM-dd")</td>
                                        <td><span class="pc-badge @p.StatusBadgeCssClass">@p.StatusDisplayText</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">
                        No registered products recorded for this customer.
                    </div>
                }
            </div>
        </div>

        <!-- Service Tickets Table Card -->
        <div class="pc-card overflow-hidden">
            <div class="pc-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-tools me-2 text-primary-pc"></i>Service Request History (@Model.ServiceRequests.Count)</span>
            </div>
            <div class="p-0">
                @if (Model.ServiceRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="pc-table">
                            <thead>
                                <tr>
                                    <th>Ticket #</th>
                                    <th>Product</th>
                                    <th>Subject</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th>Submitted</th>
                                    <th class="text-end">Manage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.ServiceRequests)
                                {
                                    <tr>
                                        <td class="fw-bold num-tabular">
                                            <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@r.Id" class="text-primary-pc text-decoration-none">
                                                @r.TicketNumber
                                            </a>
                                        </td>
                                        <td class="text-ink fw-medium">@r.ProductName</td>
                                        <td class="text-truncate max-w-200" title="@r.Subject">@r.Subject</td>
                                        <td><span class="badge badge-priority-@r.Priority.ToString().ToLower()">@r.Priority</span></td>
                                        <td><span class="pc-badge @r.StatusBadgeCssClass">@r.StatusDisplayText</span></td>
                                        <td class="num-tabular small text-muted">@r.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                                        <td class="text-end">
                                            <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@r.Id" class="btn-pc-secondary btn-pc-sm">
                                                <i class="bi bi-gear me-1"></i> Manage
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">
                        No service requests submitted by this customer.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
