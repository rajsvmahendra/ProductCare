@model ProductCare.Web.ViewModels.Admin.AdminCustomerListViewModel
@{
    ViewData["Title"] = "Customer Accounts";
}

<!-- Page Header & Counts -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-ink mb-1 font-heading">Customer Directory</h1>
        <p class="text-muted mb-0">Overview of all registered customers, associated products, and open support tickets.</p>
    </div>
    <span class="pc-badge pc-badge-primary">Total Customers: @Model.TotalCustomers</span>
</div>

<!-- Search Bar -->
<div class="pc-card mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-10">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search customer by name, email, or city..." />
            </div>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn-pc-secondary w-100 btn-pc-sm">Search</button>
            <a asp-action="Index" class="btn btn-light border btn-pc-sm d-flex align-items-center justify-content-center" title="Reset">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Customer Table Card -->
<div class="pc-card overflow-hidden">
    <div class="pc-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-people me-2 text-primary-pc"></i>Registered Customer Accounts</span>
    </div>
    <div class="p-0">
        @if (Model.Customers.Any())
        {
            <div class="table-responsive">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Customer Name</th>
                            <th>Email Address</th>
                            <th>City</th>
                            <th>Registered Devices</th>
                            <th>Total Tickets</th>
                            <th>Open Tickets</th>
                            <th>Member Since</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Customers)
                        {
                            <tr>
                                <td class="fw-bold text-ink">@c.FullName</td>
                                <td class="text-muted">@c.Email</td>
                                <td>@(string.IsNullOrEmpty(c.City) ? "—" : c.City)</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@c.RegisteredProductsCount devices</span>
                                </td>
                                <td class="num-tabular">@c.TotalServiceRequestsCount</td>
                                <td>
                                    @if (c.OpenServiceRequestsCount > 0)
                                    {
                                        <span class="pc-badge pc-badge-warning">@c.OpenServiceRequestsCount Open</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0</span>
                                    }
                                </td>
                                <td class="num-tabular small text-muted">@c.CreatedAtUtc.ToString("MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@c.Id" class="btn-pc-secondary btn-pc-sm">
                                        <span>View Profile</span>
                                        <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-people fs-1 text-muted opacity-50 mb-3 d-block"></i>
                <p class="mb-0 fw-medium text-ink">No customer accounts matched your search criteria.</p>
            </div>
        }
    </div>
</div>
