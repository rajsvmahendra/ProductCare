@model ProductCare.Web.ViewModels.Admin.AdminCustomerListViewModel
@{
    ViewData["Title"] = "Customer Accounts";
}

<!-- Page Header & Counts -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <span class="d-inline-block text-uppercase fw-bold small text-muted mb-1" style="letter-spacing: 0.08em; font-size: 0.72rem;">USER DIRECTORY</span>
        <h1 class="h3 fw-bold text-dark mb-1 font-serif">Customer Directory</h1>
        <p class="text-muted small mb-0">Overview of all registered customers, associated products, and open support tickets.</p>
    </div>
    <span class="pc-badge pc-badge-stone">Total Customers: @Model.TotalCustomers</span>
</div>

<!-- Search Bar -->
<div class="pc-card mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-10">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search customer by name, email, or city..." />
            </div>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-forest w-100 btn-sm">Search</button>
            <a asp-action="Index" class="btn btn-stone btn-sm d-flex align-items-center justify-content-center" title="Reset">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Customer Table Card -->
<div class="pc-card p-0 overflow-hidden">
    <div class="pc-demo-topbar">
        <span class="small fw-semibold text-dark"><i class="bi bi-people me-2 text-forest"></i>Registered Customer Accounts</span>
    </div>
    <div>
        @if (Model.Customers.Any())
        {
            <div class="pc-table-wrapper border-0">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Customer Name</th>
                            <th>Email Address</th>
                            <th>City</th>
                            <th>Registered Devices</th>
                            <th>Total Tickets</th>
                            <th>Open Tickets</th>
                            <th>Member Since</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Customers)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@c.FullName</td>
                                <td class="text-muted small">@c.Email</td>
                                <td class="small text-muted">@(string.IsNullOrEmpty(c.City) ? "—" : c.City)</td>
                                <td class="tabular-nums fw-semibold text-dark">@c.RegisteredProductsCount</td>
                                <td class="tabular-nums text-muted">@c.TotalServiceRequestsCount</td>
                                <td>
                                    @if (c.OpenServiceRequestsCount > 0)
                                    {
                                        <span class="pc-badge pc-badge-expiring">@c.OpenServiceRequestsCount Open</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0</span>
                                    }
                                </td>
                                <td class="small text-muted tabular-nums">@c.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-stone btn-sm" style="font-size: 11px; padding: 4px 8px;">
                                        View Profile &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-people fs-1 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold text-dark font-serif">No customer accounts found</h5>
                <p class="small text-muted mb-0">No customers match your search query.</p>
            </div>
        }
    </div>
</div>
