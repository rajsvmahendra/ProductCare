@model ProductCare.Web.ViewModels.Admin.AdminReportsViewModel
@{
    ViewData["Title"] = "Reports & Analytics";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-ink mb-1 font-heading">Reports & Operational Intelligence</h1>
        <p class="text-muted mb-0">System analytics and warranty distributions aggregated from SQL Server Stored Procedures and Views.</p>
    </div>
</div>

<!-- Date Range Filter Form -->
<div class="pc-card mb-4 p-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small text-muted">Analysis Start Date</label>
            <input type="date" name="startDate" value="@(Model.FilterStartDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label small text-muted">Analysis End Date</label>
            <input type="date" name="endDate" value="@(Model.FilterEndDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn-pc-secondary w-100 btn-pc-sm">
                <i class="bi bi-funnel me-1"></i> Apply Filter
            </button>
            <a asp-action="Index" class="btn btn-light border btn-pc-sm d-flex align-items-center justify-content-center" title="Reset Range">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- 4 KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="pc-stat-card">
            <div class="pc-stat-top">
                <span class="pc-stat-label">Filtered Tickets</span>
                <div class="pc-stat-icon-wrap bg-info-soft">
                    <i class="bi bi-ticket-detailed"></i>
                </div>
            </div>
            <div class="pc-stat-value text-info">@Model.TotalTicketsCount</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="pc-stat-card">
            <div class="pc-stat-top">
                <span class="pc-stat-label">Active Coverage</span>
                <div class="pc-stat-icon-wrap bg-teal-soft">
                    <i class="bi bi-shield-check"></i>
                </div>
            </div>
            <div class="pc-stat-value text-teal-pc">@Model.ActiveWarrantiesCount</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="pc-stat-card">
            <div class="pc-stat-top">
                <span class="pc-stat-label">Expiring Soon (&le;30d)</span>
                <div class="pc-stat-icon-wrap bg-warning-soft">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
            <div class="pc-stat-value text-warning">@Model.ExpiringSoonWarrantiesCount</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="pc-stat-card">
            <div class="pc-stat-top">
                <span class="pc-stat-label">Expired Warranties</span>
                <div class="pc-stat-icon-wrap bg-danger-soft">
                    <i class="bi bi-exclamation-circle"></i>
                </div>
            </div>
            <div class="pc-stat-value text-danger">@Model.ExpiredWarrantiesCount</div>
        </div>
    </div>
</div>

<!-- Section 1: Ticket Volume Statistics (Stored Procedure Output) -->
<div class="pc-card overflow-hidden mb-4">
    <div class="pc-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-gear-wide-connected me-2 text-primary-pc"></i>Service Ticket Statistics by Category</span>
        <span class="badge bg-light text-muted border small">Source: sp_GetServiceTicketStatistics</span>
    </div>
    <div class="p-0">
        @if (Model.TicketStatistics.Any())
        {
            <div class="table-responsive">
                <table class="pc-table text-center">
                    <thead>
                        <tr class="text-start">
                            <th class="text-start">Category</th>
                            <th>Total</th>
                            <th>Submitted</th>
                            <th>Under Review</th>
                            <th>Assigned</th>
                            <th>In Progress</th>
                            <th>Waiting Customer</th>
                            <th>Resolved</th>
                            <th>Closed</th>
                            <th>Rejected</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.TicketStatistics)
                        {
                            <tr>
                                <td class="text-start fw-bold text-ink">@s.CategoryName</td>
                                <td class="fw-bold num-tabular"><span class="pc-badge pc-badge-primary">@s.TotalTickets</span></td>
                                <td class="num-tabular">@s.SubmittedCount</td>
                                <td class="num-tabular">@s.UnderReviewCount</td>
                                <td class="num-tabular">@s.AssignedCount</td>
                                <td class="num-tabular">@s.InProgressCount</td>
                                <td class="num-tabular">@s.WaitingForCustomerCount</td>
                                <td class="num-tabular text-success fw-semibold">@s.ResolvedCount</td>
                                <td class="num-tabular text-muted">@s.ClosedCount</td>
                                <td class="num-tabular text-danger">@s.RejectedCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 text-muted opacity-50 mb-3 d-block"></i>
                <p class="mb-0 fw-medium text-ink">No ticket statistics found for the selected date range.</p>
            </div>
        }
    </div>
</div>

<!-- Section 2: Warranty Summary View (SQL Server View Output) -->
<div class="pc-card overflow-hidden">
    <div class="pc-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-award me-2 text-primary-pc"></i>Product Warranty Summary</span>
        <span class="badge bg-light text-muted border small">Source: vw_ProductWarrantySummary</span>
    </div>
    <div class="p-0">
        @if (Model.WarrantySummaries.Any())
        {
            <div class="table-responsive">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Serial Number</th>
                            <th>Owner</th>
                            <th>Category</th>
                            <th>Purchase Date</th>
                            <th>Expiry Date</th>
                            <th>Remaining</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.WarrantySummaries.Take(25))
                        {
                            <tr>
                                <td class="fw-bold text-ink">@v.ProductName</td>
                                <td><code class="text-ink num-tabular">@v.SerialNumber</code></td>
                                <td class="text-muted small">@v.CustomerName</td>
                                <td><span class="badge bg-light text-dark border">@v.CategoryName</span></td>
                                <td class="num-tabular">@v.PurchaseDate.ToString("yyyy-MM-dd")</td>
                                <td class="num-tabular">@v.WarrantyExpiryDate.ToString("yyyy-MM-dd")</td>
                                <td class="num-tabular">
                                    @if (v.DaysRemaining < 0)
                                    {
                                        <span class="text-danger small">Expired (@Math.Abs(v.DaysRemaining)d)</span>
                                    }
                                    else
                                    {
                                        <span>@v.DaysRemaining days</span>
                                    }
                                </td>
                                <td><span class="pc-badge @(v.WarrantyStatusText == "Active" ? "pc-badge-success" : v.WarrantyStatusText == "Expiring Soon" ? "pc-badge-warning" : "pc-badge-danger")">@v.WarrantyStatusText</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-award fs-1 text-muted opacity-50 mb-3 d-block"></i>
                <p class="mb-0 fw-medium text-ink">No product warranty data available in the view projection.</p>
            </div>
        }
    </div>
</div>
