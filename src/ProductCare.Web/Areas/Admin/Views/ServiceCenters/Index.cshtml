@model ProductCare.Web.ViewModels.Admin.AdminServiceCenterListViewModel
@{
    ViewData["Title"] = "Service Centres Directory Management";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <span class="d-inline-block text-uppercase fw-bold small text-muted mb-1" style="letter-spacing: 0.08em; font-size: 0.72rem;">OPERATIONAL PARTNER NETWORK</span>
        <h1 class="h3 fw-bold text-dark mb-1 font-display">Service Centres Directory</h1>
        <p class="text-muted small mb-0">Manage certified campus facilities, repair partners, and diagnostic routing hubs.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" class="btn btn-forest btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Service Centre
        </a>
    </div>
</div>

<!-- Search Bar -->
<div class="pc-card pc-glass-card mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-9">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search center name, city, supported brands or categories..." />
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-forest w-100 btn-sm">Search Directory</button>
            <a asp-action="Index" class="btn btn-stone btn-sm d-flex align-items-center justify-content-center" title="Reset Search">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Service Centers Management Table -->
<div class="pc-card pc-glass-card p-0 overflow-hidden">
    <div class="d-flex align-items-center justify-content-between p-3 border-bottom" style="background-color: var(--pc-surface-secondary);">
        <span class="small fw-semibold text-dark"><i class="bi bi-building me-2 text-forest"></i>Directory Listings</span>
        <span class="badge bg-light text-muted border small">Total: @Model.TotalCount Centre(s)</span>
    </div>

    <div>
        @if (Model.Centers.Any())
        {
            <div class="pc-table-wrapper border-0">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Center Name &amp; Location</th>
                            <th>Supported Brands</th>
                            <th>Supported Categories</th>
                            <th>Contact &amp; Hours</th>
                            <th>Active Tickets</th>
                            <th>Verification</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Centers)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@c.Name</div>
                                    <div class="small text-muted" style="font-size: 11px;">
                                        <i class="bi bi-geo-alt text-muted"></i> @c.Address@(string.IsNullOrEmpty(c.Locality) ? "" : $", {c.Locality}"), <strong>@c.City@(string.IsNullOrEmpty(c.State) ? "" : $", {c.State}")</strong>
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-truncate" style="max-width: 180px;" title="@c.SupportedBrands">
                                        @c.SupportedBrands
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-truncate" style="max-width: 180px;" title="@c.SupportedCategories">
                                        @c.SupportedCategories
                                    </div>
                                </td>
                                <td class="small">
                                    <div><i class="bi bi-telephone text-muted me-1"></i>@c.Phone</div>
                                    <div class="text-muted" style="font-size: 11px;"><i class="bi bi-clock text-muted me-1"></i>@c.OpeningHours</div>
                                </td>
                                <td>
                                    <span class="badge @(c.ActiveTicketCount > 0 ? "bg-primary" : "bg-light text-muted border")" style="font-size: 11px;">
                                        @c.ActiveTicketCount work order(s)
                                    </span>
                                </td>
                                <td>
                                    @if (c.IsVerified)
                                    {
                                        <span class="badge bg-success" style="font-size: 10px;">
                                            <i class="bi bi-check-circle-fill"></i> Verified Partner
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark" style="font-size: 10px;">
                                            <i class="bi bi-info-circle"></i> Sample Hub
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="pc-badge pc-badge-active" style="font-size: 10px;">Active</span>
                                    }
                                    else
                                    {
                                        <span class="pc-badge pc-badge-expired" style="font-size: 10px;">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-stone btn-sm" style="font-size: 11px; padding: 4px 8px;" title="Edit Center">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@c.Id" method="post" class="d-inline m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(c.IsActive ? "btn-outline-danger" : "btn-outline-success") btn-sm" style="font-size: 11px; padding: 4px 8px;" title="@(c.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(c.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-building fs-1 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold text-dark font-display">No service centres found</h5>
                <p class="small text-muted mb-3">No records match your query.</p>
                <a asp-action="Create" class="btn btn-forest btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Add Service Centre
                </a>
            </div>
        }
    </div>
</div>
