@model ProductCare.Web.ViewModels.Admin.AdminServiceCenterCreateEditViewModel
@{
    ViewData["Title"] = "Edit Service Centre";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <span class="d-inline-block text-uppercase fw-bold small text-muted mb-1" style="letter-spacing: 0.08em; font-size: 0.72rem;">DIRECTORY MANAGEMENT</span>
                <h1 class="h3 fw-bold text-dark mb-1 font-display">Edit Service Centre</h1>
                <p class="text-muted small mb-0">Update contact information, brand authorizations, and operational status.</p>
            </div>
            <a asp-action="Index" class="btn btn-stone btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Directory
            </a>
        </div>

        <div class="pc-card pc-glass-card p-4 p-md-5">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Centre Name</label>
                        <input asp-for="Name" class="form-control" required autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Locality" class="form-label">Locality / Hub</label>
                        <input asp-for="Locality" class="form-control" />
                        <span asp-validation-for="Locality" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="City" class="form-label">City</label>
                        <input asp-for="City" class="form-control" required />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Address" class="form-label">Physical Street Address</label>
                        <input asp-for="Address" class="form-control" required />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="State" class="form-label">State</label>
                        <input asp-for="State" class="form-control" />
                        <span asp-validation-for="State" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Country" class="form-label">Country</label>
                        <input asp-for="Country" class="form-control" />
                        <span asp-validation-for="Country" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">Telephone Hotline</label>
                        <input asp-for="Phone" class="form-control" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Support Email</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="OpeningHours" class="form-label">Operating Schedule &amp; Hours</label>
                    <input asp-for="OpeningHours" class="form-control" required />
                    <span asp-validation-for="OpeningHours" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SupportedBrands" class="form-label">Supported Hardware Brands (comma-separated)</label>
                    <input asp-for="SupportedBrands" class="form-control" required />
                    <span asp-validation-for="SupportedBrands" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SupportedCategories" class="form-label">Supported Equipment Categories (comma-separated)</label>
                    <input asp-for="SupportedCategories" class="form-control" required />
                    <span asp-validation-for="SupportedCategories" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Website" class="form-label">Website URL (Optional)</label>
                        <input asp-for="Website" type="url" class="form-control" />
                        <span asp-validation-for="Website" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MapUrl" class="form-label">Map / Directions Link (Optional)</label>
                        <input asp-for="MapUrl" type="url" class="form-control" />
                        <span asp-validation-for="MapUrl" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">Operational Notes / Specializations</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" id="checkActive" />
                            <label class="form-check-label small fw-semibold text-dark" for="checkActive">Active for New Ticket Routing</label>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-check">
                            <input asp-for="IsVerified" class="form-check-input" id="checkVerified" />
                            <label class="form-check-label small fw-semibold text-dark" for="checkVerified">Officially Verified Partner</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top" style="border-color: var(--pc-stone) !important;">
                    <a asp-action="Index" class="btn btn-stone">Cancel</a>
                    <button type="submit" class="btn btn-forest px-4">
                        <i class="bi bi-check2 me-1"></i> Update Service Centre
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
