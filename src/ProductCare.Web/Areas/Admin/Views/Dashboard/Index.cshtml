@model ProductCare.Web.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Administrator Portal";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-1">Administrative Overview</h2>
            <span class="badge bg-danger px-2 py-1">Admin Portal</span>
        </div>
        <p class="text-muted mb-0">System-wide monitoring of customer accounts, product warranties, and support ticket queues.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" asp-controller="ServiceRequests" class="btn btn-primary">
            <i class="bi bi-ticket-detailed me-1"></i> Open Tickets Queue
        </a>
        <a asp-action="Index" asp-controller="Reports" class="btn btn-outline-dark">
            <i class="bi bi-bar-chart-line me-1"></i> View Reports
        </a>
    </div>
</div>

<!-- Key Performance Metrics -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-2">
        <div class="pc-stat-card">
            <div class="pc-stat-label">Total Customers</div>
            <div class="pc-stat-value">@Model.TotalCustomers</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="pc-stat-card stat-teal">
            <div class="pc-stat-label">Total Products</div>
            <div class="pc-stat-value text-teal">@Model.TotalProducts</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="pc-stat-card stat-info">
            <div class="pc-stat-label">Total Requests</div>
            <div class="pc-stat-value text-info">@Model.TotalServiceRequests</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="pc-stat-card stat-warning">
            <div class="pc-stat-label">Pending Action</div>
            <div class="pc-stat-value text-warning">@Model.PendingRequests</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="pc-stat-card stat-primary">
            <div class="pc-stat-label">In Progress</div>
            <div class="pc-stat-value text-primary">@Model.InProgressRequests</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="pc-stat-card stat-success">
            <div class="pc-stat-label">Resolved / Closed</div>
            <div class="pc-stat-value text-success">@(Model.ResolvedRequests + Model.ClosedRequests)</div>
        </div>
    </div>
</div>

<!-- Master Queue Table -->
<div class="card pc-card mb-4">
    <div class="pc-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history me-2 text-primary"></i>Recent Ticket Submissions</span>
        <a asp-controller="ServiceRequests" asp-action="Index" class="small text-decoration-none">Manage All Tickets &rarr;</a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentTickets.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ticket #</th>
                            <th>Customer</th>
                            <th>Target Product</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Current Status</th>
                            <th>Submitted At</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.RecentTickets)
                        {
                            <tr>
                                <td class="font-monospace fw-bold">@t.TicketNumber</td>
                                <td>
                                    <strong>@t.CustomerName</strong>
                                    <div class="text-muted small">@t.CustomerEmail</div>
                                </td>
                                <td>@t.ProductName</td>
                                <td><span class="badge bg-light text-dark border">@t.CategoryText</span></td>
                                <td><span class="@t.PriorityBadgeCssClass">@t.PriorityText</span></td>
                                <td><span class="@t.StatusBadgeCssClass">@t.StatusText</span></td>
                                <td>@t.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">
                                        Manage &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                <p class="mb-0">No service requests recorded in the system.</p>
            </div>
        }
    </div>
</div>
