@model ProductCare.Web.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Overview";
}

<!-- Page Header & Action Controls -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <span class="d-inline-block text-uppercase fw-bold small text-muted mb-1" style="letter-spacing: 0.08em; font-size: 0.72rem;">ADMINISTRATIVE CONTROL</span>
        <h1 class="h3 fw-bold text-dark mb-0 font-serif">Operations Dashboard</h1>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" asp-controller="ServiceRequests" class="btn btn-forest btn-sm">
            <i class="bi bi-inbox me-1"></i>
            <span>Master Ticket Queue</span>
        </a>
        <a asp-action="Index" asp-controller="Reports" class="btn btn-stone btn-sm">
            <i class="bi bi-bar-chart-line me-1"></i>
            <span>Reports &amp; Intelligence</span>
        </a>
    </div>
</div>

<!-- 4 Primary Operational KPI Cards -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-sm-6 col-xl-3">
        <div class="pc-kpi-card">
            <div class="pc-kpi-label">Customer Accounts</div>
            <div class="pc-kpi-val">@Model.TotalCustomers</div>
            <div class="small text-muted mt-2 d-flex align-items-center gap-1">
                <i class="bi bi-people"></i> Registered customer accounts
            </div>
        </div>
    </div>

    <!-- Total Products -->
    <div class="col-sm-6 col-xl-3">
        <div class="pc-kpi-card">
            <div class="pc-kpi-label">Monitored Inventory</div>
            <div class="pc-kpi-val" style="color: var(--pc-status-active);">@Model.TotalProducts</div>
            <div class="small text-muted mt-2 d-flex align-items-center gap-1">
                <i class="bi bi-laptop" style="color: var(--pc-status-active);"></i> Total customer devices
            </div>
        </div>
    </div>

    <!-- Pending Action -->
    <div class="col-sm-6 col-xl-3">
        <div class="pc-kpi-card">
            <div class="pc-kpi-label">Pending Triage</div>
            <div class="pc-kpi-val" style="color: var(--pc-amber);">@Model.PendingRequests</div>
            <div class="small text-muted mt-2 d-flex align-items-center gap-1">
                <i class="bi bi-clock-history" style="color: var(--pc-amber);"></i> Submitted &amp; awaiting review
            </div>
        </div>
    </div>

    <!-- In Progress Requests -->
    <div class="col-sm-6 col-xl-3">
        <div class="pc-kpi-card">
            <div class="pc-kpi-label">In Progress</div>
            <div class="pc-kpi-val" style="color: var(--pc-status-progress);">@Model.InProgressRequests</div>
            <div class="small text-muted mt-2 d-flex align-items-center gap-1">
                <i class="bi bi-tools" style="color: var(--pc-status-progress);"></i> Active technician assignments
            </div>
        </div>
    </div>
</div>

<!-- Pending Triage Queue Table -->
<div class="pc-card p-0 overflow-hidden">
    <div class="pc-demo-topbar">
        <div class="d-flex align-items-center gap-2">
            <span class="small fw-semibold text-dark"><i class="bi bi-inbox me-2 text-forest"></i>Recent Service Tickets</span>
            <span class="badge bg-warning text-dark border small" style="font-size: 10px;">Queue Activity</span>
        </div>
        <a asp-action="Index" asp-controller="ServiceRequests" class="small fw-semibold text-forest">
            Open Full Master Queue &rarr;
        </a>
    </div>

    <div>
        @if (Model.RecentTickets.Any())
        {
            <div class="pc-table-wrapper border-0">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Ticket #</th>
                            <th>Customer</th>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Received</th>
                            <th class="text-end">Triage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.RecentTickets)
                        {
                            <tr>
                                <td class="font-monospace fw-bold small text-dark">
                                    <a asp-action="Details" asp-controller="ServiceRequests" asp-route-id="@r.Id" class="text-dark text-decoration-none">
                                        #@r.TicketNumber
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark small">@r.CustomerName</div>
                                    <div class="small text-muted" style="font-size: 11px;">@r.CustomerEmail</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark small">@r.ProductName</div>
                                </td>
                                <td><span class="badge bg-light text-dark border small">@r.CategoryText</span></td>
                                <td><span class="@r.PriorityBadgeCssClass" style="font-size: 11px;">@r.PriorityText</span></td>
                                <td><span class="@r.StatusBadgeCssClass" style="font-size: 11px;">@r.StatusText</span></td>
                                <td class="small text-muted tabular-nums">@r.CreatedAtUtc.ToString("dd MMM HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-controller="ServiceRequests" asp-route-id="@r.Id" class="btn btn-forest btn-sm" style="font-size: 11px; padding: 4px 10px;">
                                        Triage &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-check-all fs-1 text-forest mb-3 d-block"></i>
                <h5 class="fw-bold text-dark font-serif">Triage Queue Clear</h5>
                <p class="small text-muted mb-0">No unassigned service requests pending triage at this time.</p>
            </div>
        }
    </div>
</div>
