@model ProductCare.Web.ViewModels.Admin.AdminProductListViewModel
@{
    ViewData["Title"] = "Global Inventory";
}

<!-- Page Header & Counts -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-ink mb-1 font-heading">Global Product Inventory</h1>
        <p class="text-muted mb-0">System-wide inventory of customer-registered appliances, electronics, and warranty terms.</p>
    </div>
    <span class="pc-badge pc-badge-primary">Total: @Model.TotalProducts Devices</span>
</div>

<!-- Filters Toolbar -->
<div class="pc-card mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, brand, model, S/N, customer..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="category" class="form-select" asp-for="FilterCategory" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.ProductCategory>()">
                <option value="">-- All Categories --</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select" asp-for="FilterStatus" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.WarrantyStatus>()">
                <option value="">-- All Warranty Statuses --</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn-pc-secondary w-100 btn-pc-sm">Filter</button>
            <a asp-action="Index" class="btn btn-light border btn-pc-sm d-flex align-items-center justify-content-center" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Products Table Card -->
<div class="pc-card overflow-hidden">
    <div class="pc-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-boxes me-2 text-primary-pc"></i>Global Device Directory</span>
    </div>
    <div class="p-0">
        @if (Model.Products.Any())
        {
            <div class="table-responsive">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Product Name</th>
                            <th>Brand & Model</th>
                            <th>Serial Number</th>
                            <th>Customer Owner</th>
                            <th>Category</th>
                            <th>Purchase Date</th>
                            <th>Expiry Date</th>
                            <th>Status</th>
                            <th>Tickets</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Products)
                        {
                            <tr>
                                <td class="fw-bold text-ink">
                                    <a asp-action="Details" asp-route-id="@p.Id" class="text-ink text-decoration-none">
                                        @p.Name
                                    </a>
                                </td>
                                <td class="text-muted">@p.Brand &middot; @p.ModelNumber</td>
                                <td><code class="text-ink num-tabular">@p.SerialNumber</code></td>
                                <td>
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@p.CustomerId" class="text-primary-pc text-decoration-none fw-semibold">
                                        @p.CustomerName
                                    </a>
                                    <div class="text-muted small">@p.CustomerEmail</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@p.CategoryName</span></td>
                                <td class="num-tabular">@p.PurchaseDate.ToString("yyyy-MM-dd")</td>
                                <td class="num-tabular">@p.WarrantyExpiryDate.ToString("yyyy-MM-dd")</td>
                                <td><span class="pc-badge @p.StatusBadgeCssClass">@p.StatusDisplayText</span></td>
                                <td class="num-tabular">
                                    @if (p.ServiceRequestsCount > 0)
                                    {
                                        <span class="pc-badge pc-badge-info">@p.ServiceRequestsCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@p.Id" class="btn-pc-secondary btn-pc-sm">
                                        <span>Details</span>
                                        <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-boxes fs-1 text-muted opacity-50 mb-3 d-block"></i>
                <p class="mb-0 fw-medium text-ink">No products found matching the criteria.</p>
            </div>
        }
    </div>
</div>
