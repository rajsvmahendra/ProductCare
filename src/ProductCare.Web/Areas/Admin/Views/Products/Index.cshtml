@model ProductCare.Web.ViewModels.Admin.AdminProductListViewModel
@{
    ViewData["Title"] = "Global Inventory";
}

<!-- Page Header & Counts -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <span class="d-inline-block text-uppercase fw-bold small text-muted mb-1" style="letter-spacing: 0.06em; font-size: 0.72rem;">SYSTEM INVENTORY</span>
        <h1 class="h3 fw-bold text-dark mb-1 font-display">Global Product Inventory</h1>
        <p class="text-muted small mb-0">System-wide inventory of customer-registered appliances, electronics, and warranty commitments.</p>
    </div>
    <span class="badge bg-light text-muted border px-3 py-2 small">Total: @Model.TotalProducts Device(s)</span>
</div>

<!-- Filters Toolbar -->
<div class="pc-card mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, brand, model, S/N, customer..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="category" class="form-select" asp-for="FilterCategory" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.ProductCategory>()">
                <option value="">-- All Categories --</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select" asp-for="FilterStatus" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.WarrantyStatus>()">
                <option value="">-- All Warranty Statuses --</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-forest w-100 btn-sm">Filter</button>
            <a asp-action="Index" class="btn btn-stone btn-sm d-flex align-items-center justify-content-center" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Products Table Card -->
<div class="pc-card p-0 overflow-hidden">
    <div class="d-flex align-items-center justify-content-between p-3 border-bottom" style="background-color: var(--pc-surface-secondary);">
        <span class="small fw-semibold text-dark"><i class="bi bi-boxes me-2 text-forest"></i>Global Device Directory</span>
    </div>
    <div>
        @if (Model.Products.Any())
        {
            <div class="pc-table-wrapper border-0">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Product Name</th>
                            <th>Brand &amp; Model</th>
                            <th>Serial Number</th>
                            <th>Customer Owner</th>
                            <th>Category</th>
                            <th>Purchase Date</th>
                            <th>Warranty Expiry</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Products)
                        {
                            <tr>
                                <td class="fw-semibold text-dark">@p.Name</td>
                                <td class="small text-muted">@p.Brand <span class="text-dark">@p.ModelNumber</span></td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace" style="font-size: 11px;">@p.SerialNumber</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark small">@p.CustomerName</div>
                                    <div class="text-muted small" style="font-size: 11px;">@p.CustomerEmail</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border" style="font-size: 11px;">@p.CategoryName</span>
                                </td>
                                <td class="small text-muted">@p.PurchaseDate.ToString("dd MMM yyyy")</td>
                                <td class="small">
                                    <div class="fw-medium">@p.WarrantyExpiryDate.ToString("dd MMM yyyy")</div>
                                    <div class="text-muted" style="font-size: 11px;">@p.RemainingDays days left</div>
                                </td>
                                <td>
                                    @if (p.WarrantyStatus == ProductCare.Web.Models.Enums.WarrantyStatus.Active)
                                    {
                                        <span class="pc-badge pc-badge-active">Active</span>
                                    }
                                    else if (p.WarrantyStatus == ProductCare.Web.Models.Enums.WarrantyStatus.ExpiringSoon)
                                    {
                                        <span class="pc-badge pc-badge-expiring">Expiring Soon</span>
                                    }
                                    else
                                    {
                                        <span class="pc-badge pc-badge-expired">Expired</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-boxes fs-1 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold text-dark">No products found</h5>
                <p class="small text-muted mb-0">No registered products matched the query.</p>
            </div>
        }
    </div>
</div>
