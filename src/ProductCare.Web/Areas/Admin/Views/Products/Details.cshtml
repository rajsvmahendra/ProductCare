@model ProductCare.Web.ViewModels.Admin.AdminProductDetailsViewModel
@{
    ViewData["Title"] = $"Device: {Model.Name}";
}

<!-- Page Header & Action Controls -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="pc-badge @Model.Warranty.StatusBadgeCssClass">@Model.Warranty.StatusDisplayText</span>
            <span class="badge bg-light text-muted border">@Model.CategoryName</span>
        </div>
        <h1 class="h3 fw-bold text-ink mb-0 font-heading">@Model.Name</h1>
    </div>
    <a asp-action="Index" class="btn-pc-secondary btn-pc-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Inventory
    </a>
</div>

<div class="row g-4 mb-4">
    <!-- Main Specification Card -->
    <div class="col-lg-8">
        <div class="pc-card h-100">
            <div class="pc-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-info-circle me-2 text-primary-pc"></i>Device Specifications</span>
                <span class="small text-muted">Registered: @Model.CreatedAtUtc.ToString("MMM dd, yyyy")</span>
            </div>
            <div class="pc-card-body">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Brand / Manufacturer</div>
                        <div class="fs-5 fw-bold text-ink">@Model.Brand</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Model Number</div>
                        <div class="fs-5 fw-bold text-ink num-tabular">@Model.ModelNumber</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Serial Number (S/N)</div>
                        <div class="fs-5 font-monospace text-primary-pc fw-bold num-tabular">@Model.SerialNumber</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Customer Owner</div>
                        <div class="fs-5 text-ink">
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="text-primary-pc text-decoration-none fw-semibold">
                                @Model.CustomerName
                            </a>
                            <div class="text-muted small">@Model.CustomerEmail</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Purchase Date</div>
                        <div class="fs-5 text-ink num-tabular">@Model.PurchaseDate.ToString("MMMM dd, yyyy")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Purchase Price</div>
                        <div class="fs-5 text-ink num-tabular">@(Model.PurchasePrice.HasValue ? Model.PurchasePrice.Value.ToString("C") : "N/A")</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mt-4 pt-4 border-top">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1 mb-2">Customer Notes</div>
                        <p class="mb-0 text-secondary bg-light p-3 rounded-3 border small">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Warranty & Invoice Side Cards -->
    <div class="col-lg-4">
        <div class="d-flex flex-column gap-3">
            <!-- Dynamic Warranty Card -->
            <div class="pc-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted small text-uppercase fw-bold letter-spacing-1">Warranty Term</span>
                    <span class="pc-badge @Model.Warranty.StatusBadgeCssClass">@Model.Warranty.StatusDisplayText</span>
                </div>

                <div class="display-6 fw-bold text-ink mb-1 num-tabular">
                    @if (Model.Warranty.Status == ProductCare.Web.Models.Enums.WarrantyStatus.Expired)
                    {
                        <span class="text-danger">Expired</span>
                    }
                    else
                    {
                        <span>@Model.Warranty.RemainingDays <span class="fs-6 text-muted fw-normal">days remaining</span></span>
                    }
                </div>

                <div class="small text-muted mb-3">
                    Valid until: <strong class="text-ink">@Model.WarrantyExpiryDate.ToString("MMMM dd, yyyy")</strong>
                </div>

                <div class="small text-muted">
                    Coverage: <strong>@Model.WarrantyDurationMonths months</strong> from purchase.
                </div>
            </div>

            <!-- Stored Invoice Proof Card -->
            <div class="pc-card p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted small text-uppercase fw-bold letter-spacing-1">Receipt Verification</span>
                    <i class="bi bi-file-earmark-check text-success fs-5"></i>
                </div>

                @if (Model.HasInvoice)
                {
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="fw-bold small text-ink mb-1">Invoice Attached</div>
                        <div class="text-muted" style="font-size: 12px;">Stored in private vault &middot; Verified</div>
                    </div>
                    <a asp-area="Customer" asp-controller="Products" asp-action="DownloadInvoice" asp-route-id="@Model.Id" class="btn-pc-secondary w-100 btn-pc-sm">
                        <i class="bi bi-download me-1"></i> Download Stored Invoice
                    </a>
                }
                else
                {
                    <div class="p-3 bg-light rounded-3 border text-center text-muted small">
                        No invoice file uploaded for this product.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Associated Service Tickets History -->
<div class="pc-card overflow-hidden">
    <div class="pc-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-tools me-2 text-primary-pc"></i>Service History for this Product (@Model.ServiceRequests.Count)</span>
    </div>
    <div class="p-0">
        @if (Model.ServiceRequests.Any())
        {
            <div class="table-responsive">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Ticket #</th>
                            <th>Subject</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.ServiceRequests)
                        {
                            <tr>
                                <td class="fw-bold num-tabular">
                                    <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@r.Id" class="text-primary-pc text-decoration-none">
                                        @r.TicketNumber
                                    </a>
                                </td>
                                <td class="text-truncate max-w-200" title="@r.Subject">@r.Subject</td>
                                <td><span class="badge badge-priority-@r.Priority.ToString().ToLower()">@r.Priority</span></td>
                                <td><span class="pc-badge @r.StatusBadgeCssClass">@r.Status</span></td>
                                <td class="num-tabular small text-muted">@r.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@r.Id" class="btn-pc-secondary btn-pc-sm">
                                        <span>Manage</span>
                                        <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-check2-circle fs-1 text-teal-pc opacity-50 mb-3 d-block"></i>
                <p class="mb-0 fw-medium text-ink">No repair or maintenance tickets filed for this device.</p>
            </div>
        }
    </div>
</div>
