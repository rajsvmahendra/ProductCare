@model ProductCare.Web.ViewModels.Admin.AdminServiceRequestListViewModel
@{
    ViewData["Title"] = "Master Ticket Queue";
}

<!-- Page Header & Queue Counts -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-ink mb-1 font-heading">Master Service Queue</h1>
        <p class="text-muted mb-0">Triage incoming repair tickets, assign staff, and advance workflow lifecycles.</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="pc-badge pc-badge-warning">Pending: @Model.PendingCount</span>
        <span class="pc-badge pc-badge-primary">In Progress: @Model.InProgressCount</span>
        <span class="pc-badge pc-badge-success">Resolved: @Model.ResolvedCount</span>
    </div>
</div>

<!-- Filters Toolbar -->
<div class="pc-card mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Ticket #, customer, device..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select" asp-for="FilterStatus" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.RequestStatus>()">
                <option value="">-- All Statuses --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="priority" class="form-select" asp-for="FilterPriority" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.PriorityLevel>()">
                <option value="">-- All Priorities --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="category" class="form-select" asp-for="FilterCategory" asp-items="Html.GetEnumSelectList<ProductCare.Web.Models.Enums.RequestCategory>()">
                <option value="">-- All Categories --</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn-pc-secondary w-100 btn-pc-sm">Filter</button>
            <a asp-action="Index" class="btn btn-light border btn-pc-sm d-flex align-items-center justify-content-center" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Master Queue Table Card -->
<div class="pc-card overflow-hidden">
    <div class="pc-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-inbox me-2 text-primary-pc"></i>Active Operational Queue</span>
        <span class="badge bg-light text-muted border">Total: @Model.TotalTickets</span>
    </div>
    <div class="p-0">
        @if (Model.Tickets.Any())
        {
            <div class="table-responsive">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Ticket #</th>
                            <th>Customer</th>
                            <th>Target Device</th>
                            <th>Subject</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Technician</th>
                            <th>Submitted</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Tickets)
                        {
                            <tr>
                                <td class="fw-bold num-tabular">
                                    <a asp-action="Details" asp-route-id="@t.Id" class="text-primary-pc text-decoration-none">
                                        @t.TicketNumber
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-bold text-ink">@t.CustomerName</div>
                                    <div class="text-muted small">@t.CustomerEmail</div>
                                </td>
                                <td>
                                    <div class="text-ink fw-medium">@t.ProductName</div>
                                    <div class="text-muted small">@t.ProductBrand</div>
                                </td>
                                <td class="text-truncate max-w-200" title="@t.Subject">@t.Subject</td>
                                <td><span class="badge badge-priority-@t.Priority.ToString().ToLower()">@t.Priority</span></td>
                                <td><span class="pc-badge @t.StatusBadgeCssClass">@t.StatusDisplayText</span></td>
                                <td class="small text-muted">@(string.IsNullOrEmpty(t.AssignedTechnician) ? "—" : t.AssignedTechnician)</td>
                                <td class="num-tabular small text-muted">@t.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@t.Id" class="btn-pc-secondary btn-pc-sm">
                                        <span>Manage</span>
                                        <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 text-muted opacity-50 mb-3 d-block"></i>
                <p class="mb-0 fw-medium text-ink">No tickets match the selected filters.</p>
            </div>
        }
    </div>
</div>
