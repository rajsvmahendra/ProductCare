@model ProductCare.Web.ViewModels.Admin.AdminServiceRequestDetailsViewModel
@{
    ViewData["Title"] = $"Manage Ticket #{Model.TicketNumber}";
}

<!-- Page Header & Action Controls -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="pc-badge @Model.StatusBadgeCssClass">@Model.StatusDisplayText</span>
            <span class="badge badge-priority-@Model.Priority.ToString().ToLower()">@Model.Priority Priority</span>
            <span class="badge bg-light text-muted border">@Model.CategoryName</span>
        </div>
        <h1 class="h3 fw-bold text-ink mb-0 font-heading num-tabular">Ticket #@Model.TicketNumber</h1>
    </div>
    <a asp-action="Index" class="btn-pc-secondary btn-pc-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Queue
    </a>
</div>

<div class="row g-4">
    <!-- Left Column: Ticket Info & Customer/Product Summary -->
    <div class="col-lg-7">
        <!-- Main Service Ticket Card -->
        <div class="pc-card mb-4">
            <div class="pc-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-file-text me-2 text-primary-pc"></i>Service Ticket Overview</span>
                <span class="small text-muted num-tabular">Submitted: @Model.CreatedAtUtc.ToString("MMM dd, yyyy HH:mm") UTC</span>
            </div>
            <div class="pc-card-body">
                <h2 class="h5 fw-bold text-ink mb-2">@Model.Subject</h2>
                <div class="p-3 bg-light rounded-3 border mb-4 text-secondary small" style="white-space: pre-wrap; line-height: 1.6;">@Model.Description</div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Customer Account</div>
                        <div class="fw-bold text-ink">@Model.CustomerName</div>
                        <div class="text-muted small">@Model.CustomerEmail</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Assigned Technician</div>
                        <div class="fw-bold text-ink">
                            @(string.IsNullOrEmpty(Model.CurrentAssignedTechnician) ? "Unassigned (Awaiting Review)" : Model.CurrentAssignedTechnician)
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Submission Date</div>
                        <div class="fw-semibold text-ink num-tabular">@Model.CreatedAtUtc.ToString("MMMM dd, yyyy HH:mm")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase letter-spacing-1">Resolution Date</div>
                        <div class="fw-semibold text-ink num-tabular">
                            @(Model.ResolvedAtUtc?.ToString("MMMM dd, yyyy HH:mm") ?? "Pending Resolution")
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.CurrentAdminRemarks))
                {
                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex align-items-center gap-2 text-primary-pc fw-bold small mb-2">
                            <i class="bi bi-chat-quote-fill"></i>
                            <span>Current Administrator Remarks</span>
                        </div>
                        <div class="p-3 rounded-3 border" style="background: #EEF0FF; border-color: #DDE3FC !important; color: var(--pc-ink);">
                            @Model.CurrentAdminRemarks
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Target Product Card -->
        <div class="pc-card mb-4">
            <div class="pc-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-laptop me-2 text-primary-pc"></i>Target Product Specifications</span>
                <span class="small text-muted">Serial: <code class="text-ink">@Model.ProductSerialNumber</code></span>
            </div>
            <div class="pc-card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <span class="text-muted small">Device Name:</span> <strong class="text-ink">@Model.ProductName</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small">Brand & Model:</span> <strong class="text-ink">@Model.ProductBrand &middot; @Model.ProductModelNumber</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small">Warranty Expiry:</span> <strong class="text-ink num-tabular">@Model.ProductWarrantyExpiryDate.ToString("yyyy-MM-dd")</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small">Coverage:</span>
                        <span class="pc-badge @Model.ProductWarrantyStatusBadge">@Model.ProductWarrantyStatusText</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chronological Audit Timeline -->
        <div class="pc-card">
            <div class="pc-card-header">
                <i class="bi bi-clock-history me-2 text-primary-pc"></i>Lifecycle Audit Progression
            </div>
            <div class="pc-card-body">
                <div class="pc-stepper">
                    @foreach (var step in Model.StatusHistory)
                    {
                        var isResolved = step.ToStatus == ProductCare.Web.Models.Enums.RequestStatus.Resolved || step.ToStatus == ProductCare.Web.Models.Enums.RequestStatus.Closed;
                        var isCancelled = step.ToStatus == ProductCare.Web.Models.Enums.RequestStatus.Rejected;
                        var isCurrent = step == Model.StatusHistory.Last();

                        <div class="pc-step-item @(isCurrent ? "is-active" : "") @(isResolved ? "is-resolved" : "") @(isCancelled ? "is-cancelled" : "")">
                            <span class="pc-step-dot"></span>
                            <div class="d-flex justify-content-between align-items-baseline mb-1">
                                <span class="fw-bold text-ink small">@step.ToStatusText</span>
                                <span class="num-tabular text-muted" style="font-size: 11px;">@step.CreatedAtUtc.ToString("MMM dd, HH:mm") UTC</span>
                            </div>
                            <div class="small text-muted" style="font-size: 12px;">By: @step.ChangedByUserName</div>
                            @if (!string.IsNullOrEmpty(step.Remarks))
                            {
                                <div class="mt-1 p-2 rounded-2 bg-light small text-secondary border" style="font-size: 12px;">
                                    @step.Remarks
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Administrative Workflow Action Form -->
    <div class="col-lg-5">
        <div class="pc-card p-4">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="pc-badge pc-badge-primary">WORKFLOW ENGINE</span>
                <h2 class="h5 fw-bold text-ink mb-0 font-heading">Advance Ticket Workflow</h2>
            </div>
            <p class="text-muted small mb-4">
                Update the diagnostic stage, assign staff, and provide notes for the customer.
            </p>

            @if (Model.AllowedNextStatuses.Any())
            {
                <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label text-muted small text-uppercase fw-bold letter-spacing-1">Current State</label>
                        <div><span class="pc-badge @Model.StatusBadgeCssClass fs-6">@Model.StatusDisplayText</span></div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewStatus" class="form-label">Permissible Next Status</label>
                        <select asp-for="NewStatus" class="form-select" asp-items="Model.AllowedNextStatuses" required>
                            <option value="">-- Select Permissible Next Status --</option>
                        </select>
                        <span asp-validation-for="NewStatus" class="text-danger small"></span>
                        <div class="form-text small text-muted">Only valid state machine transitions are permitted by the workflow service.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewAssignedTechnician" class="form-label">Assign Technician</label>
                        <input asp-for="NewAssignedTechnician" value="@Model.CurrentAssignedTechnician" class="form-control" placeholder="e.g. Alex Tech, Service Team A" />
                        <span asp-validation-for="NewAssignedTechnician" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NewRemarks" class="form-label">Administrative Remarks</label>
                        <textarea asp-for="NewRemarks" class="form-control" rows="4" placeholder="Enter diagnostic findings, repair progress, or instructions for the customer..."></textarea>
                        <span asp-validation-for="NewRemarks" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn-pc-primary w-100">
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>Apply Status Transition</span>
                    </button>
                </form>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-lock-fill fs-1 text-muted opacity-50 mb-2 d-block"></i>
                    <h6 class="fw-bold text-ink">Terminal Workflow State</h6>
                    <p class="small mb-0">This ticket has reached its terminal lifecycle status (<strong>@Model.StatusDisplayText</strong>) and cannot be advanced further.</p>
                </div>
            }
        </div>
    </div>
</div>
