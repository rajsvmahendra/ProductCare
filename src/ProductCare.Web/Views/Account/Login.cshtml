@model ProductCare.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In — The Ownership Desk";
}

<div class="pc-auth-desk">
    <div class="container-xl px-3 px-md-4">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-9">
                <div class="pc-auth-panel">
                    <div class="row g-0">
                        <!-- Left Vignette (Desktop Only) -->
                        <div class="col-lg-5 pc-auth-vignette d-none d-lg-flex">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-4">
                                    <svg class="pc-brand-mark" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <rect width="32" height="32" rx="8" fill="#151F30" />
                                        <path d="M16 5.5L8 9.2V15.8C8 20.8 11.4 25.4 16 26.8C20.6 25.4 24 20.8 24 15.8V9.2L16 5.5Z" stroke="#38D9C5" stroke-width="2" />
                                        <path d="M12 16.2L14.8 19L20.2 13.2" stroke="#F3B66D" stroke-width="2.2" />
                                    </svg>
                                    <span class="pc-brand-title text-light">ProductCare</span>
                                </div>

                                <h3 class="font-display text-light fw-bold mb-2" style="font-size: 1.5rem;">The Ownership Desk</h3>
                                <p class="text-muted small mb-4">
                                    Your verified product records, warranty countdowns, and service journeys are secured in your personal vault.
                                </p>

                                <!-- Authentic Device Record Vignette -->
                                <div class="pc-demo-card p-3 mb-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="small fw-bold font-display text-muted" style="font-size: 10px;">SAMPLE VAULT RECORD</span>
                                        <span class="pc-badge pc-badge-active" style="font-size: 9px; padding: 2px 7px;">ACTIVE</span>
                                    </div>
                                    <div class="fw-bold text-light small">ThinkPad X1 Carbon Gen 11</div>
                                    <div class="small text-muted font-mono" style="font-size: 11px;">S/N: PF-4A92K1</div>
                                    <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top" style="border-color: var(--pc-border-hairline) !important; font-size: 11px;">
                                        <span class="text-electric-teal tabular-nums">426 Days Remaining</span>
                                        <span class="text-muted">Proof: Verified PDF</span>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-4 border-top" style="border-color: var(--pc-border-hairline) !important;">
                                <div class="d-flex align-items-center gap-3 text-muted small" style="font-size: 12px;">
                                    <span class="d-inline-flex align-items-center gap-1"><i class="bi bi-shield-check text-electric-teal"></i> Isolated Vault</span>
                                    <span class="d-inline-flex align-items-center gap-1"><i class="bi bi-lock text-electric-teal"></i> PBKDF2 Hashing</span>
                                </div>
                            </div>
                        </div>

                        <!-- Right Form Container -->
                        <div class="col-12 col-lg-7 pc-auth-form-container">
                            <div class="mb-4">
                                <span class="pc-section-kicker">WELCOME BACK</span>
                                <h2 class="font-display text-light mb-1" style="font-size: 1.75rem;">Sign In to Your Vault</h2>
                                <p class="text-muted small mb-0">Your records are right where you left them.</p>
                            </div>

                            <!-- Login Form -->
                            <form asp-action="Login" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="ReturnUrl" />

                                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" style="background-color: rgba(255, 107, 107, 0.15); border-color: rgba(255, 107, 107, 0.35); color: var(--pc-text-primary);" role="alert"></div>

                                <!-- Email Address -->
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">Email Address</label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" autocomplete="email" required autofocus />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <!-- Password with Show/Hide Reveal Button -->
                                <div class="mb-3">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <label asp-for="Password" class="form-label mb-0">Password</label>
                                    </div>
                                    <div class="input-group mt-1">
                                        <input asp-for="Password" type="password" id="loginPassword" class="form-control" placeholder="Enter your account password" autocomplete="current-password" required />
                                        <button type="button" class="btn btn-midnight pc-toggle-password" data-target="loginPassword" aria-label="Toggle password visibility">
                                            <svg class="pc-eye-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                            <svg class="pc-eye-slash" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                                <line x1="1" y1="1" x2="23" y2="23"></line>
                                            </svg>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <!-- Remember Me -->
                                <div class="mb-4 d-flex align-items-center justify-content-between">
                                    <div class="form-check">
                                        <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" style="background-color: var(--pc-surface-inset); border-color: var(--pc-border-subtle);" />
                                        <label class="form-check-label small text-muted" for="rememberMeCheck">Keep me signed in on this device</label>
                                    </div>
                                </div>

                                <!-- Submit Button -->
                                <button type="submit" class="btn btn-electric w-100 py-2">
                                    Sign In to Vault
                                </button>
                            </form>

                            <!-- Footer Link -->
                            <div class="text-center mt-4 pt-3 border-top" style="border-color: var(--pc-border-hairline) !important;">
                                <p class="small text-muted mb-0">
                                    New to ProductCare?
                                    <a asp-action="Register" class="fw-semibold text-electric-teal">Open your Ownership Desk &rarr;</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
