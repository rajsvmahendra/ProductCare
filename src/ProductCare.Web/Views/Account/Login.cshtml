@model ProductCare.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In — ProductCare";
}

<div class="pc-auth-desk">
    <!-- Ambient Green & Sage Refraction Blobs -->
    <div class="pc-auth-blob pc-auth-blob-1"></div>
    <div class="pc-auth-blob pc-auth-blob-2"></div>

    <!-- Master Sliding Glass Auth Card -->
    <div class="auth-card" id="authCard">
        <div class="auth-top-rim"></div>

        <!-- 1. Sign In Form Panel (Left Panel in Default State) -->
        <div class="auth-form-wrapper sign-in-box">
            <span class="pc-auth-badge stagger-item" style="--i: 1;">
                Verified Access
            </span>
            <h2 class="stagger-item" style="--i: 1;">Sign in to ProductCare</h2>
            <p class="subtext stagger-item" style="--i: 2;">Enter your credentials to access your device records and tickets.</p>

            <form asp-action="Login" asp-controller="Account" method="post" id="loginForm" class="w-100">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 stagger-item" style="--i: 2; background-color: #FEF2F2; border-color: #FECACA; color: #991B1B;" role="alert"></div>

                <!-- Email Address -->
                <div class="auth-field-box stagger-item" style="--i: 3;">
                    <input asp-for="Email" type="email" id="emailInput" class="auth-input-inner" placeholder="Enter your registered email" autocomplete="email" required autofocus />
                    <span class="auth-field-icon"><i class="bi bi-envelope"></i></span>
                    <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                </div>

                <!-- Password with interactive visibility toggle -->
                <div class="auth-field-box stagger-item" style="--i: 4;">
                    <input asp-for="Password" type="password" id="loginPassword" class="auth-input-inner password-field" placeholder="Enter your password" autocomplete="current-password" required />
                    <span class="auth-field-icon"><i class="bi bi-lock"></i></span>
                    <button type="button" class="auth-pwd-toggle pc-toggle-password pwd-toggle-btn" data-target="loginPassword" aria-label="Show password" title="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                    <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                </div>

                <!-- Remember Me & Forgot Password -->
                <div class="auth-meta-actions stagger-item" style="--i: 4;">
                    <label class="auth-remember-label">
                        <input asp-for="RememberMe" id="rememberMeCheck" />
                        <span>Remember me</span>
                    </label>
                    <a href="#" class="auth-forgot-link" onclick="alert('Password reset instructions will be dispatched to your registered email.'); return false;">Forgot password?</a>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-auth-action stagger-item" style="--i: 5;" id="loginSubmitBtn">
                    <span>Sign in</span>
                    <i class="bi bi-arrow-right"></i>
                </button>

                <!-- Mobile Switch Link -->
                <div class="auth-mobile-switch">
                    Don't have an account? <button type="button" class="btn btn-link text-forest fw-semibold p-0 text-decoration-none pc-switch-register">Get started</button>
                </div>
            </form>
        </div>

        <!-- 2. Registration Form Panel (Revealed on Slide) -->
        <div class="auth-form-wrapper sign-up-box">
            <span class="pc-auth-badge stagger-item" style="--i: 1;">
                Get Started
            </span>
            <h2 class="stagger-item" style="--i: 1;">Create your account</h2>
            <p class="subtext stagger-item" style="--i: 2;">Register to track warranties, invoices, and service requests.</p>

            <form asp-action="Register" asp-controller="Account" method="post" id="registerForm" class="w-100">
                @Html.AntiForgeryToken()

                <div id="regClientError" class="alert alert-danger py-2 small mb-3 d-none stagger-item" style="--i: 2; background-color: #FEF2F2; border-color: #FECACA; color: #991B1B;" role="alert"></div>

                <!-- Full Name -->
                <div class="auth-field-box stagger-item" style="--i: 3;">
                    <input name="FullName" type="text" id="regFullName" class="auth-input-inner" placeholder="Enter your full name" autocomplete="name" required />
                    <span class="auth-field-icon"><i class="bi bi-person"></i></span>
                </div>

                <!-- Email Address -->
                <div class="auth-field-box stagger-item" style="--i: 4;">
                    <input name="Email" type="email" id="regEmail" class="auth-input-inner" placeholder="Enter your email address" autocomplete="email" required />
                    <span class="auth-field-icon"><i class="bi bi-envelope"></i></span>
                </div>

                <!-- Password with interactive visibility toggle -->
                <div class="auth-field-box stagger-item" style="--i: 5;">
                    <input name="Password" type="password" id="regPassword" class="auth-input-inner password-field" placeholder="Create password (min 6 chars)" autocomplete="new-password" required />
                    <span class="auth-field-icon"><i class="bi bi-lock"></i></span>
                    <button type="button" class="auth-pwd-toggle pc-toggle-password pwd-toggle-btn" data-target="regPassword" aria-label="Show password" title="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <!-- Confirm Password with interactive visibility toggle -->
                <div class="auth-field-box stagger-item" style="--i: 6;">
                    <input name="ConfirmPassword" type="password" id="regConfirmPassword" class="auth-input-inner password-field" placeholder="Confirm your password" autocomplete="new-password" required />
                    <span class="auth-field-icon"><i class="bi bi-shield-check"></i></span>
                    <button type="button" class="auth-pwd-toggle pc-toggle-password pwd-toggle-btn" data-target="regConfirmPassword" aria-label="Show password" title="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <!-- Terms & Privacy -->
                <div class="auth-meta-actions stagger-item" style="--i: 6;">
                    <label class="auth-remember-label">
                        <input type="checkbox" id="termsCheck" required />
                        <span style="font-size: 11.5px;">Agree to <a asp-controller="Home" asp-action="Privacy" class="text-forest text-decoration-none">Terms &amp; Privacy</a></span>
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-auth-action stagger-item" style="--i: 7;" id="registerSubmitBtn">
                    <span>Create account</span>
                    <i class="bi bi-arrow-right"></i>
                </button>

                <!-- Mobile Switch Link -->
                <div class="auth-mobile-switch">
                    Already have an account? <button type="button" class="btn btn-link text-forest fw-semibold p-0 text-decoration-none pc-switch-login">Sign in</button>
                </div>
            </form>
        </div>

        <!-- 3. Sliding Liquid Glass Welcome Curtain -->
        <div class="curtain-shell">
            <div class="curtain-body">
                <!-- Left View (Visible in Registration Mode) -->
                <div class="curtain-view view-left">
                    <h2>Welcome to ProductCare!</h2>
                    <p>Create your account to register products and keep track of their warranty.</p>
                    <button class="btn-auth-ghost" id="signInTrigger" type="button">Sign in</button>
                </div>

                <!-- Right View (Visible in Default Sign In Mode) -->
                <div class="curtain-view view-right">
                    <h2>Hello again!</h2>
                    <p>Your products, warranties and service requests are waiting for you.</p>
                    <button class="btn-auth-ghost" id="signUpTrigger" type="button">Get started</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const card = document.getElementById('authCard');
            if (!card) return;

            const signUpTrigger = document.getElementById('signUpTrigger');
            const signInTrigger = document.getElementById('signInTrigger');
            const mobileRegisterTriggers = document.querySelectorAll('.pc-switch-register, .pc-mobile-switch-to-register');
            const mobileLoginTriggers = document.querySelectorAll('.pc-switch-login, .pc-mobile-switch-to-login');

            function switchToRegister() {
                card.classList.add('active');
                if (window.history && window.history.pushState) {
                    window.history.pushState(null, '', '/Account/Register');
                }
                document.title = "Create Account — ProductCare";
            }

            function switchToLogin() {
                card.classList.remove('active');
                if (window.history && window.history.pushState) {
                    window.history.pushState(null, '', '/Account/Login');
                }
                document.title = "Sign In — ProductCare";
            }

            if (signUpTrigger) {
                signUpTrigger.addEventListener('click', function (e) {
                    e.preventDefault();
                    switchToRegister();
                });
            }

            if (signInTrigger) {
                signInTrigger.addEventListener('click', function (e) {
                    e.preventDefault();
                    switchToLogin();
                });
            }

            mobileRegisterTriggers.forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    switchToRegister();
                });
            });

            mobileLoginTriggers.forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    switchToLogin();
                });
            });

            // Client-side validation for embedded registration form
            const regForm = document.getElementById('registerForm');
            if (regForm) {
                regForm.addEventListener('submit', function (e) {
                    const errBox = document.getElementById('regClientError');
                    const fullName = document.getElementById('regFullName')?.value?.trim() || '';
                    const email = document.getElementById('regEmail')?.value?.trim() || '';
                    const pwd = document.getElementById('regPassword')?.value || '';
                    const confirmPwd = document.getElementById('regConfirmPassword')?.value || '';
                    const terms = document.getElementById('termsCheck')?.checked;

                    if (!fullName || !email) {
                        e.preventDefault();
                        if (errBox) {
                            errBox.textContent = 'Please fill in all required fields.';
                            errBox.classList.remove('d-none');
                        }
                        return false;
                    }
                    if (pwd.length < 6) {
                        e.preventDefault();
                        if (errBox) {
                            errBox.textContent = 'Password must be at least 6 characters long.';
                            errBox.classList.remove('d-none');
                        }
                        return false;
                    }
                    if (pwd !== confirmPwd) {
                        e.preventDefault();
                        if (errBox) {
                            errBox.textContent = 'The password and confirmation password do not match.';
                            errBox.classList.remove('d-none');
                        }
                        return false;
                    }
                    if (!terms) {
                        e.preventDefault();
                        if (errBox) {
                            errBox.textContent = 'You must agree to the Terms & Privacy policy.';
                            errBox.classList.remove('d-none');
                        }
                        return false;
                    }
                    if (errBox) {
                        errBox.classList.add('d-none');
                    }
                });
            }

            // Check URL query param or hash for immediate switch
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('mode') === 'register' || window.location.hash === '#register') {
                switchToRegister();
            }

            window.addEventListener('popstate', function () {
                if (window.location.pathname.toLowerCase().includes('register')) {
                    card.classList.add('active');
                    document.title = "Create Account — ProductCare";
                } else {
                    card.classList.remove('active');
                    document.title = "Sign In — ProductCare";
                }
            });
        });
    </script>
}
