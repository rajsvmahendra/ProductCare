@model ProductCare.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="pc-auth-split">
    <!-- Left Branded Story & Reassurance Panel -->
    <div class="pc-auth-story">
        <div>
            <a class="pc-logo is-light mb-5" asp-area="" asp-controller="Home" asp-action="Index">
                <svg class="pc-logo-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect width="32" height="32" rx="8" fill="rgba(255,255,255,0.12)" />
                    <path d="M16 6L8 9.5V16C8 21 11.5 25.5 16 27C20.5 25.5 24 21 24 16V9.5L16 6Z" stroke="#9DA8FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M12 16.5L15 19.5L20.5 13.5" stroke="#12A89A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="pc-logo-text">Product<span style="color: #9DA8FF;">Care</span></span>
            </a>

            <div class="max-w-400 mt-4">
                <span class="pc-badge pc-badge-primary mb-3">SECURE PORTAL ACCESS</span>
                <h2 class="display-6 fw-bold text-white mb-3">Welcome back to your product vault.</h2>
                <p class="text-white-50">
                    Sign in to monitor your active warranties, inspect service tickets, and manage product documentation with zero friction.
                </p>
            </div>
        </div>

        <!-- Mini Visual Status Card -->
        <div class="p-3 rounded-4 mt-4" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.12);">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span class="pc-badge pc-badge-success">Encrypted</span>
                    <span class="text-white small fw-medium">PBKDF2 Password Hashing</span>
                </div>
                <i class="bi bi-shield-lock text-white-50"></i>
            </div>
        </div>

        <div class="small text-white-50 mt-4">
            &copy; 2026 ProductCare &middot; Academic Capstone Project
        </div>
    </div>

    <!-- Right Form Canvas -->
    <div class="pc-auth-canvas">
        <div class="pc-auth-form-card">
            <div class="mb-4">
                <h3 class="fw-bold text-ink mb-1 font-heading">Sign in to ProductCare</h3>
                <p class="text-muted small mb-0">Enter your credentials to access your dashboard.</p>
            </div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" autocomplete="email" required autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- Password with Show/Hide Toggle -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group">
                        <input asp-for="Password" type="password" id="loginPassword" class="form-control" placeholder="Enter your password" autocomplete="current-password" required />
                        <button type="button" class="btn-password-toggle" data-target="loginPassword" aria-label="Toggle password visibility">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <!-- Remember Me -->
                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                    <label asp-for="RememberMe" class="form-check-label text-muted small" for="rememberMeCheck">
                        Keep me signed in on this browser
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-pc-primary w-100 mb-3">
                    <span>Sign In</span>
                    <i class="bi bi-box-arrow-in-right"></i>
                </button>

                <div class="text-center small text-muted">
                    Don't have an account? 
                    <a asp-action="Register" class="text-primary-pc fw-semibold">Register as Customer</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
