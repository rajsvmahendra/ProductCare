@model ProductCare.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In — The Ownership Desk";
}

<div class="pc-auth-desk">
    <div class="pc-auth-card">
        <!-- Editorial Header -->
        <div class="text-center mb-4">
            <span class="d-inline-block text-uppercase fw-bold small text-muted mb-1" style="letter-spacing: 0.08em; font-size: 0.75rem;">THE OWNERSHIP DESK</span>
            <h2 class="font-serif text-dark mb-1" style="font-size: 1.85rem; font-weight: 500;">Welcome back.</h2>
            <p class="text-muted small mb-0">Your records are right where you left them.</p>
        </div>

        <!-- Document Record Vignette -->
        <div class="pc-ownership-vignette">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="pc-vignette-label">OWNERSHIP VAULT &middot; ACTIVE RECORD</span>
                <span class="pc-badge pc-badge-active" style="font-size: 9px; padding: 2px 7px;">PROTECTED</span>
            </div>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="fw-semibold text-dark small">ThinkPad X1 Carbon Gen 11</div>
                    <div class="text-muted" style="font-size: 11px;">S/N: PF-4A92K1 &middot; Active Warranty</div>
                </div>
                <div class="text-end">
                    <div class="fw-semibold text-dark tabular-nums small">426 Days Remaining</div>
                    <div class="text-muted" style="font-size: 11px;">Proof: Verified PDF</div>
                </div>
            </div>
        </div>

        <!-- Login Form -->
        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

            <!-- Email Address -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" autocomplete="email" required autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <!-- Password with Show/Hide Reveal Button -->
            <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between">
                    <label asp-for="Password" class="form-label mb-0">Password</label>
                </div>
                <div class="input-group mt-1">
                    <input asp-for="Password" type="password" id="loginPassword" class="form-control" placeholder="Enter your account password" autocomplete="current-password" required />
                    <button type="button" class="btn btn-stone pc-toggle-password" data-target="loginPassword" aria-label="Toggle password visibility">
                        <svg class="pc-eye-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <svg class="pc-eye-slash" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <!-- Remember Me -->
            <div class="mb-4 d-flex align-items-center justify-content-between">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                    <label class="form-check-label small text-muted" for="rememberMeCheck">Keep me signed in on this computer</label>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-forest w-100 py-2">
                Sign In to Vault
            </button>
        </form>

        <!-- Footer Link -->
        <div class="text-center mt-4 pt-3 border-top" style="border-color: var(--pc-stone) !important;">
            <p class="small text-muted mb-0">
                New to ProductCare?
                <a asp-action="Register" class="fw-semibold text-forest">Open your Ownership Desk &rarr;</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
