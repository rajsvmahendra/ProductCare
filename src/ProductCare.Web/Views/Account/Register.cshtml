@model ProductCare.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Customer Registration";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-5">
        <div class="card pc-card border-0 shadow-sm">
            <div class="card-header bg-white text-center py-4 border-bottom">
                <div class="d-inline-flex p-3 rounded-circle bg-primary-subtle text-primary mb-2">
                    <i class="bi bi-person-plus-fill fs-3"></i>
                </div>
                <h4 class="fw-bold mb-1">Create Customer Account</h4>
                <p class="text-muted small mb-0">Register your products and manage warranties in one place</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control" placeholder="Min. 6 chars" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold">Street Address <span class="text-muted fw-normal">(Optional)</span></label>
                        <input asp-for="Address" class="form-control" placeholder="e.g. 123 Main Street" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-sm-6">
                            <label asp-for="City" class="form-label fw-semibold">City <span class="text-muted fw-normal">(Optional)</span></label>
                            <input asp-for="City" class="form-control" placeholder="City" />
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="PostalCode" class="form-label fw-semibold">Postal Code <span class="text-muted fw-normal">(Optional)</span></label>
                            <input asp-for="PostalCode" class="form-control" placeholder="Postal Code" />
                        </div>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-person-check me-2"></i> Register Account
                        </button>
                    </div>

                    <div class="text-center text-muted small">
                        Already have an account? <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">Sign In</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
