@model ProductCare.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="pc-auth-split">
    <!-- Left Branded Story & Reassurance Panel -->
    <div class="pc-auth-story">
        <div>
            <a class="pc-logo is-light mb-5" asp-area="" asp-controller="Home" asp-action="Index">
                <svg class="pc-logo-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect width="32" height="32" rx="8" fill="rgba(255,255,255,0.12)" />
                    <path d="M16 6L8 9.5V16C8 21 11.5 25.5 16 27C20.5 25.5 24 21 24 16V9.5L16 6Z" stroke="#9DA8FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M12 16.5L15 19.5L20.5 13.5" stroke="#12A89A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="pc-logo-text">Product<span style="color: #9DA8FF;">Care</span></span>
            </a>

            <div class="max-w-400 mt-4">
                <span class="pc-badge pc-badge-primary mb-3">CUSTOMER ONBOARDING</span>
                <h2 class="display-6 fw-bold text-white mb-3">One calm place for everything you own.</h2>
                <p class="text-white-50">
                    Register in seconds to organize your product warranties, store proof of purchase safely, and request repairs with full transparency.
                </p>
            </div>
        </div>

        <!-- Mini Visual Preview Card -->
        <div class="p-3 rounded-4 mt-4" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.12);">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2 bg-white text-primary-pc">
                    <i class="bi bi-shield-check fs-4"></i>
                </div>
                <div>
                    <div class="text-white fw-bold small">Instant Protection Vault</div>
                    <div class="text-white-50" style="font-size: 11.5px;">Automated warranty tracking & 30-day alerts</div>
                </div>
            </div>
        </div>

        <div class="small text-white-50 mt-4">
            &copy; 2026 ProductCare &middot; Academic Capstone Project
        </div>
    </div>

    <!-- Right Form Canvas -->
    <div class="pc-auth-canvas">
        <div class="pc-auth-form-card">
            <div class="mb-4">
                <h3 class="fw-bold text-ink mb-1 font-heading">Create your account</h3>
                <p class="text-muted small mb-0">Get started with your personal product warranty vault.</p>
            </div>

            <form asp-action="Register" method="post" id="registerForm">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                <!-- Full Name -->
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. Alex Morgan" autocomplete="name" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" autocomplete="email" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- Password and Confirm Password -->
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-group">
                            <input asp-for="Password" type="password" id="regPassword" class="form-control" placeholder="Min. 6 chars" autocomplete="new-password" required />
                            <button type="button" class="btn-password-toggle" data-target="regPassword" aria-label="Toggle password visibility">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" type="password" id="regConfirmPassword" class="form-control" placeholder="Re-enter password" autocomplete="new-password" required />
                            <button type="button" class="btn-password-toggle" data-target="regConfirmPassword" aria-label="Toggle password visibility">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Optional Contact Details Accordion -->
                <div class="mb-4">
                    <a class="text-muted small text-decoration-none d-inline-flex align-items-center gap-1" data-bs-toggle="collapse" href="#optionalContact" role="button" aria-expanded="false">
                        <i class="bi bi-plus-circle"></i> Add physical address <span class="text-muted fw-normal">(Optional)</span>
                    </a>
                    <div class="collapse mt-3" id="optionalContact">
                        <div class="mb-2">
                            <label asp-for="Address" class="form-label small text-muted">Street Address</label>
                            <input asp-for="Address" class="form-control form-control-sm" placeholder="e.g. 123 Innovation Way" />
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label asp-for="City" class="form-label small text-muted">City</label>
                                <input asp-for="City" class="form-control form-control-sm" placeholder="City" />
                            </div>
                            <div class="col-6">
                                <label asp-for="PostalCode" class="form-label small text-muted">Postal Code</label>
                                <input asp-for="PostalCode" class="form-control form-control-sm" placeholder="Postal Code" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-pc-primary w-100 mb-3">
                    <span>Create Account</span>
                    <i class="bi bi-arrow-right"></i>
                </button>

                <div class="text-center small text-muted">
                    Already have an account? 
                    <a asp-action="Login" class="text-primary-pc fw-semibold">Sign In</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
