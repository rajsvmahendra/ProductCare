@{
    ViewData["Title"] = "Access Restricted";
}

<div class="container-xl px-3 px-md-4 py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5 text-center">
            <div class="pc-capability-card p-5">
                <div class="d-inline-flex p-3 rounded-circle mb-3" style="background-color: rgba(255, 107, 107, 0.12); color: var(--pc-coral-red); border: 1px solid rgba(255, 107, 107, 0.25);">
                    <i class="bi bi-shield-lock fs-1"></i>
                </div>
                <h2 class="font-display text-light mb-2" style="font-size: 1.75rem;">Access Restricted</h2>
                <p class="text-muted small mb-4">
                    Your authenticated account does not possess the required clearance to access this restricted workspace.
                </p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-midnight btn-sm">
                        <i class="bi bi-house me-1"></i> Public Website
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (User.IsInRole("Admin"))
                        {
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-electric btn-sm">
                                <i class="bi bi-speedometer2 me-1"></i> Administrator Portal
                            </a>
                        }
                        else
                        {
                            <a asp-area="Customer" asp-controller="Dashboard" asp-action="Index" class="btn btn-electric btn-sm">
                                <i class="bi bi-folder-check me-1"></i> My Product Vault
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
