@{
    ViewData["Title"] = "ProductCare — Product Warranty & Service Management";
}

<!-- =========================================================================
     1. PRODUCT HERO SECTION WITH 3D INTERACTIVE SOFTWARE MOCKUP
     ========================================================================= -->
<section class="pc-hero-section">
    <div class="container-xl px-3 px-md-4">
        <div class="row align-items-center g-5">
            <!-- Left Hero Content -->
            <div class="col-lg-6">
                <div class="pc-eyebrow">
                    <i class="bi bi-shield-check"></i> PRODUCT RECORDS &middot; WARRANTY &middot; SERVICE
                </div>
                <h1 class="pc-hero-h1">
                    Know what’s covered. <br />
                    <span class="text-primary-pc">Stay ahead</span> of what’s next.
                </h1>
                <p class="pc-hero-lead">
                    Keep every product, warranty and service request organised in one calm, easy-to-use place. Add a purchase once, see your coverage at a glance, and follow repairs without losing the details.
                </p>

                <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="btn-pc-primary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <span>Open Admin Portal</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                        else
                        {
                            <a class="btn-pc-primary" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
                                <span>Go to My Dashboard</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                    }
                    else
                    {
                        <a class="btn-pc-primary" asp-area="" asp-controller="Account" asp-action="Register">
                            <span>Create your account</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                        <a class="btn-pc-secondary" href="#how-it-works">
                            <i class="bi bi-play-circle me-1 text-primary-pc"></i>
                            <span>See how it works</span>
                        </a>
                    }
                </div>

                <div class="d-flex align-items-center gap-4 text-muted small pt-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check2-circle text-teal-pc fs-5"></i>
                        <span>Zero subscription fees</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check2-circle text-teal-pc fs-5"></i>
                        <span>Private invoice storage</span>
                    </div>
                </div>
            </div>

            <!-- Right Hero 3D Dimensional Mockup -->
            <div class="col-lg-6">
                <div class="pc-mockup-stage">
                    <!-- Floating Badge Top -->
                    <div class="pc-floating-chip pc-chip-top">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; background: #E5F7F4; color: #12A89A;">
                            <i class="bi bi-shield-fill-check"></i>
                        </div>
                        <div>
                            <div class="text-ink fw-bold" style="font-size: 12px; line-height: 1.2;">Active Coverage</div>
                            <div class="text-muted" style="font-size: 11px;">Verified Warranty Proof</div>
                        </div>
                    </div>

                    <!-- Main Dimensional Window -->
                    <div class="pc-mockup-window">
                        <!-- Window Titlebar -->
                        <div class="pc-mockup-header">
                            <div class="pc-window-dots">
                                <span class="pc-window-dot dot-red"></span>
                                <span class="pc-window-dot dot-yellow"></span>
                                <span class="pc-window-dot dot-green"></span>
                            </div>
                            <div class="small fw-semibold text-muted d-flex align-items-center gap-1">
                                <i class="bi bi-lock-fill text-muted" style="font-size: 11px;"></i>
                                productcare.portal/customer/overview
                            </div>
                            <span class="badge bg-light text-muted border" style="font-size: 10px;">SAMPLE PREVIEW</span>
                        </div>

                        <!-- Mockup Interior -->
                        <div class="pc-mockup-body">
                            <!-- Coverage Header Card -->
                            <div class="d-flex align-items-center justify-content-between p-3 rounded-3 mb-3" style="background: #F8F9FE; border: 1px solid #E8ECF8;">
                                <div>
                                    <div class="text-muted small fw-medium">Coverage Health</div>
                                    <div class="h5 fw-bold text-ink mb-0">8 Products Monitored</div>
                                </div>
                                <div class="text-end">
                                    <span class="pc-badge pc-badge-success mb-1">7 Active</span>
                                    <div class="small text-muted">1 Expiring in 18d</div>
                                </div>
                            </div>

                            <!-- Showcase Product Item -->
                            <div class="p-3 rounded-3 mb-3 bg-white border">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: #EEF0FF; color: #4F5FEA;">
                                            <i class="bi bi-laptop fs-4"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-ink">MacBook Pro 16" M3 Max</div>
                                            <div class="small text-muted">Apple &middot; Serial: C02G1234MD6R</div>
                                        </div>
                                    </div>
                                    <span class="pc-badge pc-badge-success">Active</span>
                                </div>
                                <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center small">
                                    <span class="text-muted"><i class="bi bi-calendar3 me-1"></i> Valid until Dec 14, 2027</span>
                                    <span class="fw-bold text-primary-pc">248 days remaining</span>
                                </div>
                            </div>

                            <!-- Mockup Sub-item: Service Ticket In-Progress -->
                            <div class="p-3 rounded-3 bg-white border">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="pc-badge pc-badge-primary">PC-202611-0421</span>
                                        <span class="small fw-semibold text-ink">Display Calibration</span>
                                    </div>
                                    <span class="pc-badge pc-badge-info">In Progress</span>
                                </div>
                                <div class="small text-muted mt-1">
                                    Assigned to Senior Technician &middot; Diagnostic check passed
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Floating Badge Bottom -->
                    <div class="pc-floating-chip pc-chip-bottom">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; background: #EEF0FF; color: #4F5FEA;">
                            <i class="bi bi-arrow-repeat"></i>
                        </div>
                        <div>
                            <div class="text-ink fw-bold" style="font-size: 12px; line-height: 1.2;">Live Service Triage</div>
                            <div class="text-muted" style="font-size: 11px;">8-Stage Workflow Engine</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     2. SECTION A: THE EVERYDAY PROBLEM & VISUAL CONTRAST
     ========================================================================= -->
<section id="problem" class="py-5 bg-white border-top border-bottom">
    <div class="container-xl px-3 px-md-4 py-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="pc-eyebrow">THE EVERYDAY CHALLENGE</span>
            <h2 class="display-6 fw-bold text-ink mb-3">Purchase details shouldn’t disappear into a drawer.</h2>
            <p class="text-muted lead">
                When consumer electronics malfunction, tracking warranty deadlines and proving purchase history shouldn't require searching through shoeboxes and lost emails.
            </p>
        </div>

        <div class="row g-4 align-items-stretch">
            <!-- Problem: The Old Way -->
            <div class="col-md-6">
                <div class="p-4 p-lg-5 rounded-4 h-100 border" style="background: #FFFBFB; border-color: #F8D7DA !important;">
                    <div class="d-flex align-items-center gap-2 text-danger fw-bold mb-3 small text-uppercase letter-spacing-1">
                        <i class="bi bi-x-circle-fill fs-5"></i> The Scattered Reality
                    </div>
                    <h3 class="h4 fw-bold text-ink mb-3">Losing track of warranties costs time and money</h3>
                    <ul class="list-unstyled d-flex flex-column gap-3 text-muted mb-0">
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-dash text-danger fs-5"></i>
                            <span>Thermal paper receipts fade to blank within months, voiding claim eligibility.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-dash text-danger fs-5"></i>
                            <span>Warranty deadlines expire unnoticed with no early heads-up or visibility.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-dash text-danger fs-5"></i>
                            <span>Repair requests lack structure, leaving customers guessing what stage service is in.</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Solution: The ProductCare Way -->
            <div class="col-md-6">
                <div class="p-4 p-lg-5 rounded-4 h-100 border" style="background: #F6FBF9; border-color: #D1E7DD !important;">
                    <div class="d-flex align-items-center gap-2 text-success fw-bold mb-3 small text-uppercase letter-spacing-1">
                        <i class="bi bi-check-circle-fill fs-5"></i> The ProductCare Solution
                    </div>
                    <h3 class="h4 fw-bold text-ink mb-3">Centralized, calm, and always accessible</h3>
                    <ul class="list-unstyled d-flex flex-column gap-3 text-muted mb-0">
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-check2 text-success fs-5"></i>
                            <span>Store digital copies of purchase invoices safely in your private digital vault.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-check2 text-success fs-5"></i>
                            <span>Dynamic calculations highlight upcoming expirations 30 days before they lapse.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-check2 text-success fs-5"></i>
                            <span>Raise service tickets in seconds and follow transparent milestone updates.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     3. SECTION B: THREE-STEP WORKFLOW
     ========================================================================= -->
<section id="how-it-works" class="py-5">
    <div class="container-xl px-3 px-md-4 py-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="pc-eyebrow">SIMPLE 3-STEP JOURNEY</span>
            <h2 class="display-6 fw-bold text-ink mb-3">How ProductCare works for you</h2>
            <p class="text-muted">A clear, reassuring workflow designed to keep your home and office technology covered.</p>
        </div>

        <div class="row g-4">
            <!-- Step 1 -->
            <div class="col-md-4">
                <div class="pc-card h-100 p-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: #EEF0FF; color: #4F5FEA;">
                            <i class="bi bi-plus-square-fill fs-4"></i>
                        </div>
                        <span class="display-6 fw-bold text-muted opacity-25">01</span>
                    </div>
                    <h3 class="h5 fw-bold text-ink mb-2">1. Add what you own</h3>
                    <p class="text-muted small mb-0">
                        Record the brand, model, purchase date, and unique serial number. Optionally attach a PDF or image of your receipt for safe keeping.
                    </p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="col-md-4">
                <div class="pc-card h-100 p-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: #E5F7F4; color: #12A89A;">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                        <span class="display-6 fw-bold text-muted opacity-25">02</span>
                    </div>
                    <h3 class="h5 fw-bold text-ink mb-2">2. Know your coverage</h3>
                    <p class="text-muted small mb-0">
                        ProductCare automatically computes exact expiration dates and days remaining. Status badges alert you when warranties are approaching deadline.
                    </p>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="col-md-4">
                <div class="pc-card h-100 p-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: #FFF4DD; color: #B7791F;">
                            <i class="bi bi-tools fs-4"></i>
                        </div>
                        <span class="display-6 fw-bold text-muted opacity-25">03</span>
                    </div>
                    <h3 class="h5 fw-bold text-ink mb-2">3. Follow service requests</h3>
                    <p class="text-muted small mb-0">
                        If a device breaks, submit a repair ticket directly against its record. Monitor diagnostic milestones from submission to full resolution.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     4. SECTION C: ASYMMETRICAL FEATURE BENTO GRID
     ========================================================================= -->
<section id="features" class="py-5 bg-white border-top border-bottom">
    <div class="container-xl px-3 px-md-4 py-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="pc-eyebrow">CAPABILITY SHOWCASE</span>
            <h2 class="display-6 fw-bold text-ink mb-3">Designed for clarity and total control</h2>
            <p class="text-muted">A purposeful suite of tools engineered to make product ownership painless.</p>
        </div>

        <div class="pc-bento-grid">
            <!-- Bento Panel 1: Product Library (Span 8) -->
            <div class="pc-bento-card col-span-8">
                <div>
                    <span class="pc-badge pc-badge-primary mb-3">DIGITAL PRODUCT SHELF</span>
                    <h3 class="h4 fw-bold text-ink mb-2">Centralized Digital Product Shelf</h3>
                    <p class="text-muted">
                        Maintain a clean, searchable registry of every laptop, television, smartphone, and appliance you own. Instant lookup by serial number or category.
                    </p>
                </div>
                <!-- Mini UI Illustration -->
                <div class="pc-mini-ui">
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <div class="p-2 bg-white rounded-3 border d-flex align-items-center gap-2">
                                <i class="bi bi-display text-primary-pc fs-4"></i>
                                <div>
                                    <div class="fw-bold small text-ink">LG OLED 65" C3</div>
                                    <div class="text-muted" style="font-size: 11px;">S/N: 304INBGT1824</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-2 bg-white rounded-3 border d-flex align-items-center gap-2">
                                <i class="bi bi-headphones text-teal-pc fs-4"></i>
                                <div>
                                    <div class="fw-bold small text-ink">Sony WH-1000XM5</div>
                                    <div class="text-muted" style="font-size: 11px;">S/N: 7291048821</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bento Panel 2: Warranty Intelligence (Span 4) -->
            <div class="pc-bento-card col-span-4">
                <div>
                    <span class="pc-badge pc-badge-warning mb-3">INTELLIGENT TIMING</span>
                    <h3 class="h4 fw-bold text-ink mb-2">Warranty Expiration Engine</h3>
                    <p class="text-muted">
                        No manual math required. View dynamic days-remaining counters and timely 30-day early warnings.
                    </p>
                </div>
                <!-- Mini UI Gauge -->
                <div class="pc-mini-ui text-center p-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2" style="width: 72px; height: 72px; background: #E5F7F4; border: 4px solid #12A89A;">
                        <span class="fw-bold text-teal-pc fs-5">78%</span>
                    </div>
                    <div class="small fw-semibold text-ink">Overall Fleet Health</div>
                    <div class="text-muted" style="font-size: 11px;">7 of 8 products under warranty</div>
                </div>
            </div>

            <!-- Bento Panel 3: Governed Service (Span 4) -->
            <div class="pc-bento-card col-span-4">
                <div>
                    <span class="pc-badge pc-badge-info mb-3">WORKFLOW ENGINE</span>
                    <h3 class="h4 fw-bold text-ink mb-2">Governed Repair Workflow</h3>
                    <p class="text-muted">
                        Every ticket progresses through an 8-stage state machine with transparent diagnostic updates.
                    </p>
                </div>
                <!-- Mini Stepper UI -->
                <div class="pc-mini-ui">
                    <div class="d-flex flex-column gap-2 small">
                        <div class="d-flex align-items-center gap-2 text-success fw-semibold">
                            <i class="bi bi-check-circle-fill"></i> 1. Submitted
                        </div>
                        <div class="d-flex align-items-center gap-2 text-success fw-semibold">
                            <i class="bi bi-check-circle-fill"></i> 2. Under Review
                        </div>
                        <div class="d-flex align-items-center gap-2 text-primary fw-bold">
                            <i class="bi bi-arrow-right-circle-fill"></i> 3. In Progress
                        </div>
                        <div class="d-flex align-items-center gap-2 text-muted">
                            <i class="bi bi-circle"></i> 4. Resolved
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bento Panel 4: Protected Records (Span 8, Deep Navy) -->
            <div class="pc-bento-card col-span-8 bento-dark">
                <div>
                    <span class="pc-badge pc-badge-primary mb-3">DEFENSE IN DEPTH</span>
                    <h3 class="h4 fw-bold text-white mb-2">Protected Records & Private Invoice Vault</h3>
                    <p class="text-muted">
                        Invoices are saved outside public directories with MIME and signature inspection. Customer records enforce strict server-side account ownership checks.
                    </p>
                </div>
                <!-- Mini Security Audit UI -->
                <div class="pc-mini-ui">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 text-white small">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock-fill text-teal-pc fs-5"></i>
                            <span>Magic-byte verified PDF & Image storage</span>
                        </div>
                        <span class="badge bg-light text-dark">Strict Ownership Check</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     5. SECTION D: SERVICE JOURNEY VISUAL
     ========================================================================= -->
<section id="journey" class="py-5">
    <div class="container-xl px-3 px-md-4 py-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="pc-eyebrow">END-TO-END VISIBILITY</span>
            <h2 class="display-6 fw-bold text-ink mb-3">Follow every service step in real time</h2>
            <p class="text-muted">Every service ticket follows a transparent, immutable progression from report to repair.</p>
        </div>

        <div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm">
            <div class="row g-4 text-center">
                <div class="col-6 col-md-3">
                    <div class="p-3 rounded-3 bg-light mb-2">
                        <i class="bi bi-send-fill text-primary-pc fs-3"></i>
                    </div>
                    <div class="fw-bold text-ink">1. Submitted</div>
                    <div class="small text-muted">Ticket generated with format PC-YYYYMMDD-XXXX</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 rounded-3 bg-light mb-2">
                        <i class="bi bi-clipboard-check-fill text-teal-pc fs-3"></i>
                    </div>
                    <div class="fw-bold text-ink">2. Under Review</div>
                    <div class="small text-muted">Administrator evaluates warranty claim</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 rounded-3 bg-light mb-2">
                        <i class="bi bi-gear-wide-connected text-warning fs-3"></i>
                    </div>
                    <div class="fw-bold text-ink">3. In Progress</div>
                    <div class="small text-muted">Technician assigned with diagnostic remarks</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 rounded-3 bg-light mb-2">
                        <i class="bi bi-check-circle-fill text-success fs-3"></i>
                    </div>
                    <div class="fw-bold text-ink">4. Resolved</div>
                    <div class="small text-muted">Final repair verified and customer notified</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     6. SECTION E: TRUST & CONTROL
     ========================================================================= -->
<section id="trust" class="py-5 bg-white border-top">
    <div class="container-xl px-3 px-md-4 py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="pc-eyebrow">TRUSTED ARCHITECTURE</span>
                <h2 class="display-6 fw-bold text-ink mb-3">Your records remain private, verified, and protected.</h2>
                <p class="text-muted mb-4">
                    ProductCare is engineered with defense-in-depth principles. Every customer query is bounded by authenticated user identity, ensuring no account can view or alter another customer's products or service records.
                </p>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle p-2 bg-primary-soft text-primary-pc mt-1">
                            <i class="bi bi-shield-check fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-ink">Isolated Customer Boundary</div>
                            <div class="small text-muted">Queries strictly enforce owner ID matching to eliminate unauthorized access.</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle p-2 bg-teal-soft text-teal-pc mt-1">
                            <i class="bi bi-file-earmark-lock fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-ink">Secure Streaming Downloads</div>
                            <div class="small text-muted">Receipts are served via authorized byte streams, keeping upload folders hidden from direct URL probing.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="p-4 p-lg-5 rounded-4 bg-light border">
                    <h3 class="h5 fw-bold text-ink mb-3">Academic Project Credentials</h3>
                    <p class="small text-muted mb-3">
                        Developed as a complete capstone submission for course <strong>INT402: Modern Web Programming Tools and Techniques</strong>.
                    </p>
                    <div class="p-3 bg-white rounded-3 border mb-3 small">
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Target Framework:</span>
                            <span class="fw-semibold text-ink">.NET 10 (net10.0)</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Database Engine:</span>
                            <span class="fw-semibold text-ink">Microsoft SQL Server</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">ORM & Migrations:</span>
                            <span class="fw-semibold text-ink">Entity Framework Core 10</span>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-muted">Automated QA:</span>
                            <span class="fw-semibold text-success"><i class="bi bi-check-circle me-1"></i>50 xUnit Tests Passing</span>
                        </div>
                    </div>
                    <a href="/swagger" target="_blank" class="btn btn-outline-dark btn-sm w-100">
                        <i class="bi bi-code-slash me-1"></i> Explore Interactive OpenAPI / Swagger
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
