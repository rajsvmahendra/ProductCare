@{
    ViewData["Title"] = "Home — Product Warranty & Service Management";
}

<div class="row align-items-center py-5">
    <div class="col-lg-7">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold mb-3">
            <i class="bi bi-shield-check me-1"></i> INT402 Modern Web Programming Tools & Techniques
        </span>
        <h1 class="display-4 fw-bold text-dark mb-3">
            Never Lose Track of <span class="text-primary">Warranties</span> or <span class="text-success">Service Tickets</span> Again.
        </h1>
        <p class="lead text-secondary mb-4">
            ProductCare is an academic-grade, enterprise-ready web platform that unifies consumer product records, calculates warranty expiration dynamically, and manages end-to-end repair and maintenance workflows with an immutable audit trail.
        </p>

        <div class="d-flex flex-wrap gap-3 mb-4">
            @if (User.Identity?.IsAuthenticated == true)
            {
                if (User.IsInRole("Admin"))
                {
                    <a class="btn btn-primary btn-lg px-4" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i> Open Administrator Dashboard
                    </a>
                }
                else
                {
                    <a class="btn btn-primary btn-lg px-4" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2 me-2"></i> Open Customer Portal
                    </a>
                }
            }
            else
            {
                <a class="btn btn-primary btn-lg px-4" asp-area="" asp-controller="Account" asp-action="Register">
                    <i class="bi bi-person-plus me-2"></i> Register Customer Account
                </a>
                <a class="btn btn-outline-dark btn-lg px-4" asp-area="" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                </a>
            }
            <a class="btn btn-outline-info btn-lg px-4" href="/swagger" target="_blank">
                <i class="bi bi-code-slash me-2"></i> OpenAPI Explorer
            </a>
        </div>

        <div class="row g-3 pt-3 border-top">
            <div class="col-sm-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill text-success fs-4 me-2"></i>
                    <div>
                        <div class="fw-bold">ASP.NET Core 10</div>
                        <small class="text-muted">MVC & REST APIs</small>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill text-success fs-4 me-2"></i>
                    <div>
                        <div class="fw-bold">EF Core 10</div>
                        <small class="text-muted">Code First Migrations</small>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill text-success fs-4 me-2"></i>
                    <div>
                        <div class="fw-bold">SQL Server</div>
                        <small class="text-muted">Views & Stored Procs</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                <span class="small fw-semibold"><i class="bi bi-terminal me-2 text-info"></i>Architecture Overview</span>
                <span class="badge bg-success">Active Monolith</span>
            </div>
            <div class="card-body p-4 bg-light">
                <div class="mb-3">
                    <div class="fw-bold text-dark"><i class="bi bi-person-fill me-1 text-primary"></i> Customer Workflow</div>
                    <p class="small text-muted mb-0">Register purchases, upload invoice proofs, monitor expiration statuses, and submit maintenance tickets with real-time tracking.</p>
                </div>
                <div class="mb-3">
                    <div class="fw-bold text-dark"><i class="bi bi-shield-lock-fill me-1 text-danger"></i> Administrator Control</div>
                    <p class="small text-muted mb-0">Review submitted tickets, assign technicians, update validated status progressions, record remarks, and review operational analytics.</p>
                </div>
                <div class="mb-0">
                    <div class="fw-bold text-dark"><i class="bi bi-database-fill-gear me-1 text-info"></i> Database & Reporting Layer</div>
                    <p class="small text-muted mb-0">Includes SQL Server View <code class="text-dark">vw_ProductWarrantySummary</code> and Stored Procedure <code class="text-dark">sp_GetServiceTicketStatistics</code>.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="features" class="py-5 border-top">
    <div class="text-center mb-5">
        <h2 class="fw-bold">Platform Capabilities</h2>
        <p class="text-muted">Designed and architected adhering strictly to the INT402 curriculum.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="pc-card p-4 h-100">
                <div class="d-inline-flex p-3 rounded-circle bg-primary-subtle text-primary mb-3">
                    <i class="bi bi-laptop fs-3"></i>
                </div>
                <h5>Centralized Product Registry</h5>
                <p class="text-muted small">Maintain comprehensive product records: brand, model, serial number, store, price, and secure invoice storage outside wwwroot.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="pc-card p-4 h-100">
                <div class="d-inline-flex p-3 rounded-circle bg-warning-subtle text-warning mb-3">
                    <i class="bi bi-calculator fs-3"></i>
                </div>
                <h5>Dynamic Warranty Calculator</h5>
                <p class="text-muted small">Centralized business service calculating remaining days and categorizing warranties as Active, Expiring Soon (&lt;30 days), or Expired.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="pc-card p-4 h-100">
                <div class="d-inline-flex p-3 rounded-circle bg-success-subtle text-success mb-3">
                    <i class="bi bi-diagram-3 fs-3"></i>
                </div>
                <h5>Validated Workflow Engine</h5>
                <p class="text-muted small">Governed 8-state ticket lifecycle ensuring only permissible transitions with immutable audit history and remarks.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="pc-card p-4 h-100">
                <div class="d-inline-flex p-3 rounded-circle bg-danger-subtle text-danger mb-3">
                    <i class="bi bi-shield-check fs-3"></i>
                </div>
                <h5>Role-Based Security</h5>
                <p class="text-muted small">Server-side ownership verification preventing unauthorized customer data access. Distinct Customer and Admin roles.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="pc-card p-4 h-100">
                <div class="d-inline-flex p-3 rounded-circle bg-info-subtle text-info mb-3">
                    <i class="bi bi-database-check fs-3"></i>
                </div>
                <h5>SQL Server Database Integration</h5>
                <p class="text-muted small">EF Core 10 Code First migrations with relational tables, foreign keys, unique constraints, SQL view, and stored procedure.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="pc-card p-4 h-100">
                <div class="d-inline-flex p-3 rounded-circle bg-secondary-subtle text-secondary mb-3">
                    <i class="bi bi-code-square fs-3"></i>
                </div>
                <h5>RESTful Web APIs & Swagger</h5>
                <p class="text-muted small">Complete API controllers for Products and Service Requests with JWT Bearer authentication ready for Postman verification.</p>
            </div>
        </div>
    </div>
</div>
