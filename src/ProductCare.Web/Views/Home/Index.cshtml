@{
    ViewData["Title"] = "The Ownership Continuity Experience";
}

<!-- =========================================================================
     1. EDITORIAL HERO & GROUNDED PRODUCT DEMONSTRATION
     ========================================================================= -->
<section class="pc-hero-section">
    <div class="container-xl px-3 px-md-4">
        <div class="row align-items-center g-5">
            <!-- Left Editorial Text -->
            <div class="col-lg-6">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background-color: var(--pc-forest-soft); color: var(--pc-forest); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em;">
                    <i class="bi bi-shield-check"></i> THE OWNERSHIP CONTINUITY PLATFORM
                </div>
                <h1 class="pc-hero-headline">
                    Everything you own.<br />
                    Every warranty.<br />
                    Every service journey.<br />
                    <span style="color: var(--pc-forest); font-style: italic;">One place.</span>
                </h1>
                <p class="pc-hero-lead">
                    A centralized ownership management platform that preserves purchase proofs, monitors warranty coverage, and tracks after-sales repair journeys with complete clarity.
                </p>

                <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="btn btn-forest" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <span>Open Administrator Portal</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-forest" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
                                <span>Enter My Product Vault</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                    }
                    else
                    {
                        <a class="btn btn-forest" asp-area="" asp-controller="Account" asp-action="Register">
                            <span>Open Your Ownership Desk</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                        <a class="btn btn-stone" href="#demonstration">
                            <i class="bi bi-eye me-1"></i>
                            <span>Explore Demonstration</span>
                        </a>
                    }
                </div>

                <div class="d-flex align-items-center gap-4 text-muted small pt-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check2 text-success fw-bold"></i>
                        <span>Zero Subscription Fees</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check2 text-success fw-bold"></i>
                        <span>Secure Invoice Vault</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check2 text-success fw-bold"></i>
                        <span>8-Stage Service Machine</span>
                    </div>
                </div>
            </div>

            <!-- Right: Grounded Ownership Lifecycle Demonstration -->
            <div class="col-lg-6" id="demonstration">
                <div class="pc-demo-container">
                    <div class="pc-demo-topbar">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle" style="width: 10px; height: 10px; background-color: var(--pc-stone-dark);"></span>
                            <span class="rounded-circle" style="width: 10px; height: 10px; background-color: var(--pc-stone);"></span>
                            <span class="rounded-circle" style="width: 10px; height: 10px; background-color: var(--pc-stone);"></span>
                            <span class="small fw-semibold ms-2 text-dark font-sans" style="font-size: 0.82rem;">VAULT RECORD &middot; DEMONSTRATION</span>
                        </div>
                        <span class="pc-badge pc-badge-active">
                            <i class="bi bi-check-circle-fill"></i> ACTIVE COVERAGE
                        </span>
                    </div>

                    <div class="pc-demo-body">
                        <!-- Product Identification -->
                        <div class="d-flex align-items-start justify-content-between mb-4 pb-3 border-bottom" style="border-color: var(--pc-stone) !important;">
                            <div>
                                <span class="badge bg-light text-dark border mb-1">Computers</span>
                                <h4 class="mb-1 fw-bold text-dark">Apple MacBook Pro 16" (M3 Max)</h4>
                                <div class="small text-muted font-monospace">S/N: C02G1001MD6R &middot; Model: A2485</div>
                            </div>
                            <div class="text-end">
                                <div class="small text-muted">Purchase Date</div>
                                <div class="fw-semibold text-dark tabular-nums">14 Oct 2025</div>
                            </div>
                        </div>

                        <!-- Real Lifecycle Details Grid -->
                        <div class="row g-3 mb-4">
                            <!-- Invoice Record -->
                            <div class="col-sm-6">
                                <div class="p-3 rounded-3" style="background-color: var(--pc-surface-inset); border: 1px solid var(--pc-stone);">
                                    <div class="small text-muted mb-1 d-flex align-items-center justify-content-between">
                                        <span>PURCHASE PROOF</span>
                                        <i class="bi bi-file-earmark-pdf text-danger"></i>
                                    </div>
                                    <div class="fw-semibold text-dark small text-truncate">AppleStore_Invoice_2025.pdf</div>
                                    <div class="small text-success mt-1" style="font-size: 11px;">
                                        <i class="bi bi-shield-check"></i> 2.4 MB Verified &amp; Encrypted
                                    </div>
                                </div>
                            </div>

                            <!-- Warranty Countdown Radar -->
                            <div class="col-sm-6">
                                <div class="p-3 rounded-3" style="background-color: var(--pc-surface-inset); border: 1px solid var(--pc-stone);">
                                    <div class="small text-muted mb-1 d-flex align-items-center justify-content-between">
                                        <span>WARRANTY COMMITMENT</span>
                                        <span class="badge" style="background-color: var(--pc-forest-soft); color: var(--pc-forest); font-size: 10px;">36 Months</span>
                                    </div>
                                    <div class="fw-bold text-dark tabular-nums">695 Days Remaining</div>
                                    <div class="small text-muted" style="font-size: 11px;">
                                        Expires: 14 Oct 2028
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Connected Active Service Ticket -->
                        <div class="p-3 rounded-3" style="background-color: #FAF8F2; border: 1px solid #E5DEC9;">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="pc-badge pc-badge-progress">
                                        <i class="bi bi-arrow-repeat"></i> IN PROGRESS
                                    </span>
                                    <span class="small fw-bold text-dark font-monospace">PC-20261118-4091</span>
                                </div>
                                <span class="badge bg-warning text-dark" style="font-size: 10px;">Priority: High</span>
                            </div>
                            <div class="fw-semibold text-dark small mb-1">Keyboard Backlight Failure &amp; Sensor Calibration</div>
                            <p class="small text-muted mb-2" style="font-size: 12px;">
                                Diagnostics confirmed sensor continuity failure. Authorized replacement logic board dispatched.
                            </p>
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top small" style="border-color: #E5DEC9 !important; font-size: 11px;">
                                <span class="text-muted"><i class="bi bi-person-badge"></i> Tech: Marcus Vance</span>
                                <span class="text-muted"><i class="bi bi-clock"></i> Updated 2 hours ago</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     2. THE REALITY OF MODERN OWNERSHIP (HUMAN DILEMMAS & SOLUTIONS)
     ========================================================================= -->
<section class="py-5" id="dilemmas" style="border-top: 1px solid var(--pc-stone); background-color: var(--pc-surface);">
    <div class="container-xl px-3 px-md-4 py-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="d-inline-block text-uppercase fw-bold small text-muted mb-2" style="letter-spacing: 0.08em;">THE OWNERSHIP PROBLEM</span>
            <h2 class="pc-section-title">The reality of modern product ownership</h2>
            <p class="pc-section-subtitle mx-auto">
                People acquire valuable devices and appliances every year, but the administrative burden of ownership is broken across physical receipts and disconnected service centers.
            </p>
        </div>

        <div class="row g-4">
            <!-- Dilemma 1 -->
            <div class="col-md-6 col-lg-3">
                <div class="pc-dilemma-card">
                    <div class="pc-dilemma-icon">
                        <i class="bi bi-receipt-cutoff fs-5"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">The Disappearing Receipt</h5>
                    <p class="text-muted small mb-0">
                        Thermal paper receipts fade to illegible white sheets within months. When a claim arises, consumers cannot produce proof of purchase.
                    </p>
                    <div class="mt-3 pt-3 border-top small text-forest fw-semibold" style="border-color: var(--pc-stone) !important;">
                        <i class="bi bi-check-circle me-1"></i> ProductCare stores verified PDFs outside web root.
                    </div>
                </div>
            </div>

            <!-- Dilemma 2 -->
            <div class="col-md-6 col-lg-3">
                <div class="pc-dilemma-card">
                    <div class="pc-dilemma-icon">
                        <i class="bi bi-hourglass-bottom fs-5" style="color: var(--pc-amber);"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">The Lapsed Deadline</h5>
                    <p class="text-muted small mb-0">
                        Consumers discover a fault only to find the manufacturer warranty expired three weeks earlier because no tracking system gave warning.
                    </p>
                    <div class="mt-3 pt-3 border-top small text-forest fw-semibold" style="border-color: var(--pc-stone) !important;">
                        <i class="bi bi-check-circle me-1"></i> 30-day proactive radar flags expiring commitments.
                    </div>
                </div>
            </div>

            <!-- Dilemma 3 -->
            <div class="col-md-6 col-lg-3">
                <div class="pc-dilemma-card">
                    <div class="pc-dilemma-icon">
                        <i class="bi bi-question-circle fs-5"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">The Opaque Repair</h5>
                    <p class="text-muted small mb-0">
                        Once a device enters a service workshop, customers face unanswered phone calls and complete silence regarding diagnostic progress.
                    </p>
                    <div class="mt-3 pt-3 border-top small text-forest fw-semibold" style="border-color: var(--pc-stone) !important;">
                        <i class="bi bi-check-circle me-1"></i> Governed 8-state machine with immutable audit log.
                    </div>
                </div>
            </div>

            <!-- Dilemma 4 -->
            <div class="col-md-6 col-lg-3">
                <div class="pc-dilemma-card">
                    <div class="pc-dilemma-icon">
                        <i class="bi bi-diagram-3 fs-5"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Fragmented Records</h5>
                    <p class="text-muted small mb-0">
                        Serial numbers, user manuals, and service histories remain scattered across manufacturer portals and disorganized personal email folders.
                    </p>
                    <div class="mt-3 pt-3 border-top small text-forest fw-semibold" style="border-color: var(--pc-stone) !important;">
                        <i class="bi bi-check-circle me-1"></i> A single, unified digital ownership inventory.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     3. CONNECTED OWNERSHIP JOURNEY (HOW PRODUCTCARE WORKS)
     ========================================================================= -->
<section class="py-5" id="how-it-works">
    <div class="container-xl px-3 px-md-4 py-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="d-inline-block text-uppercase fw-bold small text-muted mb-2" style="letter-spacing: 0.08em;">THE SYSTEM IN ACTION</span>
            <h2 class="pc-section-title">A continuous ownership lifecycle</h2>
            <p class="pc-section-subtitle mx-auto">
                From the moment you register an acquisition to the final resolution of a repair, ProductCare manages every transition with rigorous precision.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="pc-journey-step">
                    <div class="pc-step-num">Step 01</div>
                    <h5 class="fw-bold text-dark mb-2">Register &amp; Preserve Proof</h5>
                    <p class="text-muted small mb-3">
                        Enter your product's brand, model, and serial number. Attach the original purchase invoice or receipt (PDF, JPG, PNG). The physical file is safely stored in our secure repository outside web root.
                    </p>
                    <div class="small font-monospace p-2 rounded bg-light border text-muted">
                        &gt; PurchaseDate + DurationMonths
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="pc-journey-step">
                    <div class="pc-step-num">Step 02</div>
                    <h5 class="fw-bold text-dark mb-2">Dynamic Warranty Intelligence</h5>
                    <p class="text-muted small mb-3">
                        Our centralized warranty engine calculates remaining coverage days against current UTC time, automatically updating statuses from Active to Expiring Soon (&le;30 days) and Expired.
                    </p>
                    <div class="small font-monospace p-2 rounded bg-light border text-muted">
                        &gt; 30-Day Alert Banner Activated
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="pc-journey-step">
                    <div class="pc-step-num">Step 03</div>
                    <h5 class="fw-bold text-dark mb-2">Governed Service Resolution</h5>
                    <p class="text-muted small mb-3">
                        When issues occur, initiate a service request with a collision-safe ticket number (PC-YYYYMMDD-XXXX). Follow technician remarks and status transitions across an immutable audit history.
                    </p>
                    <div class="small font-monospace p-2 rounded bg-light border text-muted">
                        &gt; StatusHistory + Actor Snapshot
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     4. GENUINE APPLICATION CAPABILITIES (VERIFIED IMPLEMENTATION)
     ========================================================================= -->
<section class="py-5" id="capabilities" style="background-color: var(--pc-surface); border-top: 1px solid var(--pc-stone);">
    <div class="container-xl px-3 px-md-4 py-4">
        <div class="row align-items-center g-5 mb-5">
            <div class="col-lg-6">
                <span class="d-inline-block text-uppercase fw-bold small text-muted mb-2" style="letter-spacing: 0.08em;">SYSTEM CAPABILITIES</span>
                <h2 class="pc-section-title">Built for operational integrity, not presentation theater</h2>
                <p class="text-muted">
                    ProductCare is engineered on modern software development tools and techniques, adhering to enterprise design patterns, strict role-based access control, and asynchronous database architecture.
                </p>
            </div>
            <div class="col-lg-6 text-lg-end">
                <a href="/swagger" target="_blank" class="btn btn-stone">
                    <i class="bi bi-code-slash text-forest me-1"></i> Inspect OpenAPI Specification
                </a>
            </div>
        </div>

        <div class="row g-4">
            <!-- Feature 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-3 h-100" style="background-color: var(--pc-canvas); border: 1px solid var(--pc-stone);">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-database-check fs-4 text-forest"></i>
                        <h6 class="fw-bold text-dark mb-0">Per-Customer Isolation</h6>
                    </div>
                    <p class="text-muted small mb-0">
                        Strict server-side ownership enforcement prevents Insecure Direct Object References (IDOR). Customers access only records linked directly to their authenticated Identity.
                    </p>
                </div>
            </div>

            <!-- Feature 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-3 h-100" style="background-color: var(--pc-canvas); border: 1px solid var(--pc-stone);">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-shield-lock fs-4 text-forest"></i>
                        <h6 class="fw-bold text-dark mb-0">Physical File Validation</h6>
                    </div>
                    <p class="text-muted small mb-0">
                        Invoices are validated using magic byte headers to confirm genuine file formats (PDF, JPEG, PNG). Stored safely outside the web root with unique GUID filenames.
                    </p>
                </div>
            </div>

            <!-- Feature 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-3 h-100" style="background-color: var(--pc-canvas); border: 1px solid var(--pc-stone);">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-diagram-2 fs-4 text-forest"></i>
                        <h6 class="fw-bold text-dark mb-0">Finite State Machine</h6>
                    </div>
                    <p class="text-muted small mb-0">
                        Service tickets progress strictly across 8 validated states (Submitted &rarr; UnderReview &rarr; Assigned &rarr; InProgress &rarr; WaitingForCustomer &rarr; Resolved &rarr; Closed / Rejected).
                    </p>
                </div>
            </div>

            <!-- Feature 4 -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-3 h-100" style="background-color: var(--pc-canvas); border: 1px solid var(--pc-stone);">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-calendar3 fs-4 text-forest"></i>
                        <h6 class="fw-bold text-dark mb-0">Precise Date Mathematics</h6>
                    </div>
                    <p class="text-muted small mb-0">
                        The warranty engine accurately handles leap years, month-end boundary conditions, and negative day calculations, covered by 17 dedicated xUnit tests.
                    </p>
                </div>
            </div>

            <!-- Feature 5 -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-3 h-100" style="background-color: var(--pc-canvas); border: 1px solid var(--pc-stone);">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-journal-text fs-4 text-forest"></i>
                        <h6 class="fw-bold text-dark mb-0">Immutable Audit Trails</h6>
                    </div>
                    <p class="text-muted small mb-0">
                        Every status transition logs a historical snapshot recording the prior status, new status, actor username, administrative remarks, and timestamp in UTC.
                    </p>
                </div>
            </div>

            <!-- Feature 6 -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-3 h-100" style="background-color: var(--pc-canvas); border: 1px solid var(--pc-stone);">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-key fs-4 text-forest"></i>
                        <h6 class="fw-bold text-dark mb-0">Dual Authentication</h6>
                    </div>
                    <p class="text-muted small mb-0">
                        Supports secure Cookie Sessions for Razor MVC portals and signed JWT Bearer tokens for external API integration, documented seamlessly via OpenAPI 3.0.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     5. CLOSING INVITATION (AUTHENTICATION DESK ENTRY)
     ========================================================================= -->
<section class="py-5" id="security" style="border-top: 1px solid var(--pc-stone);">
    <div class="container-xl px-3 px-md-4 py-5 text-center">
        <div class="max-w-700 mx-auto">
            <span class="d-inline-block text-uppercase fw-bold small text-muted mb-2" style="letter-spacing: 0.08em;">START KEEPING TRACK</span>
            <h2 class="pc-hero-headline mb-3">Take control of everything you own</h2>
            <p class="pc-hero-lead mx-auto mb-4">
                Open your personal Ownership Desk today. Catalog your devices, store your purchase proofs, and protect your warranty rights.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a class="btn btn-forest px-4 py-2" asp-area="" asp-controller="Account" asp-action="Register">
                    Open Your Ownership Desk
                </a>
                <a class="btn btn-stone px-4 py-2" asp-area="" asp-controller="Account" asp-action="Login">
                    Sign In to Existing Vault
                </a>
            </div>
        </div>
    </div>
</section>
