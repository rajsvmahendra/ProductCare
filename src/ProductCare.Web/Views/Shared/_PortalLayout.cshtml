<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ProductCare Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-canvas">
    <div class="pc-portal-wrapper">
        <!-- 252px Deep Navy Sidebar -->
        <aside class="pc-portal-sidebar">
            <div class="pc-sidebar-header">
                <a class="pc-logo is-light" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg class="pc-logo-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <rect width="32" height="32" rx="8" fill="rgba(255,255,255,0.12)" />
                        <path d="M16 6L8 9.5V16C8 21 11.5 25.5 16 27C20.5 25.5 24 21 24 16V9.5L16 6Z" stroke="#9DA8FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M12 16.5L15 19.5L20.5 13.5" stroke="#12A89A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="pc-logo-text">Product<span style="color: #9DA8FF;">Care</span></span>
                </a>
            </div>

            <div class="pc-sidebar-nav">
                @if (User.IsInRole("Admin"))
                {
                    <div class="pc-nav-group-title">ADMINISTRATION</div>
                    <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span>Overview</span>
                    </a>
                    <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceRequests" ? "active" : "")" asp-area="Admin" asp-controller="ServiceRequests" asp-action="Index">
                        <i class="bi bi-inbox"></i>
                        <span>Ticket Queue</span>
                    </a>

                    <div class="pc-nav-group-title">DIRECTORY & ASSETS</div>
                    <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" asp-area="Admin" asp-controller="Customers" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Customers</span>
                    </a>
                    <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")" asp-area="Admin" asp-controller="Products" asp-action="Index">
                        <i class="bi bi-boxes"></i>
                        <span>Global Inventory</span>
                    </a>

                    <div class="pc-nav-group-title">INTELLIGENCE</div>
                    <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                        <i class="bi bi-bar-chart-line"></i>
                        <span>Reports & Views</span>
                    </a>
                }
                else
                {
                    <div class="pc-nav-group-title">MAIN WORKSPACE</div>
                    <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid"></i>
                        <span>Dashboard</span>
                    </a>

                    <div class="pc-nav-group-title">MY PRODUCTS</div>
                    <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")" asp-area="Customer" asp-controller="Products" asp-action="Index">
                        <i class="bi bi-laptop"></i>
                        <span>Product Shelf</span>
                    </a>
                    <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Warranty" ? "active" : "")" asp-area="Customer" asp-controller="Warranty" asp-action="Index">
                        <i class="bi bi-shield-check"></i>
                        <span>Warranty Timeline</span>
                    </a>

                    <div class="pc-nav-group-title">SERVICE & REPAIRS</div>
                    <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceRequests" ? "active" : "")" asp-area="Customer" asp-controller="ServiceRequests" asp-action="Index">
                        <i class="bi bi-ticket-detailed"></i>
                        <span>Service Requests</span>
                    </a>
                }

                <div class="pc-nav-group-title">EXTERNAL TOOLS</div>
                <a class="pc-sidebar-link" href="/swagger" target="_blank">
                    <i class="bi bi-code-slash"></i>
                    <span>OpenAPI Swagger</span>
                </a>
                <a class="pc-sidebar-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span>Public Website</span>
                </a>
            </div>

            <!-- Sidebar User Profile Footer -->
            <div class="pc-sidebar-footer">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white small" style="width: 34px; height: 34px; background: #2F3E61; flex-shrink: 0;">
                            @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <div class="overflow-hidden">
                            <div class="text-white small fw-semibold text-truncate">@User.Identity?.Name</div>
                            <div class="text-muted" style="font-size: 11px;">@(User.IsInRole("Admin") ? "Administrator" : "Customer")</div>
                        </div>
                    </div>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-link text-white-50 p-1" title="Sign Out">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main Portal Container -->
        <div class="pc-portal-main">
            <!-- Portal Topbar -->
            <header class="pc-portal-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm btn-light d-lg-none" type="button" id="pcSidebarToggle" aria-label="Toggle Sidebar Menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0 small">
                            <li class="breadcrumb-item text-muted">Portal</li>
                            <li class="breadcrumb-item text-muted">@(User.IsInRole("Admin") ? "Admin" : "Customer")</li>
                            <li class="breadcrumb-item active fw-semibold text-ink" aria-current="page">@ViewData["Title"]</li>
                        </ol>
                    </nav>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (User.IsInRole("Customer"))
                    {
                        <a asp-area="Customer" asp-controller="Products" asp-action="Create" class="btn-pc-primary btn-pc-sm">
                            <i class="bi bi-plus-lg"></i>
                            <span>Add Product</span>
                        </a>
                        <a asp-area="Customer" asp-controller="ServiceRequests" asp-action="Create" class="btn-pc-teal btn-pc-sm">
                            <i class="bi bi-wrench"></i>
                            <span>Request Service</span>
                        </a>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <a asp-area="Admin" asp-controller="ServiceRequests" asp-action="Index" class="btn-pc-primary btn-pc-sm">
                            <i class="bi bi-inbox me-1"></i> Ticket Queue
                        </a>
                    }
                </div>
            </header>

            <!-- Portal Content Region -->
            <main class="pc-portal-content">
                <!-- Flash Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-info-circle-fill me-2 text-info"></i> @TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
