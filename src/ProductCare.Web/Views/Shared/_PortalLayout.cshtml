<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ProductCare Workspace</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: var(--pc-bg-main); color: var(--pc-text-primary);">
    <div class="pc-portal-layout">
        <!-- 250px Midnight Obsidian Sidebar -->
        <aside class="pc-portal-sidebar">
            <div>
                <a class="pc-sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg class="pc-brand-mark" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <rect width="32" height="32" rx="8" fill="#151F30" />
                        <path d="M16 5.5L8 9.2V15.8C8 20.8 11.4 25.4 16 26.8C20.6 25.4 24 20.8 24 15.8V9.2L16 5.5Z" stroke="#38D9C5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M12 16.2L14.8 19L20.2 13.2" stroke="#F3B66D" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="pc-brand-title">ProductCare</span>
                </a>

                <ul class="pc-sidebar-nav">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="pc-sidebar-group-title">ADMINISTRATIVE OPS</li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2"></i>
                                <span>Overview</span>
                            </a>
                        </li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceRequests" ? "active" : "")" asp-area="Admin" asp-controller="ServiceRequests" asp-action="Index">
                                <i class="bi bi-inbox"></i>
                                <span>Ticket Queue</span>
                            </a>
                        </li>

                        <li class="pc-sidebar-group-title">VAULT DIRECTORY</li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" asp-area="Admin" asp-controller="Customers" asp-action="Index">
                                <i class="bi bi-people"></i>
                                <span>Customers</span>
                            </a>
                        </li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")" asp-area="Admin" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-boxes"></i>
                                <span>Global Inventory</span>
                            </a>
                        </li>

                        <li class="pc-sidebar-group-title">INTELLIGENCE</li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                                <i class="bi bi-bar-chart-line"></i>
                                <span>Reports &amp; SQL Views</span>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="pc-sidebar-group-title">OWNERSHIP VAULT</li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-grid-fill"></i>
                                <span>Ownership Overview</span>
                            </a>
                        </li>

                        <li class="pc-sidebar-group-title">DEVICE RECORDS</li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")" asp-area="Customer" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-laptop"></i>
                                <span>Product Inventory</span>
                            </a>
                        </li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Warranty" ? "active" : "")" asp-area="Customer" asp-controller="Warranty" asp-action="Index">
                                <i class="bi bi-shield-check"></i>
                                <span>Warranty Timeline</span>
                            </a>
                        </li>

                        <li class="pc-sidebar-group-title">SERVICE &amp; REPAIRS</li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceRequests" ? "active" : "")" asp-area="Customer" asp-controller="ServiceRequests" asp-action="Index">
                                <i class="bi bi-wrench-adjustable"></i>
                                <span>Service Requests</span>
                            </a>
                        </li>
                    }

                    <li class="pc-sidebar-group-title">SYSTEM</li>
                    <li class="pc-sidebar-item">
                        <a class="pc-sidebar-link" href="/swagger" target="_blank">
                            <i class="bi bi-code-slash"></i>
                            <span>OpenAPI Docs</span>
                        </a>
                    </li>
                    <li class="pc-sidebar-item">
                        <a class="pc-sidebar-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                            <i class="bi bi-shield-lock"></i>
                            <span>Compliance &amp; Privacy</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Sidebar Footer User Profile -->
            <div class="pt-3 border-top" style="border-color: var(--pc-border-hairline) !important;">
                <div class="d-flex align-items-center justify-content-between p-2 rounded-3" style="background-color: rgba(255, 255, 255, 0.03);">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                        <i class="bi bi-person-circle fs-5 text-electric-teal flex-shrink-0"></i>
                        <div class="text-truncate">
                            <div class="small fw-bold text-light text-truncate">@User.Identity?.Name</div>
                            <div class="small text-muted" style="font-size: 11px;">
                                @(User.IsInRole("Admin") ? "System Admin" : "Verified Customer")
                            </div>
                        </div>
                    </div>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link text-danger p-1" title="Sign Out" aria-label="Sign Out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main Portal Content -->
        <div class="pc-portal-content">
            <!-- Contextual Topbar -->
            <header class="pc-portal-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-midnight btn-sm d-lg-none px-2 py-1" id="pcSidebarToggle" type="button" aria-label="Toggle navigation drawer">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted font-display">ProductCare</span>
                        <i class="bi bi-chevron-right text-muted" style="font-size: 10px;"></i>
                        <span class="small fw-semibold text-light">@ViewData["Title"]</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <span class="pc-badge @(User.IsInRole("Admin") ? "pc-badge-expiring" : "pc-badge-active")">
                        @(User.IsInRole("Admin") ? "ADMINISTRATOR" : "CUSTOMER VAULT")
                    </span>
                    <a class="btn btn-midnight btn-sm d-none d-sm-inline-flex" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-globe me-1"></i> Public Site
                    </a>
                </div>
            </header>

            <!-- Workspace Body Canvas -->
            <main class="flex-grow-1 p-3 p-md-4">
                <!-- Notifications -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" style="background-color: rgba(56, 217, 197, 0.15); border-color: rgba(56, 217, 197, 0.35); color: var(--pc-text-primary);" role="alert">
                        <i class="bi bi-check-circle-fill me-2 text-electric-teal"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" style="background-color: rgba(255, 107, 107, 0.15); border-color: rgba(255, 107, 107, 0.35); color: var(--pc-text-primary);" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show shadow-sm mb-4" style="background-color: rgba(102, 140, 255, 0.15); border-color: rgba(102, 140, 255, 0.35); color: var(--pc-text-primary);" role="alert">
                        <i class="bi bi-info-circle-fill me-2 text-electric-blue"></i> @TempData["InfoMessage"]
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
