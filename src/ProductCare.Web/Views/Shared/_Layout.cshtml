<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ProductCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Public & Marketing Navigation -->
    <header class="pc-navbar">
        <div class="container-xl h-100 d-flex align-items-center justify-content-between px-3 px-md-4">
            <!-- Brand Logo -->
            <a class="pc-logo" asp-area="" asp-controller="Home" asp-action="Index">
                <svg class="pc-logo-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect width="32" height="32" rx="8" fill="#EEF0FF" />
                    <path d="M16 6L8 9.5V16C8 21 11.5 25.5 16 27C20.5 25.5 24 21 24 16V9.5L16 6Z" stroke="#4F5FEA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M12 16.5L15 19.5L20.5 13.5" stroke="#12A89A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="pc-logo-text">Product<span class="text-primary-pc">Care</span></span>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="d-none d-md-flex align-items-center gap-1" aria-label="Main Navigation">
                <a class="pc-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Overview</a>
                <a class="pc-nav-link" href="/#problem">The Problem</a>
                <a class="pc-nav-link" href="/#how-it-works">How It Works</a>
                <a class="pc-nav-link" href="/#features">Features</a>
                <a class="pc-nav-link" href="/#trust">Security & Trust</a>
            </nav>

            <!-- Auth Action Controls -->
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn-pc-primary btn-pc-sm" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-shield-lock me-1"></i> Admin Portal
                        </a>
                    }
                    else
                    {
                        <a class="btn-pc-primary btn-pc-sm" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-grid-fill me-1"></i> My Dashboard
                        </a>
                    }

                    <div class="dropdown">
                        <button class="btn btn-pc-ghost btn-pc-sm dropdown-toggle" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenuButton">
                            <li><h6 class="dropdown-header">@User.Identity?.Name</h6></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn-pc-ghost" asp-area="" asp-controller="Account" asp-action="Login">
                        Sign In
                    </a>
                    <a class="btn-pc-primary btn-pc-sm" asp-area="" asp-controller="Account" asp-action="Register">
                        Get Started
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Main Content Canvas -->
    <main class="flex-grow-1">
        <!-- Toast Alerts -->
        <div class="container-xl px-3 px-md-4 mt-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-info-circle-fill me-2 text-info"></i> @TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <!-- Public Footer -->
    <footer class="bg-white border-top py-5 mt-auto">
        <div class="container-xl px-3 px-md-4">
            <div class="row g-4 mb-4">
                <div class="col-lg-5">
                    <div class="pc-logo mb-3">
                        <svg class="pc-logo-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <rect width="32" height="32" rx="8" fill="#EEF0FF" />
                            <path d="M16 6L8 9.5V16C8 21 11.5 25.5 16 27C20.5 25.5 24 21 24 16V9.5L16 6Z" stroke="#4F5FEA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M12 16.5L15 19.5L20.5 13.5" stroke="#12A89A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span class="pc-logo-text">Product<span class="text-primary-pc">Care</span></span>
                    </div>
                    <p class="text-muted small pe-lg-5">
                        Everything you own. Everything covered. All in one place. Keep product purchase records organized, stay ahead of expiring warranties, and follow every service request.
                    </p>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="fw-bold text-ink mb-3 font-heading small text-uppercase">Platform</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a href="/#how-it-works" class="text-muted">How It Works</a></li>
                        <li><a href="/#features" class="text-muted">Product Library</a></li>
                        <li><a href="/#features" class="text-muted">Warranty Engine</a></li>
                        <li><a href="/#features" class="text-muted">Service Tracker</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="fw-bold text-ink mb-3 font-heading small text-uppercase">Access</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a asp-area="" asp-controller="Account" asp-action="Register" class="text-muted">Register Customer</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="Login" class="text-muted">Sign In</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted">Data & Privacy</a></li>
                    </ul>
                </div>

                <div class="col-md-6 col-lg-3">
                    <h6 class="fw-bold text-ink mb-3 font-heading small text-uppercase">Academic Project</h6>
                    <div class="p-3 rounded-3 bg-light border small text-muted">
                        <div class="fw-semibold text-ink mb-1">INT402: Modern Web Programming</div>
                        <div>ASP.NET Core 10 &middot; EF Core 10 &middot; SQL Server</div>
                        <div class="mt-2">
                            <a href="/swagger" target="_blank" class="text-primary-pc fw-semibold d-inline-flex align-items-center gap-1">
                                <i class="bi bi-code-slash"></i> OpenAPI / Swagger Docs
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-top pt-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
                <div>&copy; 2026 ProductCare. All rights reserved.</div>
                <div>Designed with clarity, reassurance, and precision.</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
