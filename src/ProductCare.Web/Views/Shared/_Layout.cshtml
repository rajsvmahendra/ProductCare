<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ProductCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-productcare">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand navbar-brand-pc" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-check text-info"></i> ProductCare
                    <span class="navbar-brand-badge">Portal</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-pc" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-pc" asp-area="Admin" asp-controller="ServiceRequests" asp-action="Index">
                                        <i class="bi bi-ticket-detailed me-1"></i> Tickets Queue
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-pc" asp-area="Admin" asp-controller="Customers" asp-action="Index">
                                        <i class="bi bi-people me-1"></i> Customers
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-pc" asp-area="Admin" asp-controller="Products" asp-action="Index">
                                        <i class="bi bi-boxes me-1"></i> All Products
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-pc" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                                        <i class="bi bi-bar-chart-line me-1"></i> Reports & Intelligence
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-pc" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-grid-1x2 me-1"></i> My Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-pc" asp-area="Customer" asp-controller="Products" asp-action="Index">
                                        <i class="bi bi-laptop me-1"></i> My Products
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-pc" asp-area="Customer" asp-controller="Warranty" asp-action="Index">
                                        <i class="bi bi-award me-1"></i> Warranties
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-pc" asp-area="Customer" asp-controller="ServiceRequests" asp-action="Index">
                                        <i class="bi bi-tools me-1"></i> Service Requests
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-pc" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-pc" href="/#features">Features</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-pc" href="/#about">About</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item me-2">
                            <a class="nav-link nav-link-pc text-info" href="/swagger" target="_blank" title="REST API Documentation">
                                <i class="bi bi-code-slash me-1"></i> API Docs (Swagger)
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item me-2">
                                    <span class="badge bg-danger px-2 py-1"><i class="bi bi-shield-lock me-1"></i> Admin</span>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item me-2">
                                    <a class="btn btn-sm btn-outline-info text-white" asp-area="Customer" asp-controller="Products" asp-action="Create">
                                        <i class="bi bi-plus-circle me-1"></i> Add Product
                                    </a>
                                </li>
                                <li class="nav-item me-2">
                                    <a class="btn btn-sm btn-pc-teal" asp-area="Customer" asp-controller="ServiceRequests" asp-action="Create">
                                        <i class="bi bi-wrench me-1"></i> Request Service
                                    </a>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-semibold" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity?.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenu">
                                    <li><h6 class="dropdown-header">Signed in as @(User.IsInRole("Admin") ? "Admin" : "Customer")</h6></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="ServiceRequests" asp-action="Index">Ticket Queue</a></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-area="Customer" asp-controller="Products" asp-action="Index">My Products</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-sm btn-outline-light" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-pc-primary text-white" asp-area="" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="py-4">
        <div class="container-fluid px-lg-4">
            <!-- Flash Message Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="footer-productcare py-3 mt-auto">
        <div class="container-fluid px-lg-4 d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div>
                <strong>ProductCare</strong> &copy; 2026 — Product Warranty and Service Management Portal.
                <span class="ms-2 badge bg-light text-secondary border">INT402 Academic Project</span>
            </div>
            <div class="mt-2 mt-md-0">
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted me-3">Privacy Policy</a>
                <a href="/swagger" target="_blank" class="text-decoration-none text-muted me-3">OpenAPI Docs</a>
                <span class="text-muted small">ASP.NET Core 10 &middot; EF Core &middot; SQL Server</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
