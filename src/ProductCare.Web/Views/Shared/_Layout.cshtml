<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ProductCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Public Header -->
    <header class="pc-public-header">
        <div class="container-xl d-flex align-items-center justify-content-between px-3 px-md-4">
            <!-- Brand Mark & Logotype -->
            <a class="pc-brand-logo" asp-area="" asp-controller="Home" asp-action="Index">
                <svg class="pc-brand-mark" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect width="32" height="32" rx="8" fill="#E7EFEA" />
                    <!-- Protective Shield Contour -->
                    <path d="M16 5.5L8 9.2V15.8C8 20.8 11.4 25.4 16 26.8C20.6 25.4 24 20.8 24 15.8V9.2L16 5.5Z" stroke="#315D50" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <!-- Continuity knot & verification mark -->
                    <path d="M12 16.2L14.8 19L20.2 13.2" stroke="#D69A51" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="pc-brand-title font-sans">ProductCare</span>
            </a>

            <!-- Navigation Links -->
            <nav class="d-none d-md-flex align-items-center gap-1" aria-label="Main Navigation">
                <a class="pc-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Overview</a>
                <a class="pc-nav-link" href="/#demonstration">Ownership Journey</a>
                <a class="pc-nav-link" href="/#dilemmas">Why ProductCare</a>
                <a class="pc-nav-link" href="/#capabilities">Capabilities</a>
                <a class="pc-nav-link" href="/#security">Security & Proof</a>
            </nav>

            <!-- Authentication Actions -->
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-forest btn-sm" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-shield-lock me-1"></i> Admin Portal
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-forest btn-sm" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-folder-check me-1"></i> My Product Vault
                        </a>
                    }

                    <div class="dropdown">
                        <button class="btn btn-stone btn-sm dropdown-toggle" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenuButton">
                            <li><h6 class="dropdown-header">@User.Identity?.Name</h6></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-stone btn-sm" asp-area="" asp-controller="Account" asp-action="Login">
                        Sign In
                    </a>
                    <a class="btn btn-forest btn-sm" asp-area="" asp-controller="Account" asp-action="Register">
                        Open Ownership Desk
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Main Content Canvas -->
    <main class="flex-grow-1">
        <!-- Toast & Feedback Notifications -->
        <div class="container-xl px-3 px-md-4 mt-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-info-circle-fill me-2 text-info"></i> @TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <!-- Public Footer -->
    <footer class="pc-public-footer">
        <div class="container-xl px-3 px-md-4">
            <div class="row g-4 mb-4">
                <div class="col-lg-5">
                    <div class="pc-brand-logo mb-3">
                        <svg class="pc-brand-mark" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <rect width="32" height="32" rx="8" fill="#E7EFEA" />
                            <path d="M16 5.5L8 9.2V15.8C8 20.8 11.4 25.4 16 26.8C20.6 25.4 24 20.8 24 15.8V9.2L16 5.5Z" stroke="#315D50" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M12 16.2L14.8 19L20.2 13.2" stroke="#D69A51" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span class="pc-brand-title font-sans">ProductCare</span>
                    </div>
                    <p class="text-muted small pe-lg-5">
                        ProductCare is the ownership management platform that keeps every product record, warranty commitment and service journey connected in one place.
                    </p>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <div class="pc-footer-title">Platform</div>
                    <ul class="pc-footer-list">
                        <li><a href="/#demonstration">Ownership Journey</a></li>
                        <li><a href="/#dilemmas">Why ProductCare</a></li>
                        <li><a href="/#capabilities">Digital Product Vault</a></li>
                        <li><a href="/#capabilities">Warranty Intelligence</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <div class="pc-footer-title">Access</div>
                    <ul class="pc-footer-list">
                        <li><a asp-area="" asp-controller="Account" asp-action="Register">Open Ownership Desk</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="Login">Sign In to Vault</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Data & Security</a></li>
                    </ul>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="pc-footer-title">Integration & APIs</div>
                    <p class="small text-muted mb-3">
                        Fully documented OpenAPI 3.0 REST endpoints secured via JWT Bearer tokens and ASP.NET Core Identity.
                    </p>
                    <a href="/swagger" target="_blank" class="btn btn-stone btn-sm d-inline-flex align-items-center gap-2">
                        <i class="bi bi-code-slash text-forest"></i> Swagger REST API
                    </a>
                </div>
            </div>

            <div class="border-top pt-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted" style="border-color: var(--pc-stone) !important;">
                <div>&copy; 2026 ProductCare. The Ownership Continuity Experience.</div>
                <div>Engineered with ASP.NET Core 10, Entity Framework Core 10 & SQL Server.</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
