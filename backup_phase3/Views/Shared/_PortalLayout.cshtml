<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ProductCare Workspace</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: var(--pc-canvas); color: var(--pc-text-primary);">
    <div class="pc-portal-layout">
        <!-- 248px Crisp Light Sidebar -->
        <aside class="pc-portal-sidebar">
            <div>
                <a class="pc-sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/productcare-logo.png" alt="ProductCare" height="38" class="pc-brand-img" style="max-height: 38px; width: auto;" />
                </a>

                <ul class="pc-sidebar-nav">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="pc-sidebar-group-title">Operations</li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2"></i>
                                <span>Overview</span>
                            </a>
                        </li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceRequests" ? "active" : "")" asp-area="Admin" asp-controller="ServiceRequests" asp-action="Index">
                                <i class="bi bi-inbox"></i>
                                <span>Ticket Queue</span>
                            </a>
                        </li>

                        <li class="pc-sidebar-group-title">Registry &amp; Directory</li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" asp-area="Admin" asp-controller="Customers" asp-action="Index">
                                <i class="bi bi-people"></i>
                                <span>Customers</span>
                            </a>
                        </li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")" asp-area="Admin" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-boxes"></i>
                                <span>Global Inventory</span>
                            </a>
                        </li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceCenters" ? "active" : "")" asp-area="Admin" asp-controller="ServiceCenters" asp-action="Index">
                                <i class="bi bi-building"></i>
                                <span>Service Centres</span>
                            </a>
                        </li>

                        <li class="pc-sidebar-group-title">Reports &amp; Intelligence</li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                                <i class="bi bi-bar-chart-line"></i>
                                <span>Reports &amp; SQL Views</span>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="pc-sidebar-group-title">Workspace</li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-grid-fill"></i>
                                <span>Overview</span>
                            </a>
                        </li>

                        <li class="pc-sidebar-group-title">Devices &amp; Coverage</li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")" asp-area="Customer" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-laptop"></i>
                                <span>My Products</span>
                            </a>
                        </li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Warranty" ? "active" : "")" asp-area="Customer" asp-controller="Warranty" asp-action="Index">
                                <i class="bi bi-shield-check"></i>
                                <span>Warranty Status</span>
                            </a>
                        </li>

                        <li class="pc-sidebar-group-title">Service &amp; Repairs</li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceRequests" ? "active" : "")" asp-area="Customer" asp-controller="ServiceRequests" asp-action="Index">
                                <i class="bi bi-wrench-adjustable"></i>
                                <span>Service Requests</span>
                            </a>
                        </li>
                        <li class="pc-sidebar-item">
                            <a class="pc-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceCenters" ? "active" : "")" asp-area="Customer" asp-controller="ServiceCenters" asp-action="Index">
                                <i class="bi bi-geo-alt"></i>
                                <span>Find a Service Centre</span>
                            </a>
                        </li>
                    }

                    <li class="pc-sidebar-group-title">System &amp; Documentation</li>
                    <li class="pc-sidebar-item">
                        <a class="pc-sidebar-link" href="/swagger" target="_blank">
                            <i class="bi bi-code-slash"></i>
                            <span>OpenAPI Docs</span>
                        </a>
                    </li>
                    <li class="pc-sidebar-item">
                        <a class="pc-sidebar-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                            <i class="bi bi-shield-lock"></i>
                            <span>Privacy &amp; Terms</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Sidebar Footer User Profile -->
            <div class="pt-3 border-top">
                <div class="d-flex align-items-center justify-content-between p-2 rounded-2" style="background-color: var(--pc-surface-secondary);">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                        <i class="bi bi-person-circle fs-5 text-forest flex-shrink-0"></i>
                        <div class="text-truncate">
                            <div class="small fw-bold text-dark text-truncate">@User.Identity?.Name</div>
                            <div class="text-muted" style="font-size: 11px;">
                                @(User.IsInRole("Admin") ? "Operations Lead" : "Verified User")
                            </div>
                        </div>
                    </div>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link text-secondary p-1" title="Sign Out" aria-label="Sign Out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main Portal Content -->
        <div class="pc-portal-content">
            <!-- Contextual Topbar -->
            <header class="pc-portal-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-stone btn-sm d-lg-none px-2 py-1" id="pcSidebarToggle" type="button" aria-label="Toggle navigation drawer">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted font-display">ProductCare</span>
                        <i class="bi bi-chevron-right text-muted" style="font-size: 10px;"></i>
                        <span class="small fw-semibold text-dark">@ViewData["Title"]</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <span class="pc-badge @(User.IsInRole("Admin") ? "pc-badge-expiring" : "pc-badge-active")">
                        @(User.IsInRole("Admin") ? "ADMINISTRATOR" : "CUSTOMER")
                    </span>
                    <a class="btn btn-stone btn-sm d-none d-sm-inline-flex" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-globe me-1"></i> Public Site
                    </a>
                </div>
            </header>

            <!-- Workspace Body Canvas -->
            <main class="flex-grow-1 p-3 p-md-4">
                <!-- Notifications -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" style="background-color: #F0FDF4; border-color: #BBF7D0; color: #166534;" role="alert">
                        <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" style="background-color: #FEF2F2; border-color: #FECACA; color: #991B1B;" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show shadow-sm mb-4" style="background-color: #EFF6FF; border-color: #BFDBFE; color: #1E40AF;" role="alert">
                        <i class="bi bi-info-circle-fill me-2 text-primary"></i> @TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
